---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found · GreenSquare"
  description="This page does not exist."
>
  <section class="section section-dark" style="min-height: 60vh; display: flex; align-items: center;">
    <div class="container">
      <p class="overline">404</p>
      <h1 class="h1 maxw-20ch">That page is not a decision GreenSquare has made yet.</h1>
      <p class="lead mt-6 maxw-45ch">
        The page you are looking for does not exist, or has moved.
      </p>
      <div class="action-row">
        <a class="btn btn-on-dark" href="/">Back to home</a>
        <a class="text-action" href="/benchmark/">See the benchmark</a>
      </div>
    </div>
  </section>
</BaseLayout>
