---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
---
<BaseLayoutV2
  title="Page not found · GreenSquare"
  description="This page does not exist."
>
  <section class="v-section v-green" style="min-height: 66vh; display: flex; align-items: center;">
    <div class="v-container">
      <p class="v-label v-label--rule v-eyebrow">404</p>
      <h1 class="v-h1" style="max-width: 20ch;">That page is not a decision GreenSquare has made yet.</h1>
      <p class="v-lead" style="margin-top: var(--v-5); max-width: 45ch;">
        The page you are looking for does not exist, or has moved.
      </p>
      <div style="display: flex; gap: var(--v-5); align-items: center; flex-wrap: wrap; margin-top: var(--v-8);">
        <a class="v-btn v-btn--on-green" href="/">Back to home</a>
        <a class="v-link" href="/benchmark/">See the benchmark <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </section>
</BaseLayoutV2>
