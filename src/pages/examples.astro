---
/**
 * Five agent-run demonstrations of the Frame Free guide, with their complete records.
 *
 * Each decision opens as a short summary in plain words. The agents' own words (the
 * summary, the full exchange and the fact sheet) sit behind disclosures marked
 * `data-guide-terms`, because they quote the guide's terms and are frozen records.
 *
 * The transcripts and fact sheets are rendered from the frozen files in
 * src/data/examples/, exactly as recorded. The hashes shown are computed from those
 * files at build time, so a later edit to a record shows up as a changed hash.
 */
import { createHash } from 'node:crypto';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import Signup from '../components/Signup.astro';
import { examples, examplesLabel, examplesProvenance } from '../data/examples';
import { situations } from '../data/offer';
import release from '../data/frame-free-release.json';
import { withBase } from '../lib/paths';

const transcripts = import.meta.glob('../data/examples/*.transcript.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const factSheets = import.meta.glob('../data/examples/*.facts.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const md = await createMarkdownProcessor();
/* Record headings are shown as bold labels: as real headings they would break the
   page's outline and repeat the same generated id five times. */
const html = async (source: string) => (await md.render(source.replace(/^#{1,6}\s+(.+)$/gm, '**$1**'))).code;
const sha = (text: string) => createHash('sha256').update(text).digest('hex');

const TURN = /^### Turn (\d+), (Assistant|User) \(([^)]*)\)\s*$/m;

const records = await Promise.all(
  examples.map(async (example) => {
    const transcript = transcripts[`../data/examples/${example.id}.transcript.md`];
    const facts = factSheets[`../data/examples/${example.id}.facts.md`];
    if (!transcript || !facts) throw new Error(`examples: record missing for ${example.id}`);
    const situation = situations.find((s) => s.id === example.id);
    if (!situation) throw new Error(`examples: no situation in offer.ts for ${example.id}`);

    const parts = transcript.split(TURN);
    const turns: { n: number; role: string; who: string; body: string }[] = [];
    for (let i = 1; i < parts.length; i += 4) {
      turns.push({ n: Number(parts[i]), role: parts[i + 1], who: parts[i + 2], body: parts[i + 3].trim() });
    }
    turns.forEach((turn, i) => { if (turn.n !== i + 1) throw new Error(`examples: ${example.id} turn ${i + 1} is numbered ${turn.n}`); });
    const last = turns.at(-1)!;
    if (last.role !== 'Assistant') throw new Error(`examples: ${example.id} does not end on the method agent`);
    const [handoff, remains] = last.body.split(/^(?=\*\*7\.)/m);
    if (!remains) throw new Error(`examples: ${example.id} handoff has no part 7`);
    const opening = turns[0].body.replace(/^Use Frame Free in this PDF\. Ask me one question at a time\.\s*/, '');

    return {
      ...example,
      situation,
      turnCount: turns.length,
      questions: turns.filter((t) => t.role === 'Assistant').length - 1,
      opening,
      handoffHtml: await html(handoff),
      remainsHtml: await html(remains),
      turnsHtml: await Promise.all(turns.map(async (t) => ({ ...t, html: await html(t.body) }))),
      factsHtml: await html(facts.replace(/^# .*\n/, '')),
      factsSha: sha(facts),
      transcriptSha: sha(transcript),
    };
  }),
);
---
<BaseLayoutV2
  title="Examples | GreenSquare AI"
  description="Five fictional business decisions run through the Frame Free guide by AI agents, each with a plain summary, the full exchange, the frozen inputs and what review found."
  current="examples"
>
  <section class="v-hero examples-hero">
    <div class="v-container">
      <h1>Five decisions, put through the guide</h1>
      <p class="v-lead">Each example starts with a fictional decision as its owner first put it, and ends where Frame Free stops: a clearer question, with nothing ranked or recommended. Every exchange, the inputs and what review found are published with each one.</p>
      <p class="examples-label">{examplesLabel}</p>
      <ul class="examples-jump">
        {records.map((r) => (
          <li><a href={`#${r.id}`} data-ff-event="example_selected" data-ff-location={r.id}>{r.situation.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v-section v-section--wash" id="how">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>How these were made</h2>
      </div>
      <div>
        <p>Two AI agents, kept apart. The guide agent followed the Frame Free guide. The owner agent played the person facing the decision, answering only from a fact sheet written and frozen before the run began. A third agent then reviewed each record against its fact sheet. No person took part.</p>
        <details class="examples-how">
          <summary>Full run details</summary>
          <dl class="d-meta">
            <div><dt>Date</dt><dd>{examplesProvenance.date}</dd></div>
            <div><dt>Guide</dt><dd>The Frame Free PDF, SHA-256 <code class="examples-hash">{release.sha256}</code>. {examplesProvenance.inputMode}</dd></div>
            <div><dt>Environment</dt><dd>{examplesProvenance.environment}</dd></div>
            <div><dt>Method</dt><dd>{examplesProvenance.method}</dd></div>
            <div><dt>Not tested</dt><dd>{examplesProvenance.notTested}</dd></div>
          </dl>
        </details>
      </div>
    </div>
  </section>

  {records.map((r, i) => (
    <section class:list={['v-section', 'example', { 'v-section--wash': i % 2 === 1 }]} id={r.id}>
      <div class="v-container">
        <header class="example__head">
          <p class="example__situation">{r.situation.title}</p>
          <h2>{r.title}</h2>
          <p class="example__issue">What it checks: {r.situation.issue}</p>
        </header>

        <div class="d-panel example__summary">
          <dl class="d-meta">
            <div><dt>As first put</dt><dd><blockquote class="example__opening"><p>{r.opening}</p></blockquote></dd></div>
            <div><dt>What changed</dt><dd>{r.changed}</dd></div>
            <div><dt>Where it ended</dt><dd><p class="example__meta">The guide agent’s own words, using the guide’s terms.</p><div class="example__md" data-guide-terms set:html={r.remainsHtml} /></dd></div>
            <div><dt>Found on review</dt><dd>{r.shortfall ?? 'The reviewer agent found no departure from the guide and no statement unsupported by the fact sheet.'}</dd></div>
            <div><dt>Length</dt><dd>{r.questions} questions over {r.turnCount} turns.</dd></div>
          </dl>
        </div>

        <details class="example__record" data-guide-terms>
          <summary>Read the AI’s full summary</summary>
          <div class="example__md" set:html={r.handoffHtml} />
        </details>

        <details class="example__record" data-guide-terms>
          <summary>Read the full exchange ({r.turnCount} turns)</summary>
          <ol class="example__turns">
            {r.turnsHtml.map((t) => (
              <li class={`example__turn example__turn--${t.role.toLowerCase()}`}>
                <p class="example__who">Turn {t.n}. {t.role === 'Assistant' ? 'Guide agent, following the guide' : 'Owner agent, answering from the fact sheet'}</p>
                <div class="example__md" set:html={t.html} />
              </li>
            ))}
          </ol>
        </details>

        <details class="example__record" data-guide-terms>
          <summary>Read the frozen fact sheet</summary>
          <p class="example__meta">Written before the run. The owner agent was told never to volunteer its last section.</p>
          <div class="example__md" set:html={r.factsHtml} />
        </details>

        <p class="example__meta example__hashes">Fact sheet SHA-256 <code class="examples-hash">{r.factsSha}</code>. Transcript SHA-256 <code class="examples-hash">{r.transcriptSha}</code>.</p>
      </div>
    </section>
  ))}

  <section class="v-section" id="limits">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What these examples do not show</h2>
      </div>
      <div>
        <p>They show how one AI, given the guide as text, behaved on five fictional decisions on one day. They are not customer results, not a benchmark and not independent validation. They do not show that Frame Free improves a decision, saves money or behaves the same in another AI or account. The <a href={withBase('/research/')}>research overview</a> keeps them apart from the earlier study.</p>
      </div>
    </div>
  </section>

  <Signup location="examples_footer" heading="Try it on your own decision" />
</BaseLayoutV2>

<style>
  .examples-hero h1 { max-width: 18ch; }
  .examples-label { margin: var(--v-4) 0 0; padding: var(--v-2) var(--v-3); border-left: 3px solid var(--v-green); background: var(--v-green-50); font-size: var(--vs-small); max-width: 72ch; }
  .examples-jump { list-style: none; margin: var(--v-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--v-2) var(--v-5); }
  .examples-jump a { font-weight: 600; }
  .examples-how { margin-top: var(--v-4); border-top: 1px solid var(--v-line); }
  .examples-hash { font-size: var(--vs-meta); overflow-wrap: anywhere; }
  .example__situation { margin: 0; font-size: var(--vs-small); font-weight: 600; color: var(--v-green); }
  .example__head h2 { margin-top: var(--v-1); max-width: 24ch; }
  .example__issue { margin: var(--v-2) 0 0; color: var(--v-ink-soft); max-width: 72ch; }
  .example__summary { margin-top: var(--v-6); }
  .example__summary .d-meta { padding: var(--v-2) var(--v-5); }
  .example__summary .d-meta > div { grid-template-columns: minmax(8rem, 10rem) 1fr; }
  .example__summary dt { color: var(--v-ink); font-weight: 600; }
  .example__opening { margin: 0; padding-left: var(--v-3); border-left: 3px solid var(--v-green); }
  .example__opening p { margin: 0; }
  .example__md { font-size: var(--vs-small); max-width: 72ch; overflow-wrap: anywhere; }
  .example__md :where(p, ul, ol) { margin: 0 0 var(--v-3); }
  .example__md :where(ul, ol) { padding-left: 1.25rem; }
  .example__md li { margin-bottom: var(--v-1); }
  .example__record { margin-top: var(--v-4); max-width: 80ch; }
  .example__record:first-of-type { border-top: 1px solid var(--v-line); }
  .example__turns { list-style: none; margin: var(--v-4) 0 0; padding: 0; }
  .example__turn { padding: var(--v-3) 0 var(--v-3) var(--v-4); border-left: 2px solid var(--v-line); margin-bottom: var(--v-3); }
  .example__turn--assistant { border-left-color: var(--v-green); }
  .example__who { margin: 0 0 var(--v-2); font-size: var(--vs-meta); font-weight: 600; color: var(--v-ink-soft); }
  .example__meta { font-size: var(--vs-meta); color: var(--v-ink-soft); margin: 0 0 var(--v-2); }
  .example__hashes { margin-top: var(--v-4); }
  @media (max-width: 560px) { .example__summary .d-meta > div { grid-template-columns: 1fr; } }
</style>
