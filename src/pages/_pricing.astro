---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
const STRIPE_LINK = 'https://buy.stripe.com/aFaaEWfGDc7W7XF2wv3AY00';
---
<BaseLayoutV2
  title="Pricing · GreenSquare"
  description="Compass is $49, anchored to $59. A Team tier is $490 for 10 seats. Priced below your expense-approval threshold on purpose."
  current="pricing"
>
  <!-- HERO -->
  <section class="v-section v-off hero">
    <div class="v-container">
      <div class="v-reveal">
        <p class="v-label v-label--rule v-eyebrow">Pricing</p>
        <h1 class="v-h1" style="max-width: 22ch;">Priced below your expense-approval threshold, on purpose.</h1>
        <p class="v-lead" style="margin-top: var(--v-6);">
          Compass is bought at the moment of a real call. It has to clear an impulse threshold for a
          professional, while staying high enough to signal it is not a prompt pack. A single, one-time price,
          not a subscription.
        </p>
      </div>
    </div>
  </section>

  <!-- TIERS -->
  <section class="v-section v-fill">
    <div class="v-container">
      <div class="v-tiers">
        <div class="v-tier v-reveal">
          <p class="v-label">Free</p>
          <h2 class="v-h3">Lens 4.0</h2>
          <p class="v-small">Frame the decision before you evaluate anything.</p>
          <p class="v-tier__price">Free</p>
          <a class="v-link" href={withBase('/decision-frame/')}>Get the free Lens worksheet <span class="arrow">&rarr;</span></a>
        </div>

        <div class="v-tier v-tier--key v-reveal d1">
          <p class="v-label">Keystone</p>
          <h2 class="v-h3">Compass</h2>
          <p class="v-small">Make one call you would stand behind, engine included.</p>
          <p><span class="v-tier__price">$49</span> <span class="v-tier__anchor">$59</span></p>
          <ul class="v-marked">
            <li>Works in Claude and GPT</li>
            <li>One file, no subscription</li>
            <li>12 months of model-version updates</li>
            <li>Refund on request within 14 days</li>
          </ul>
          <a class="v-btn v-btn--on-green" href={STRIPE_LINK} target="_blank" rel="noopener">Get Compass</a>
        </div>

        <div class="v-tier v-reveal d2">
          <p class="v-label">Next, demand-gated</p>
          <h2 class="v-h3">Team tier</h2>
          <p class="v-small">A standing decision capability for a function.</p>
          <p class="v-tier__price">A$490</p>
          <ul class="v-marked">
            <li>10 seats to the individual ladder</li>
            <li>One transaction, one relationship</li>
            <li>A quarterly briefing on how the benchmark has moved</li>
          </ul>
          <a class="v-link" href="mailto:hello@greensquare.ai?subject=Team%20tier">Write to hello@greensquare.ai <span class="arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY $49 -->
  <section class="v-section">
    <div class="v-container v-container--narrow">
      <p class="v-label v-eyebrow">Why $49, anchored at $59</p>
      <ul class="v-marked" style="margin-top: var(--v-8);">
        <li><strong>Single-decision value, not subscription value.</strong> The price has to clear an impulse threshold for a professional, at the moment of a real call, while staying high enough to signal it is not a prompt pack.</li>
        <li><strong>The anchor does the framing.</strong> $59 struck to $49 reads as a deliberate price, not a discount gimmick.</li>
        <li><strong>The maintenance moat protects the price, rather than arguing against it.</strong> A one-time file invites "it will be copied." The answer is a standing commitment, not a higher price: 12 months of model-version updates, and a benchmark re-run within 14 days of each major frontier model release.</li>
      </ul>
    </div>
  </section>

  <!-- REFUND STANCE — bold green keystone moment -->
  <section class="v-section v-green">
    <div class="v-container v-container--narrow">
      <p class="v-label v-label--rule v-eyebrow">Refund stance</p>
      <p class="v-lead">
        A no-quibble refund on Compass, on request, within 14 days. It is a single low-priced file; the
        cost of an occasional refund is far below the trust cost of a hard policy.
      </p>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .v-tier { justify-content: flex-start; }
  .v-tier .v-btn, .v-tier .v-link { margin-top: auto; align-self: flex-start; }
  /* keep description + em-dash markers legible on the green keystone tier */
  .v-tier--key .v-small { color: var(--v-cream-soft); }
  .v-tier--key .v-marked li::before { color: var(--v-lime); }
</style>
