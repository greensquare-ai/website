---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import Signup from '../components/Signup.astro';
import { withBase } from '../lib/paths';
import { offer } from '../data/offer';

const free = offer.free;
const faq = [
  ['Is this a worksheet or a questionnaire?', 'No. The file gives the model a process and a set of rules, not a list of questions. What it asks depends on what you have already told it, and it will not draft the brief until it has what it needs or has recorded what it cannot get.'],
  ['Does it make the decision for me?', 'No. It produces a recommendation with a stated confidence, the assumptions it rests on and the findings that would reverse it. You decide whether to accept the recommendation, and you own the outcome. The file will not run a decision that has no named owner.'],
  ['Which model should I use it with?', `${free.compatibility.tested} ${free.compatibility.boundary}`],
  ['Where does my information go?', 'Your decision, your facts and your answers go to the model provider you chose, under that provider’s terms and the data settings on your account. None of it reaches GreenSquare AI. Your email address is the only thing we hold.'],
  ['Can I use it on confidential work?', 'Only where your organisation permits you to place that material with the model provider you are using. Check the retention and training settings on your account first. Do not submit client material under NDA, personal information or privileged material unless your provider terms and your own obligations allow it.'],
  ['What does it cost, and what am I allowed to do with it?', `Nothing during the beta. ${free.rights}`],
  ['What is Frame Pro?', `${offer.pro.note}`],
];
---
<BaseLayoutV2
  title="Frame Free beta | GreenSquare AI"
  description="Email delivery of the Frame method file for use with ChatGPT, Claude or another capable model. What arrives, what to prepare, how long it takes and where your information goes."
  current="free"
>
  <section class="v-hero free-hero">
    <div class="v-container">
      <h1>{free.oneLine}</h1>
      <p class="v-lead">The beta is a single plain-text file. Loaded into a chat, it runs one consequential decision through six steps and produces a Decision Brief. You supply the decision and the facts; the method supplies the discipline.</p>
      <div class="v-actions">
        <a class="v-btn v-btn--green" href="#get-free">Get the Frame Free beta</a>
        <a class="v-btn" href={withBase('/product/#brief')}>See a Decision Brief</a>
      </div>
    </div>
  </section>

  <section class="v-section v-section--rule" id="what">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What you get, and what happens after you submit your address.</h2>
      </div>
      <dl class="d-meta free-meta">
        <div><dt>The file</dt><dd>{free.delivery.object}</dd></div>
        <div><dt>How you run it</dt><dd>{free.delivery.how}</dd></div>
        <div><dt>After you submit</dt><dd>{free.delivery.after}</dd></div>
        <div><dt>Setup</dt><dd>{free.delivery.setup}</dd></div>
        <div><dt>A session</dt><dd>{free.session}</dd></div>
        <div><dt>Status</dt><dd>{free.status}. The file is revised as the method improves; the version you hold is dated in its header.</dd></div>
      </dl>
    </div>
  </section>

  <section class="v-section v-section--rule" id="prepare">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What to have ready.</h2>
        <p>Three things. The method asks for the rest, and treats a stated unknown as evidence rather than as a gap to paper over.</p>
      </div>
      <ol class="d-list d-list--indexed">
        {free.inputs.map((text, i) => (
          <li><span class="d-list__index">{String(i + 1).padStart(2, '0')}</span><p class="free-input">{text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v-section v-section--rule" id="compatibility">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Model compatibility.</h2>
      </div>
      <dl class="d-meta">
        <div><dt>Tested on</dt><dd>{free.compatibility.tested}</dd></div>
        <div><dt>Boundary</dt><dd>{free.compatibility.boundary}</dd></div>
      </dl>
    </div>
  </section>

  <section class="v-section v-section--rule" id="data">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Where your information goes.</h2>
        <p>Frame runs inside the model you choose. GreenSquare AI is not in that session.</p>
      </div>
      <div class="d-panel">
        <dl class="d-meta free-data">
          {free.dataFlow.map((row) => (
            <div><dt>{row.what}</dt><dd>{row.where}</dd></div>
          ))}
        </dl>
        <div class="d-panel__foot"><p>The <a href={withBase('/legal/privacy/')}>privacy policy</a> covers the email address. The model provider's terms cover everything you type into the session.</p></div>
      </div>
    </div>
  </section>

  <Signup />

  <section class="v-section v-section--rule" id="faq">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What Frame Free is, and is not.</h2>
      </div>
      <div class="free-faq">
        {faq.map(([q, a], i) => (
          <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .free-hero h1 { max-width: 22ch; font-size: var(--vs-h1); }
  .free-hero .v-lead { max-width: 58ch; }
  .free-meta > div { grid-template-columns: minmax(8rem, 10rem) 1fr; }
  .free-input { margin: 0; }
  .free-data { padding: var(--v-2) var(--v-5); }
  .free-data > div { grid-template-columns: minmax(9rem, 12rem) 1fr; }
  .free-data dt { color: var(--v-ink); font-weight: 600; }
  .free-faq details:first-of-type { border-top: 1px solid var(--v-line); }
  .free-faq p { color: var(--v-ink-soft); font-size: var(--vs-small); margin-bottom: var(--v-2); }
  @media (max-width: 480px) { .free-meta > div, .free-data > div { grid-template-columns: 1fr; } }
</style>
