---
/**
 * Frame Free: the single product page. Since 10 November 2026 it also carries what
 * /product/ explained (the plans, the six steps and Frame Pro), and /product/ redirects
 * here. The Decision Brief demonstration moved to /research/.
 */
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import Signup from '../components/Signup.astro';
import CaptureForm from '../components/CaptureForm.astro';
import FreeHandoff from '../components/FreeHandoff.astro';
import PlanComparison from '../components/PlanComparison.astro';
import Faq from '../components/Faq.astro';
import { withBase } from '../lib/paths';
import { freeQuestions, offer } from '../data/offer';
import { plainQuestionNames } from '../data/worked-example';
import release from '../data/frame-free-release.json';

const free = offer.free;
const included = [
  ['The file', `${free.delivery.object} ${free.delivery.how}`],
  ['What you need', 'A ChatGPT, Claude or Gemini account that lets you attach a file to a chat, and one decision you are facing.'],
  ['Time', `${free.delivery.setup} ${free.session}`],
  ['Cost', `Free. ${free.status}.`],
  ['Works with', free.compatibility.boundary],
  ['Your rights', free.rights],
];
---
<BaseLayoutV2
  title="Frame Free | GreenSquare AI"
  description="Frame Free is a free six-page PDF for ChatGPT, Claude or Gemini. The AI asks you six questions about one decision and gives you a seven-part summary: the real question, what you are assuming and what to check first."
  current="free"
>
  <section class="v-hero free-hero" id="get-free">
    <div class="v-container free-hero__grid">
      <div>
        <h1>A free guide that makes AI ask before it answers</h1>
        <p class="v-lead">Frame Free is a six-page PDF. Attach it to ChatGPT, Claude or Gemini and describe one decision. The AI asks you six questions, one at a time, then gives you a seven-part summary: the real question, what you are assuming and the one thing to check first.</p>
        <p class="free-hero__boundary">{free.boundary} The decision stays yours.</p>
      </div>
      <div class="d-panel d-panel--ink free-hero__offer">
        <p class="free-hero__offer-line">{free.offerLine}</p>
        <CaptureForm location="free_hero" eager />
      </div>
    </div>
  </section>

  <section class="v-section v-section--wash" id="sample">
    <div class="v-container">
      <div class="free-head">
        <h2>What you get back</h2>
        <p>This is the summary from the guide’s own worked example. Most decision tools start by weighing the options. Frame Free starts a step earlier, with the question, so the weighing is aimed at the right decision.</p>
        <a class="v-link" href={withBase('/examples/')}>See five more examples</a>
      </div>
      <FreeHandoff id="free-handoff" />
    </div>
  </section>

  <section class="v-section" id="questions">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>The six questions</h2>
        <p>The AI asks them in this order, one at a time, and adapts each to what you have already told it. Below each is the question as the guide puts it.</p>
      </div>
      <ol class="d-list d-list--indexed">
        {freeQuestions.map(([, q], i) => (
          <li><span class="d-list__index">{String(i + 1).padStart(2, '0')}</span><div><h3>{plainQuestionNames[i]}</h3><p>{q}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v-section v-section--wash" id="included">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What is included</h2>
        <p>One file. No app, no account with us, and your decision is never sent to GreenSquare AI.</p>
      </div>
      <div class="d-panel">
        <dl class="d-meta free-meta">
          {included.map(([label, text]) => <div><dt>{label}</dt><dd>{text}</dd></div>)}
          <div><dt>File check</dt><dd class="free-release">This release is {release.pages} pages, {Math.round(release.bytes / 1024)} KB. The PDF carries no printed version, so this is its SHA-256 fingerprint: <code class="free-hash">{release.sha256}</code></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="v-section" id="setup">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>How to start</h2>
        <p>Under five minutes to set up, then about ten minutes for one decision.</p>
        <a class="v-link" href={withBase('/start/')}>Read the start guide, with the starter text and fixes</a>
      </div>
      <ol class="d-list d-list--indexed">
        {free.setup.map((step, i) => (
          <li><span class="d-list__index">{String(i + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v-section v-section--wash" id="data">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Your data</h2>
        <p>Frame Free runs inside the AI account you choose. GreenSquare AI is not part of that chat.</p>
      </div>
      <div class="d-panel">
        <dl class="d-meta free-data">
          {free.dataFlow.map((row) => (
            <div><dt>{row.what}</dt><dd>{row.where}</dd></div>
          ))}
        </dl>
        <div class="d-panel__foot"><p>The <a href={withBase('/legal/privacy/')}>privacy policy</a> covers your email address and the <a href={withBase('/legal/terms/')}>terms of use</a> cover the licence. Your AI provider’s terms cover everything you type into the chat.</p></div>
      </div>
    </div>
  </section>

  <section class="v-section" id="pro">
    <div class="v-container">
      <div class="free-head">
        <h2>Frame Free now, Frame Pro later</h2>
        <p>The full method has six steps. Frame Free covers the first three, which get the question right. Frame Pro, the paid plan in development, is planned to cover all six.</p>
      </div>
      <PlanComparison />
    </div>
  </section>

  <section class="v-section v-section--wash" id="faq">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Questions before you start</h2>
      </div>
      <Faq />
    </div>
  </section>

  <Signup id="get-free-final" location="free_footer" />
</BaseLayoutV2>

<style>
  .free-hero { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .free-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .free-hero h1 { max-width: 18ch; font-size: var(--vs-h1); }
  .free-hero .v-lead { max-width: 52ch; color: var(--v-ink); }
  .free-hero__boundary { margin: var(--v-5) 0 0; max-width: 56ch; padding-top: var(--v-4); border-top: 1px solid var(--v-line); font-size: var(--vs-small); color: var(--v-ink-soft); }
  .free-hero__offer { padding: clamp(1.25rem, 3vw, 2rem); border-top: 4px solid var(--v-green); }
  .free-hero__offer-line { margin: 0 0 var(--v-4); font-weight: 600; color: var(--v-ink); }
  @media (max-width: 860px) { .free-hero__grid { grid-template-columns: 1fr; gap: var(--v-6); } }
  .free-head { max-width: 64ch; margin-bottom: var(--v-6); }
  .free-head p { color: var(--v-ink-soft); margin-top: var(--v-4); }
  .free-meta, .free-data { padding: var(--v-2) var(--v-5); }
  .free-meta > div, .free-data > div { grid-template-columns: minmax(8rem, 10rem) 1fr; }
  .free-meta dt, .free-data dt { color: var(--v-ink); font-weight: 600; }
  .free-release { color: var(--v-ink-soft); }
  .free-hash { font-size: var(--vs-meta); overflow-wrap: anywhere; word-break: break-all; }
  @media (max-width: 480px) { .free-meta > div, .free-data > div { grid-template-columns: 1fr; } }
</style>
