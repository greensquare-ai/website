---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';

const stages = [
  { n: '01', name: 'Ask', body: 'The model asks three to six focused questions before offering advice. The number and depth of the questions scale with the stakes.' },
  { n: '02', name: 'Frame', body: 'It checks whether the stated choice is the real decision and identifies any option that has been treated as fixed too early.' },
  { n: '03', name: 'Confirm', body: 'It plays the situation back in a few lines and asks you to resolve contradictions, missing evidence and untested assumptions.' },
  { n: '04', name: 'Compare', body: 'It generates genuine alternatives, including keeping the current position, and compares them against the criteria that matter.' },
  { n: '05', name: 'Recommend', body: 'It produces the five part Decision Brief and checks the reasoning before handing it to you.' },
];
---
<BaseLayoutV2
  title="The Decision | GreenSquare"
  description="The Decision is a plain markdown file that guides Claude, ChatGPT or Gemini through one consequential business decision and produces a clear, evidence marked brief."
  current="product"
>
  <section class="v-section v-off hero">
    <div class="v-container">
      <div class="v-split is-top">
        <div class="v-reveal">
          <h1 class="v-display">The Decision.</h1>
          <p class="v-lead" style="margin-top: var(--v-6);">
            A plain markdown file that guides Claude, ChatGPT or Gemini through one consequential business
            decision. It asks first, checks the framing, compares real options, and produces a recommendation
            with the assumptions and evidence behind it.
          </p>
          <p class="v-small product-note">
            Open a new chat, paste or upload the file, and describe the decision in your own words. The process
            runs inside the AI account you already use.
          </p>
          <div class="hero-actions">
            <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Decision Frame</a>
            <a class="v-btn v-btn--grey" href={withBase('/benchmark/')}>Read the benchmark</a>
          </div>
        </div>
        <div class="v-reveal d1">
          <div class="v-readout">
            <div class="v-readout__bar"><span class="v-readout__dot"></span> THE DECISION / CHAT FLOW</div>
            <div class="v-readout__body">
              <ul class="v-spec__list">
                {stages.map((stage) => <li><span class="n">/{stage.n}</span> {stage.name}</li>)}
              </ul>
            </div>
            <div class="v-readout__foot">ONE FILE / ONE DECISION / MARKDOWN OUTPUT</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 24ch;">Use it when the answer has consequences.</h2>
      <div class="decision-grid" style="margin-top: var(--v-8);">
        <ul class="v-leadlist v-reveal">
          <li><strong>Investment and bids.</strong> Decide whether to approve, reshape or stop a material commitment.</li>
          <li><strong>Build, buy or partner.</strong> Compare the real options and test the constraints behind them.</li>
        </ul>
        <ul class="v-leadlist v-reveal d1">
          <li><strong>Programs and projects.</strong> Decide whether to continue, restructure, pause or exit.</li>
          <li><strong>Operating choices.</strong> Prepare a clear call on hiring, pricing, vendors, markets or capacity.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <h2 class="v-h2">What happens in the chat.</h2>
      <div class="v-caplist">
        {stages.map((stage, index) => (
          <div class={`v-caprow v-reveal${index > 0 ? ` d${Math.min(index, 3)}` : ''}`}>
            <span class="v-index">/{stage.n}</span>
            <h3>{stage.name}</h3>
            <p class="v-small v-cap-body">{stage.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">The output is ready to review.</h2>
        <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
          The Decision Brief is clean markdown that you can edit, challenge or move into your own document. It
          gives a senior reader the call, the reasoning, the next actions, and the evidence that still needs work.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> DECISION_BRIEF.md</div>
          <div class="v-readout__body">
            <ul class="v-spec__list">
              <li><span class="n">/01</span> The decision and why it matters now</li>
              <li><span class="n">/02</span> The options compared</li>
              <li><span class="n">/03</span> The recommendation</li>
              <li><span class="n">/04</span> The next actions</li>
              <li><span class="n">/05</span> What would change the recommendation</li>
            </ul>
            <div class="spec-tags v-reveal">
              <span class="v-tag">given</span><span class="v-tag">derived</span><span class="v-tag">inferred</span><span class="v-tag">unknown</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green">
    <div class="v-container v-split">
      <div class="v-reveal">
        <h2 class="v-h2">Your decision stays in your account.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          The Decision contains plain text. It has no links, embedded code, macros or external connection.
          GreenSquare cannot see your decision, your answers or the brief produced in your chat.
        </p>
      </div>
      <div class="v-reveal d1">
        <ul class="v-leadlist">
          <li><strong>Nothing to install.</strong> Paste or upload one markdown file.</li>
          <li><strong>Your existing account.</strong> Use the AI service and workplace policy you already have.</li>
          <li><strong>Editable output.</strong> Keep the brief in markdown or move it into your normal workflow.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">What the public test shows.</h2>
      <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        The Decision was tested against two baselines under a pre-registered protocol, on two frontier models and
        three business cases. Every figure lives on the benchmark page and nowhere else, so there is one record to
        check rather than several to reconcile. That page also carries every departure from the pre-registration
        and everything the test cannot tell you.
      </p>
      <a class="v-link" href={withBase('/benchmark/')} style="display:inline-block; margin-top: var(--v-5);">See the results and limitations</a>
    </div>
  </section>

  <section class="v-section v-green" id="get-started">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">Start with the free Decision Frame.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          The Decision is being prepared for launch. The free Frame gives you the first six questions now, on
          one page, for a real decision you are facing.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <EmailCaptureForm client:visible buttonLabel="Email me the Decision Frame" />
        </div>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">Common questions.</h2>
      <div style="margin-top: var(--v-8);">
        <details open>
          <summary>What exactly is The Decision?</summary>
          <p class="v-small">A structured markdown instruction file for one decision. It guides the conversation and produces the Decision Brief inside your AI chat.</p>
        </details>
        <details>
          <summary>Do I need to install anything?</summary>
          <p class="v-small">No installation is required. Open a new chat, paste or upload the file, then describe your decision.</p>
        </details>
        <details>
          <summary>Which AI services can I use?</summary>
          <p class="v-small">The file is designed for Claude, ChatGPT and Gemini. The current public benchmark covers Claude and ChatGPT. The Gemini grid is pending.</p>
        </details>
        <details>
          <summary>Will it build a financial model?</summary>
          <p class="v-small">It can work with numbers you provide and show the calculation. Dedicated financial modelling sits outside this product.</p>
        </details>
        <details>
          <summary>When can I buy it?</summary>
          <p class="v-small">The launch edition is in preparation. Get the free Decision Frame to use the first part of the method now.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .product-note { margin-top: var(--v-5); max-width: 58ch; }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
  .decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--v-8); }
  .spec-tags { display: flex; gap: var(--v-2); flex-wrap: wrap; margin-top: var(--v-2); }
  @media (max-width: 760px) { .decision-grid { grid-template-columns: 1fr; gap: var(--v-4); } }
</style>
