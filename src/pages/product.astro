---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';

const stages = [
  { n: '01', name: 'Ask', body: 'The model asks three to six focused questions before offering advice. The depth of the interrogation scales with the stakes.' },
  { n: '02', name: 'Frame', body: 'It tests whether the stated question is the real decision and identifies choices that have been treated as fixed too early.' },
  { n: '03', name: 'Confirm', body: 'It plays the situation back in a few lines, then asks you to resolve contradictions, missing evidence and untested assumptions.' },
  { n: '04', name: 'Compare', body: 'It develops credible alternatives, including keeping the current position, and compares them against explicit criteria.' },
  { n: '05', name: 'Recommend', body: 'It produces a five-part Decision Brief and checks whether the call follows from the evidence before handing it to you.' },
];
---
<BaseLayoutV2
  title="The Decision | GreenSquare AI"
  description="The Decision is a plain markdown instruction file that gives Claude, ChatGPT or Gemini a disciplined strategy process for one consequential business decision."
  current="product"
>
  <section class="v-section v-off hero">
    <div class="v-container">
      <div class="v-split is-top">
        <div class="v-reveal">
          <h1 class="v-display">Give your AI a strategy process, not another prompt.</h1>
          <p class="v-lead" style="margin-top: var(--v-6);">
            The Decision is a plain markdown instruction file that guides Claude, ChatGPT or Gemini through one
            consequential business decision. It asks before advising, challenges the framing, compares credible
            options and produces an evidence-marked recommendation ready for scrutiny.
          </p>
          <p class="v-small product-note">
            Open a new chat, paste or upload The Decision, then describe the choice in your own words. The process
            runs inside the AI account and workplace policy you already use.
          </p>
          <div class="hero-actions">
            <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Decision Frame</a>
            <a class="v-btn v-btn--grey" href={withBase('/benchmark/')}>Read the benchmark</a>
          </div>
        </div>
        <div class="v-reveal d1">
          <div class="v-readout">
            <div class="v-readout__bar"><span class="v-readout__dot"></span> The Decision workflow</div>
            <div class="v-readout__body">
              <ul class="v-spec__list">
                {stages.map((stage) => <li><span class="n">{Number(stage.n)}</span> {stage.name}</li>)}
              </ul>
            </div>
            <div class="v-readout__foot">One instruction file · one consequential decision · one defensible brief</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 24ch;">Use it when a plausible answer is not enough.</h2>
      <div class="decision-grid" style="margin-top: var(--v-8);">
        <ul class="v-leadlist v-reveal">
          <li><strong>Investment and bids.</strong> Decide whether to approve, reshape or stop a material commitment.</li>
          <li><strong>Build, buy or partner.</strong> Compare credible options and test the constraints behind each one.</li>
        </ul>
        <ul class="v-leadlist v-reveal d1">
          <li><strong>Programs and projects.</strong> Decide whether to continue, restructure, pause or exit.</li>
          <li><strong>Operating choices.</strong> Prepare a defensible call on hiring, pricing, vendors, markets or capacity.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <h2 class="v-h2">What happens in the chat.</h2>
      <div class="v-caplist">
        {stages.map((stage, index) => (
          <div class={`v-caprow v-reveal${index > 0 ? ` d${Math.min(index, 3)}` : ''}`}>
            <span class="v-index">Step {Number(stage.n)}</span>
            <h3>{stage.name}</h3>
            <p class="v-small v-cap-body">{stage.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">The output is built for executive scrutiny.</h2>
        <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
          The Decision Brief is clean markdown you can edit, challenge or move into your own document. A senior
          reader can see the call, the reasoning, the material trade-offs, the next action and the evidence that
          still needs work.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> Decision Brief structure</div>
          <div class="v-readout__body">
            <ul class="v-spec__list">
              <li><span class="n">1</span> The Decision and why it matters now</li>
              <li><span class="n">2</span> The Options compared</li>
              <li><span class="n">3</span> The recommendation</li>
              <li><span class="n">4</span> The next actions</li>
              <li><span class="n">5</span> The Assumptions and reversal conditions</li>
            </ul>
            <div class="spec-tags v-reveal">
              <span class="v-tag">GIVEN</span><span class="v-tag">DERIVED</span><span class="v-tag">INFERRED</span><span class="v-tag">UNKNOWN</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green">
    <div class="v-container v-split">
      <div class="v-reveal">
        <h2 class="v-h2">Your decision stays inside your AI account.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          The Decision contains plain text. It has no links, embedded code, macros or external connection.
          GreenSquare cannot see your question, your answers or the Decision Brief produced in your chat.
        </p>
      </div>
      <div class="v-reveal d1">
        <ul class="v-leadlist">
          <li><strong>Nothing to install.</strong> Paste or upload one plain markdown instruction file.</li>
          <li><strong>Your existing account.</strong> Use the AI service and workplace policy you already have.</li>
          <li><strong>Editable output.</strong> Keep the brief in markdown or move it into your normal workflow.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">What the public benchmark supports.</h2>
      <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        In 45 pre-registered runs across two frontier models and three business cases, The Decision consistently
        imposed the process it was designed to impose: ask first, compare real options and tag the evidence. The
        benchmark does not yet prove that it improves an experienced operator's judgement. Every result,
        departure and limitation is kept on one page so there is one evidence record to scrutinise.
      </p>
      <a class="v-link" href={withBase('/benchmark/')} style="display:inline-block; margin-top: var(--v-5);">Review the results and limitations</a>
    </div>
  </section>

  <section class="v-section v-green" id="get-started">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">Use the first six questions now.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          The Decision is being prepared for launch. The free Decision Frame gives you the first six questions
          now, on one page, for a live decision.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <EmailCaptureForm client:visible buttonLabel="Email me the Decision Frame" />
        </div>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">Common questions.</h2>
      <div style="margin-top: var(--v-8);">
        <details open>
          <summary>What exactly is The Decision?</summary>
          <p class="v-small">A plain markdown instruction file for one consequential business decision. It guides the conversation and produces the Decision Brief inside your AI chat.</p>
        </details>
        <details>
          <summary>Do I need to install anything?</summary>
          <p class="v-small">No installation is required. Open a new chat, paste or upload The Decision, then describe the choice in your own words.</p>
        </details>
        <details>
          <summary>Which AI services can I use?</summary>
          <p class="v-small">The Decision is designed for Claude, ChatGPT and Gemini. The current public benchmark covers Claude and ChatGPT; Gemini has not yet been run.</p>
        </details>
        <details>
          <summary>Will it build a financial model?</summary>
          <p class="v-small">It can work with numbers you provide and show the calculation. Dedicated financial modelling sits outside this product.</p>
        </details>
        <details>
          <summary>When can I buy it?</summary>
          <p class="v-small">The launch edition is in preparation. Use the free Decision Frame to apply the first part of the method now.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .product-note { margin-top: var(--v-5); max-width: 58ch; }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
  .decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--v-8); }
  .spec-tags { display: flex; gap: var(--v-2); flex-wrap: wrap; margin-top: var(--v-2); }
  @media (max-width: 760px) { .decision-grid { grid-template-columns: 1fr; gap: var(--v-4); } }
</style>
