---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';

const stages = [
  { n: '01', name: 'Interrogate', body: 'Short, specific questions come before any advice, scaled to the stakes: a small reversible call gets three sharp questions, a one-way-door call gets up to six.' },
  { n: '02', name: 'Challenge the framing', body: 'The stated decision is tested once against the real one, so a solution chosen before the thinking was done gets caught rather than built around.' },
  { n: '03', name: 'Play it back', body: 'Your situation is reflected back in a few lines, and any tension in what you have said (a fixed deadline against an unapproved budget, a stated risk appetite against the option you favour) is named for you to resolve.' },
  { n: '04', name: 'Reason', body: 'Options are generated, including the ones you did not bring and doing nothing. Constraints you have treated as fixed are tested against what you have actually verified.' },
  { n: '05', name: 'Produce', body: 'The five-part Decision Brief, written in clean markdown, with a self-check before it is handed to you.' },
];
---
<BaseLayoutV2
  title="The Decision | GreenSquare"
  description="The Decision is a single file that turns Claude or GPT into a decision advisor. It interrogates before it answers, then produces a five-part, evidence-tagged brief."
  current="product"
>
  <!-- HERO — light, balanced -->
  <section class="v-section v-off hero">
    <div class="v-container">
      <div class="v-split is-top">
        <div class="v-reveal">
          <h1 class="v-display">The Decision.</h1>
          <p class="v-lead" style="margin-top: var(--v-6);">
            One file that interrogates before it answers: it questions you, tests the framing once, plays your
            situation back to you and catches contradictions, then produces genuine options and an evidence-tagged
            recommendation with a self-check, all in markdown. Twelve months of model-version updates included.
          </p>
          <div class="hero-actions">
            <a class="v-btn v-btn--green" href="/decision-frame/">Get the free Decision Frame</a>
            <a class="v-btn v-btn--grey" href="/benchmark/">See the benchmark</a>
          </div>
        </div>
        <div class="v-reveal d1">
          <div class="v-readout">
            <div class="v-readout__bar"><span class="v-readout__dot"></span> THE DECISION / 01&ndash;05</div>
            <div class="v-readout__body">
              <ul class="v-spec__list">
                {stages.map((s) => <li><span class="n">/{s.n}</span> {s.name}</li>)}
              </ul>
            </div>
            <div class="v-readout__foot">MARKDOWN OUTPUT <span class="v-cursor" aria-hidden="true"></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IT IS -->
  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 30ch;">A disciplined thinking partner for one decision, not another chat window.</h2>
      <p class="v-measure" style="margin-top: var(--v-6); color: var(--v-ink-soft);">
        The Decision turns a generic AI account into a decision advisor for a single real call. Open a new chat,
        paste or upload the file, and describe the decision you are facing in your own words. It leads from
        there: it asks before it advises, tests whether the decision you named is the real one, and only then
        builds the brief. It behaves the same way on Claude and GPT, because the discipline is written into the
        file, not left to the model's mood on the day.
      </p>
    </div>
  </section>

  <!-- THE METHOD — five stages, indexed capability rows -->
  <section class="v-section v-fill">
    <div class="v-container">
      <h2 class="v-h2">Five stages, in order, every time.</h2>
      <p class="v-measure" style="margin-top: var(--v-4); color: var(--v-ink-soft);">It does not skip to the brief. Each stage exists because the one before it changes what the brief should say.</p>
      <div class="v-caplist">
        {stages.map((s, i) => (
          <div class={`v-caprow v-reveal${i > 0 ? ` d${Math.min(i, 3)}` : ''}`}>
            <span class="v-index">/{s.n}</span>
            <h3>{s.name}</h3>
            <p class="v-small v-cap-body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE OUTPUT — five parts, indexed capability rows -->
  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2">Five parts, every time.</h2>
      <div class="v-caplist">
        <div class="v-caprow v-reveal">
          <span class="v-index">/01</span>
          <h3>The decision, and why now</h3>
          <p class="v-small v-cap-body">The real decision, and what makes it live today.</p>
        </div>
        <div class="v-caprow v-reveal d1">
          <span class="v-index">/02</span>
          <h3>The options, compared</h3>
          <p class="v-small v-cap-body">A compact table, scored against the criteria that matter, including the options you did not bring.</p>
        </div>
        <div class="v-caprow v-reveal d2">
          <span class="v-index">/03</span>
          <h3>The recommendation</h3>
          <p class="v-small v-cap-body">The call, and the one or two assumptions it rests on, each tagged given, inferred or unknown.</p>
        </div>
        <div class="v-caprow v-reveal d3">
          <span class="v-index">/04</span>
          <h3>Next steps</h3>
          <p class="v-small v-cap-body">Three to five concrete actions, sequenced if the clock matters.</p>
        </div>
        <div class="v-caprow v-reveal d3">
          <span class="v-index">/05</span>
          <h3>What would change this call</h3>
          <p class="v-small v-cap-body">The specific risks or unknowns that would flip the recommendation, plus a confidence line.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE FIREWALL -->
  <section class="v-section v-fill">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">What it does. What it does not.</h2>
        <p class="v-measure" style="margin-top: var(--v-4); color: var(--v-ink-soft);">
          The Decision does arithmetic on numbers you give it, tagged as derived, so a claim like "roughly 8% of
          revenue" is shown as worked, not asserted. It does not build a financial model, a valuation, a template,
          a board pack or a risk register. That deeper modelling work is a separate product, The Case. The
          Decision's job is the call and the brief, not the spreadsheet behind it.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <ul class="v-leadlist">
            <li><strong>Does the arithmetic.</strong> Works the numbers you give it, each tagged given or derived, shown as worked rather than asserted.</li>
            <li><strong>Does the brief.</strong> A five-part, evidence-tagged decision brief in clean markdown.</li>
            <li><strong>Does not model.</strong> No financial model or valuation; that deeper work is a separate product, the Case.</li>
            <li><strong>Does not decorate.</strong> No deck, no template, no risk register.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTERPRISE-PASTE HYGIENE — green big-block, the proof moment -->
  <section class="v-section v-green">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 24ch;">Plain markdown. Runs in your own account. Nothing collected.</h2>
      <p class="v-lead" style="margin-top: var(--v-5); max-width: 60ch;">
        The Decision is a plain markdown file: no links, no embedded code, no macros, nothing that phones home.
        It runs entirely inside the AI account you already use. GreenSquare does not see your decision, your
        answers, or your brief. You can paste it into a work account under the same policies you already apply
        to any text you type into that account.
      </p>
    </div>
  </section>

  <!-- FREE FRAME CTA — green big-block -->
  <section class="v-section v-green" id="get-started">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">Start with the free Decision Frame.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          Before anything paid, run the free one-page Frame on a real call: the question underneath the
          question, the false binary, the load-bearing assumption, and what you actually know. Delivered by
          email, yours to keep.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <EmailCaptureForm client:visible buttonLabel="Send me the free Decision Frame" />
        </div>
      </div>
    </div>
  </section>

  <!-- QUESTIONS — native disclosure -->
  <section class="v-section v-fill">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">The short answers.</h2>
      <div style="margin-top: var(--v-8);">
        <details open>
          <summary>What exactly do I get?</summary>
          <p class="v-small">One markdown file for Claude or GPT. Open a new chat, paste or upload it, describe your decision, answer its questions, and it produces a five-part Decision Brief in the conversation.</p>
        </details>
        <details>
          <summary>Do I need to install anything?</summary>
          <p class="v-small">No. It is a plain text file. No app, no plugin, no account with GreenSquare.</p>
        </details>
        <details>
          <summary>Is it a subscription?</summary>
          <p class="v-small">No. It is one file, yours to keep, not a subscription, with twelve months of model-version updates included.</p>
        </details>
        <details>
          <summary>Will it build me a financial model?</summary>
          <p class="v-small">No. It does arithmetic on numbers you give it, tagged as derived. Financial modelling is a separate product, The Case.</p>
        </details>
        <details>
          <summary>Is it just a prompt someone could copy?</summary>
          <p class="v-small">It is a file, and that is the point: nothing to install, your data never leaves your own account. What is harder to copy is the standing commitment behind it: a published rubric, readable transcripts, and a benchmark re-run within 14 days of every major model release. See the <a href="/benchmark/">benchmark</a> and <a href="/methodology/">methodology</a>.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .hero-actions { display: flex; gap: var(--v-6); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
</style>
