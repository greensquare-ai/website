---
/**
 * Who is behind Frame. The people are described only through broad capability areas
 * (docs/decisions.md, 22 September 2026): no names, employers, institutions,
 * qualifications, client details or testimonials.
 */
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import { withBase } from '../lib/paths';
import { operator, practice } from '../data/operator';
import { dates, deviations, grid } from '../lib/benchmark';

const g = grid();
const d = dates();
const nDev = deviations().length;
const check = [
  { what: 'The guide', text: 'All six pages, including the exact instructions the AI follows. You can read what it asks the AI to do before you use it.', href: withBase('/free/'), link: 'Frame Free' },
  { what: 'The examples', text: 'Five decisions run through the guide on fictional inputs, with every exchange and what review found, including where the AI fell short.', href: withBase('/examples/'), link: 'Examples' },
  { what: 'The research', text: `A ${g.runs_total}-run study of an earlier version of the method, with all ${nDev} recorded problems and its limits. It does not test Frame Free.`, href: withBase('/research/'), link: 'Research' },
  { what: 'The file', text: 'The PDF has no printed version number, so the site publishes its fingerprint. You can check the file you hold is the one described.', href: withBase('/free/#included'), link: 'File check' },
];
const commitments = [
  ['Works with the AI you choose', 'Frame is written as instructions any capable AI can follow, so it is not tied to one provider.'],
  ['Claims follow the evidence', 'We say only what has been shown, and correct the record in public, with dates, when the evidence changes.'],
  ['You own the decision', 'Frame Free questions a decision. It does not rank options or tell you what to do.'],
  ['We publish what did not work', 'The study result that went against the method is published in full, with every recorded problem.'],
];
---
<BaseLayoutV2
  title="About | GreenSquare AI"
  description="GreenSquare AI is a small Australian business that writes and maintains Frame. Why we built it, who is behind it, what you can check for yourself and how to reach us."
  current="about"
>
  <section class="v-hero about-hero">
    <div class="v-container">
      <h1>{practice.heading}</h1>
      <p class="v-lead">{practice.summary}</p>
    </div>
  </section>

  <section class="v-section" id="purpose">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Why we built Frame</h2>
      </div>
      <div class="about-purpose">
        <p>AI gives fluent answers fast. A fluent answer is not the same as a decision that has been questioned: a guessed number, a missed option or an untested assumption can slip straight through.</p>
        <p>Frame writes that questioning down as instructions the AI follows. Frame Free, available now, covers the first part. It works on the question, then stops, so you make the decision with a clearer view of what you know and what you are assuming.</p>
      </div>
    </div>
  </section>

  <section class="v-section v-section--wash" id="people">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Who is behind it</h2>
      </div>
      <div class="about-purpose">
        <p>Frame is written by people whose work has spanned strategy, capital allocation, operating-model design, transactions, restructuring, transformation, financial analysis and execution. The method draws on how those decisions are questioned in practice.</p>
        <p>We are a small team, and every page of the guide and this site is ours to answer for.</p>
      </div>
    </div>
  </section>

  <section class="v-section" id="inspect">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What you can check for yourself</h2>
        <p>All of this is open before you give us an email address.</p>
      </div>
      <dl class="d-meta about-list">
        {check.map((row) => <div><dt>{row.what}</dt><dd>{row.text} <a href={row.href}>{row.link}</a></dd></div>)}
      </dl>
    </div>
  </section>

  <section class="v-section v-section--wash" id="commitments">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What we commit to</h2>
      </div>
      <dl class="d-meta about-list">
        {commitments.map(([title, copy]) => <div><dt>{title}</dt><dd>{copy}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="v-section" id="operator">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Contact and business details</h2>
        <p>Questions about Frame, the research or this site go to <a href={`mailto:${operator.email}`}>{operator.email}</a>. Research figures on this site were last checked on {d.currentAsAt}.</p>
      </div>
      <div class="d-panel about-operator">
        <dl class="d-meta">
          <div><dt>Business name</dt><dd>{operator.businessName}</dd></div>
          <div><dt>Location</dt><dd>{operator.location}</dd></div>
          <div><dt>Governing law</dt><dd>{operator.jurisdiction}</dd></div>
          <div><dt>Contact</dt><dd><a href={`mailto:${operator.email}`}>{operator.email}</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="v-section v-section--wash about-close">
    <div class="v-container">
      <h2>Try it on a real decision</h2>
      <div class="v-actions">
        <a class="v-btn v-btn--green" href={withBase('/free/#get-free')}>Get Frame Free PDF</a>
        <a class="v-btn" href={withBase('/examples/')}>See the examples</a>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .about-hero h1 { max-width: 18ch; }
  .about-hero .v-lead { max-width: 60ch; }
  .about-purpose p { max-width: 62ch; }
  .about-purpose p + p { margin-top: var(--v-4); }
  .about-list dt { color: var(--v-ink); font-weight: 600; }
  .about-list > div { grid-template-columns: minmax(9rem, 13rem) 1fr; }
  .about-list dd a { white-space: nowrap; }
  .about-operator { padding: var(--v-2) var(--v-5); }
  .about-close h2 { max-width: 20ch; }
  @media (max-width: 480px) { .about-list > div { grid-template-columns: 1fr; } }
</style>
