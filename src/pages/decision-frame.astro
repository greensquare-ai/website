---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';

const questions = [
  { n: '1', q: 'What exactly are you deciding, and why now?', body: 'State the Decision in one sentence. Then name the event, deadline or pressure that made it active now.' },
  { n: '2', q: 'What larger decision sits underneath it?', body: 'If the immediate choice disappeared, which bigger question would still need an answer?' },
  { n: '3', q: 'Which option is missing?', body: 'Add a genuine third path. It may be a smaller commitment, a different sequence or keeping the current position.' },
  { n: '4', q: 'Which assumption carries the decision?', body: 'Find the single Assumption that would change the recommendation if it proved wrong.' },
  { n: '5', q: 'Which constraints have you verified?', body: 'Check the deadline, budget, policy, capacity and stakeholder positions you have been treating as fixed.' },
  { n: '6', q: 'What do you know?', body: 'Mark each material claim as GIVEN, INFERRED or UNKNOWN. Keep the gaps visible.' },
];
---
<BaseLayoutV2
  title="The Decision Frame | Six questions before AI answers"
  description="A free one-page worksheet with six questions to expose the real decision, test the assumption carrying the most risk and separate evidence from interpretation."
  current="frame"
>
  <section class="v-section v-off hero">
    <div class="v-container v-container--narrow v-reveal">
      <h1 class="v-display">Frame the decision before AI answers it.</h1>
      <p class="v-lead" style="margin-top: var(--v-6);">
        Many weak recommendations begin before the analysis. The decision is framed too narrowly, an Option is
        treated as fixed or an Assumption goes untested. The Decision Frame is a free, one-page worksheet that
        exposes those problems before you compare options.
      </p>
      <div class="hero-actions">
        <a class="v-btn v-btn--green" href="#get-it">Get the one-page PDF</a>
        <a class="v-btn v-btn--grey" href={withBase('/product/')}>See the complete process</a>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow v-reveal">
      <h2 class="v-h2">The question you would rather skip is often the one that matters.</h2>
      <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        Work through the questions by hand, or paste them into Claude, ChatGPT or Gemini with the decision.
        Answer in order. Resist smoothing over uncertainty or treating an unverified constraint as fixed.
      </p>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <h2 class="v-h2">The six questions.</h2>
      <div class="v-caplist">
        {questions.map((item) => (
          <div class="v-caprow v-reveal">
            <span class="v-index">Question {item.n}</span>
            <h3>{item.q}</h3>
            <p class="v-small v-cap-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">The output is a clearer decision, not a longer document.</h2>
      <div class="v-card v-reveal" style="margin-top: var(--v-6);">
        <ul class="v-leadlist">
          <li><strong>The Decision.</strong> One clear sentence that names the choice and why it must be made now.</li>
          <li><strong>A wider option set.</strong> At least one credible path beyond the choices you started with.</li>
          <li><strong>The critical Assumption.</strong> The belief that deserves the fastest test.</li>
          <li><strong>An evidence map.</strong> A simple view of what is GIVEN, INFERRED and still UNKNOWN.</li>
        </ul>
      </div>
      <p class="v-measure" style="margin-top: var(--v-8); color: var(--v-ink-soft);">
        The Decision Frame prepares the choice. <a href={withBase('/product/')}>The Decision</a> then interrogates
        the context, compares the Options and produces the complete Decision Brief.
      </p>
    </div>
  </section>

  <section class="v-section v-green" id="get-it">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">Put the six questions beside your next decision.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          Enter your email and confirm the address. The one-page Decision Frame will arrive immediately after.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <EmailCaptureForm client:visible buttonLabel="Email me the Decision Frame" />
        </div>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
</style>
