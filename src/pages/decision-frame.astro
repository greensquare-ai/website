---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';

const questions = [
  { n: '1', q: 'What exactly are you deciding, and why now?', body: 'State the decision in one sentence. Then name the event, deadline or pressure that made it active now.' },
  { n: '2', q: 'What larger decision sits underneath it?', body: 'If the immediate choice disappeared, which bigger question would still need an answer?' },
  { n: '3', q: 'Which option is missing?', body: 'Add a genuine third path. It may be a smaller commitment, a different sequence, or keeping the current position.' },
  { n: '4', q: 'Which assumption carries the decision?', body: 'Find the single belief that would change the recommendation if it proved wrong.' },
  { n: '5', q: 'Which constraints have you verified?', body: 'Check the deadline, budget, policy, capacity and stakeholder positions you have been treating as fixed.' },
  { n: '6', q: 'What do you know?', body: 'Mark each important claim as given, inferred or unknown. Keep the gaps visible.' },
];
---
<BaseLayoutV2
  title="The Decision Frame | GreenSquare"
  description="A free one-page worksheet with six questions that helps you define the real decision, test assumptions and map the evidence before comparing options."
  current="frame"
>
  <section class="v-section v-off hero">
    <div class="v-container v-container--narrow v-reveal">
      <h1 class="v-display">The Decision Frame.</h1>
      <p class="v-lead" style="margin-top: var(--v-6);">
        A free one page worksheet with six questions. In about ten minutes, it helps you define the real call,
        find the assumption carrying the most risk, and separate facts from guesses before you compare options.
      </p>
      <div class="hero-actions">
        <a class="v-btn v-btn--green" href="#get-it">Get the one page PDF</a>
        <a class="v-btn v-btn--grey" href="/product/">See The Decision</a>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow v-reveal">
      <h2 class="v-h2">Use it on a live decision.</h2>
      <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        Work through the questions by hand, or paste them into Claude, ChatGPT or Gemini with your decision.
        Answer in order. The questions that feel inconvenient often reveal the evidence that matters most.
      </p>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <h2 class="v-h2">The six questions.</h2>
      <div class="v-caplist">
        {questions.map((item) => (
          <div class="v-caprow v-reveal">
            <span class="v-index">/{item.n.padStart(2, '0')}</span>
            <h3>{item.q}</h3>
            <p class="v-small v-cap-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2">You finish with four things.</h2>
      <div class="v-card v-reveal" style="margin-top: var(--v-6);">
        <ul class="v-leadlist">
          <li><strong>The real decision.</strong> One clear sentence that names the choice and the reason it matters now.</li>
          <li><strong>A wider option set.</strong> At least one credible path beyond the choices you started with.</li>
          <li><strong>The critical assumption.</strong> The belief that deserves the fastest test.</li>
          <li><strong>An evidence map.</strong> A simple view of what is given, inferred and still unknown.</li>
        </ul>
      </div>
      <p class="v-measure" style="margin-top: var(--v-8); color: var(--v-ink-soft);">
        The Frame prepares the decision. <a href="/product/">The Decision</a> then compares the options, makes
        the recommendation, and produces the complete brief.
      </p>
    </div>
  </section>

  <section class="v-section v-green" id="get-it">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">Get the free Decision Frame.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          We will email you the one page PDF. Confirm your address, then the Frame will arrive in your inbox.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <EmailCaptureForm client:visible buttonLabel="Email me the Decision Frame" />
        </div>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
</style>
