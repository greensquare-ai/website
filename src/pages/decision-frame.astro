---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';
import AdaptiveQuestioningFigure from '../components/research-figures/AdaptiveQuestioningFigure.astro';
import DecisionToActionFigure from '../components/research-figures/DecisionToActionFigure.astro';

const capabilities = [
  { n: '01', name: 'Frame', body: 'Clarifies the actual mandate, why the decision is active and what a good outcome means before moving to advice.' },
  { n: '02', name: 'Inspect', body: 'Separates GIVEN, DERIVED, INFERRED and UNKNOWN, then exposes contradictions, inherited constraints and load-bearing assumptions.' },
  { n: '03', name: 'Test', body: 'Forms a working view, asks what evidence could change it and keeps unresolved uncertainty visible instead of smoothing it away.' },
  { n: '04', name: 'Compare', body: 'Develops genuinely relevant options and tests them against criteria established for the decision rather than the preferred answer.' },
  { n: '05', name: 'Decide', body: 'Makes the call when the evidence permits. When it does not, it specifies the next evidence-producing decision and what result would change the call.' },
  { n: '06', name: 'Execute', body: 'Turns the decision into proportionate actions, ownership, measures, evidence thresholds and review conditions.' },
];
---
<BaseLayoutV2
  title="The Decision Frame beta | A portable decision system for AI"
  description="The free Decision Frame V2 beta gives a capable AI model a disciplined method to interrogate a business decision, inspect evidence, compare options and make a traceable call."
  current="frame"
>
  <section class="v-masthead">
    <div class="v-container v-masthead__grid">
      <div class="v-masthead__copy v-reveal">
        <p class="v-index">Decision Frame V2 / Free beta</p>
        <h1 class="v-display" style="margin-top: var(--v-4);">Give it the problem. It works out what to ask next.</h1>
        <p class="v-lead">
          The Decision Frame turns a capable AI model into a disciplined thinking partner. It clarifies the mandate,
          interrogates evidence and assumptions, compares relevant options, makes the call when possible and turns it
          into action.
        </p>
        <div class="hero-actions">
          <a class="v-btn v-btn--green" href="#get-it">Get the free Decision Frame beta</a>
          <a class="v-btn v-btn--grey" href="#how-it-works">See how it works</a>
        </div>
      </div>

      <aside class="v-system-ledger v-reveal d1" aria-label="Decision Frame release summary">
        <div class="v-system-ledger__head">
          <span>Portable method / beta</span>
          <span class="v-system-ledger__mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        </div>
        <dl>
          <div class="v-system-ledger__row"><dt>Input</dt><dd>A real business decision or problem</dd></div>
          <div class="v-system-ledger__row"><dt>Interaction</dt><dd>One focused question at a time</dd></div>
          <div class="v-system-ledger__row"><dt>Output</dt><dd>A traceable recommendation and action path</dd></div>
          <div class="v-system-ledger__row"><dt>Control</dt><dd>Evidence, uncertainty and reversal conditions remain visible</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="v-section" id="how-it-works">
    <div class="v-container v-container--narrow v-reveal">
      <h2 class="v-h2">Ordinary AI can answer the wrong decision very well.</h2>
      <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        A model will often accept the question, constraints and options it is given. The Decision Frame changes what
        happens before the answer. It controls how the model interrogates the situation, advances the reasoning and
        decides whether the evidence is strong enough to make the call.
      </p>
    </div>
  </section>

  <section class="v-section figure-band">
    <div class="v-container">
      <div class="figure-intro v-reveal">
        <p class="v-index">Figure 02 / Adaptive questioning</p>
        <h2 class="v-h2">The method follows the decision, not a questionnaire.</h2>
        <p class="v-measure">A single answer can change what the model needs to establish next. The point is not more questions; it is better sequencing of the questions that matter.</p>
      </div>
      <div class="v-reveal d1"><AdaptiveQuestioningFigure /></div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <h2 class="v-h2">A decision process that adapts to the problem.</h2>
      <div class="v-caplist">
        {capabilities.map((item, index) => (
          <div class={`v-caprow v-reveal${index > 0 ? ` d${Math.min(index, 3)}` : ''}`}>
            <span class="v-index">State {item.n}</span>
            <h3>{item.name}</h3>
            <p class="v-small v-cap-body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">One file. One conversation. No prompt engineering.</h2>
        <p class="v-measure" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
          Download the Decision Frame, upload it to a capable AI model and give it the decision or business problem.
          It should explain the method briefly, then begin with one focused question and adapt from there.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> How to use it</div>
          <div class="v-readout__body">
            <ul class="v-spec__list">
              <li><span class="n">1</span> Download the file</li>
              <li><span class="n">2</span> Upload it to your AI</li>
              <li><span class="n">3</span> Give it the problem</li>
              <li><span class="n">4</span> Answer one focused question at a time</li>
              <li><span class="n">5</span> Receive a traceable decision and execution path</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green evidence-boundary">
    <div class="v-container v-container--narrow v-reveal">
      <p class="v-quote">The moment to look for is simple: it knew what to ask next.</p>
      <p class="v-small" style="margin-top: var(--v-5); max-width: 72ch;">
        V2 is launching as a beta. The statement above describes the intended experience, not a quantified
        performance result. The published 45-run benchmark covers an earlier GreenSquare decision method; fresh V2
        cross-model validation and professional beta testing continue after launch.
      </p>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <div class="figure-intro v-reveal">
        <p class="v-index">Figure 04 / Decision to action</p>
        <h2 class="v-h2">A recommendation is not finished until its conditions are operational.</h2>
        <p class="v-measure">The method carries the evidence threshold, next action and reversal condition forward so the user can act without losing the reasoning behind the call.</p>
      </div>
      <div class="v-reveal d1"><DecisionToActionFigure /></div>
    </div>
  </section>

  <section class="v-section v-green" id="get-it">
    <div class="v-container v-split is-top">
      <div class="v-reveal">
        <h2 class="v-h2">Put a stronger judgement process behind your next decision.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          Enter your email and confirm the address. The free Decision Frame V2 beta will arrive immediately after confirmation.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-card">
          <EmailCaptureForm client:visible buttonLabel="Email me the free beta" />
        </div>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .evidence-boundary .v-quote { color: var(--v-cream); }
  .evidence-boundary .v-small { color: var(--v-cream-soft); }
  .figure-band { padding-top: clamp(2.5rem, 4vw, 4rem); }
  .figure-intro { max-width: 52rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .figure-intro .v-h2 { margin-top: var(--v-3); }
  .figure-intro .v-measure { margin-top: var(--v-4); color: var(--v-ink-soft); }
</style>
