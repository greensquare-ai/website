---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import Signup from '../components/Signup.astro';
import CaptureForm from '../components/CaptureForm.astro';
import FrameFreeFilm from '../components/FrameFreeFilm.astro';
import Faq from '../components/Faq.astro';
import { frameFreeFilm } from '../data/frame-free-film';
import { offer, situations } from '../data/offer';
import { beforeAfter, workedExample } from '../data/worked-example';

const free = offer.free;
const part = (guide: string) => workedExample.parts.find((p) => p.guide === guide)!;
/* The film's insight in three lines, quoted from the guide's worked example. */
const insight = [
  { label: 'What they were asked', text: part('Presented decision').lines[0].text },
  { label: 'The real question', text: part('Decision underneath').lines[0].text },
  { label: 'Why new software alone would not help', text: part('Load-bearing assumption').lines[0].text },
];
const benefits = [
  'What you are really deciding.',
  'What you know, and what you are only assuming.',
  'The one thing to check before you commit.',
];
---
<BaseLayoutV2
  title="GreenSquare AI | Find the real question before AI answers it"
  description="Frame Free is a free six-page PDF for ChatGPT, Claude or Gemini. The AI asks you six questions about one decision. In about ten minutes you know the real question, what you are assuming and what to check first."
  current="home"
>
  <section class="v-hero home-hero">
    <div class="v-container home-hero__grid">
      <div class="home-hero__copy">
        <h1>Find the real question before AI answers it</h1>
        <p class="v-lead">Frame Free is a free guide you attach to ChatGPT, Claude or Gemini. The AI asks you six questions about one decision. In about ten minutes you will know:</p>
        <ul class="home-benefits">
          {benefits.map((b) => <li>{b}</li>)}
        </ul>
        <p class="home-hero__scope">{free.scope}</p>
      </div>
      <div class="d-panel d-panel--ink home-hero__offer">
        <p class="home-hero__offer-line">{free.offerLine}</p>
        <CaptureForm location="home_hero" eager />
        <a class="v-link home-hero__secondary" href="#worked-example">Watch the example first</a>
      </div>
    </div>
  </section>

  <section class="v-section home-film" id={frameFreeFilm.id}>
    <div class="v-container">
      <div class="home-film__head">
        <h2>Watch it question one decision</h2>
        <p>An operations manager is told to choose between two rostering platforms before the contract runs out. Frame Free asks its six questions. It finds that the shift rules keep changing, so new software alone would not fix the problem. It does not pick a platform: that stays with the manager.</p>
      </div>
      <FrameFreeFilm />
      <dl class="home-insight">
        {insight.map((row) => <div><dt>{row.label}</dt><dd>{row.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="v-section v-section--wash" id="output">
    <div class="v-container">
      <div class="home-section__head">
        <h2>What you bring, and what you leave with</h2>
        <p>The question moves from which software to buy to what the shift rules should be. Nothing is scored or chosen. You decide what happens next.</p>
      </div>
      <div class="home-before-after">
        <div class="d-panel">
          <div class="d-panel__head"><strong>You bring</strong><span>The decision as it was put to you</span></div>
          <div class="d-panel__body"><p>{beforeAfter.before}</p></div>
        </div>
        <div class="d-panel d-panel--ink">
          <div class="d-panel__head"><strong>You leave with</strong><span>A better question, and what to check first</span></div>
          <div class="d-panel__body">
            <p>{beforeAfter.after}</p>
            <p class="home-before-after__gap"><strong>Check first:</strong> {beforeAfter.checkFirst}</p>
          </div>
        </div>
      </div>
      <p class="home-section__more"><a class="v-link" href={withBase('/free/#sample')}>See the full seven-part summary</a></p>
    </div>
  </section>

  <section class="v-section" id="setup">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>How it works</h2>
        <p>Under five minutes to set up, then about ten minutes for one decision.</p>
        <a class="v-link" href={withBase('/start/')}>Read the start guide</a>
      </div>
      <ol class="d-list d-list--indexed">
        {free.setup.map((step, i) => (
          <li><span class="d-list__index">{String(i + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v-section v-section--wash" id="situations">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Who it is for</h2>
        <p>Owners, managers and advisers facing a business decision with money, people or a deadline at stake. It suits decisions like these. Each links to a worked example.</p>
      </div>
      <ul class="home-situations">
        {situations.map((s) => (
          <li>
            <a href={withBase(`/examples/#${s.id}`)} data-ff-event="example_selected" data-ff-location={`home_${s.id}`}>
              <strong>{s.title}</strong>
              <span>{s.situation}</span>
              <span class="home-situations__issue">What it checks: {s.issue}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v-section" id="questions">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Questions before you start</h2>
        <p>More detail, including your data and the full summary, is on the <a href={withBase('/free/')}>Frame Free page</a>.</p>
      </div>
      <Faq homeOnly />
    </div>
  </section>

  <Signup location="home_footer" />
</BaseLayoutV2>

<style>
  .home-hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(2.5rem, 5vw, 4rem); }
  .home-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .home-hero__copy h1 { max-width: 14ch; font-size: clamp(2.5rem, 1.7rem + 3vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; }
  .home-hero__copy .v-lead { max-width: 44ch; color: var(--v-ink); }
  .home-benefits { list-style: none; margin: var(--v-4) 0 0; padding: 0; display: grid; gap: var(--v-2); }
  .home-benefits li { position: relative; padding-left: 1.75rem; font-size: var(--vs-lead); font-weight: 500; line-height: 1.4; }
  .home-benefits li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 0.75rem; height: 0.75rem; background: var(--v-green); }
  .home-hero__scope { margin: var(--v-5) 0 0; max-width: 52ch; padding-top: var(--v-4); border-top: 1px solid var(--v-line); font-size: var(--vs-small); color: var(--v-ink-soft); }
  .home-hero__offer { padding: clamp(1.25rem, 3vw, 2rem); border-top: 4px solid var(--v-green); }
  .home-hero__offer-line { margin: 0 0 var(--v-4); font-weight: 600; color: var(--v-ink); }
  .home-hero__secondary { display: inline-block; margin-top: var(--v-4); }
  @media (max-width: 860px) {
    .home-hero__grid { grid-template-columns: 1fr; gap: var(--v-6); }
    .home-hero__copy h1 { max-width: 15ch; }
  }

  .home-film { padding-top: clamp(2rem, 4vw, 3rem); }
  .home-film__head { margin-bottom: var(--v-6); max-width: 64ch; }
  .home-film__head p { color: var(--v-ink-soft); margin-top: var(--v-4); }
  .home-insight { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--v-5); margin: var(--v-6) 0 0; border-top: 3px solid var(--v-green); }
  .home-insight > div { padding-top: var(--v-4); }
  .home-insight dt { font-weight: 600; color: var(--v-ink); }
  .home-insight dd { margin: var(--v-2) 0 0; color: var(--v-ink-soft); }
  @media (max-width: 800px) {
    .home-insight { grid-template-columns: 1fr; gap: 0; }
    .home-insight > div + div { border-top: 1px solid var(--v-line); margin-top: var(--v-4); }
  }

  .home-section__head { max-width: 62ch; margin-bottom: var(--v-6); }
  .home-section__head p { color: var(--v-ink-soft); margin-top: var(--v-4); }
  .home-before-after { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--v-4); }
  .home-before-after .d-panel__body p { margin: 0; font-size: var(--vs-lead); line-height: 1.45; }
  .home-before-after .d-panel__body .home-before-after__gap { margin-top: var(--v-4); padding-top: var(--v-4); border-top: 1px solid var(--v-line); font-size: var(--vs-small); }
  .home-section__more { margin: var(--v-5) 0 0; }
  @media (max-width: 760px) { .home-before-after { grid-template-columns: 1fr; } }

  .home-situations { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--v-line); }
  .home-situations a { display: grid; gap: var(--v-1); padding: var(--v-4) 0; border-bottom: 1px solid var(--v-line); color: var(--v-ink); text-decoration: none; }
  .home-situations a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .home-situations strong { font-weight: 600; color: var(--v-green); }
  .home-situations span { color: var(--v-ink-soft); }
  .home-situations .home-situations__issue { color: var(--v-ink); font-size: var(--vs-meta); }
</style>
