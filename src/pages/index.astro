---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import Signup from '../components/Signup.astro';
import CaptureForm from '../components/CaptureForm.astro';
import FrameFreeFilm from '../components/FrameFreeFilm.astro';
import FreeHandoff from '../components/FreeHandoff.astro';
import { frameFreeFilm } from '../data/frame-free-film';
import { offer, situations } from '../data/offer';

const free = offer.free;
/* The guide's worked example, read from the film's data so the page quotes what the film shows. */
const parts = frameFreeFilm.textEquivalent.parts;
const part = (label: string) => parts.find((p) => p.label === label)!;
const presented = part('Presented decision').lines[0].text;
const underneath = part('Decision underneath').lines[0].text;
const assumption = part('Load-bearing assumption').lines[0].text;
const [reframed, gap] = parts[parts.length - 1].lines.map((line) => line.text);
---
<BaseLayoutV2
  title="GreenSquare AI | Frame the decision before AI answers it"
  description="Frame Free is a free six-page PDF for ChatGPT, Claude or Gemini. It questions one business decision, separates evidence from assumption and names the next gap to check, then stops before ranking or recommending."
  current="home"
>
  <section class="v-hero home-hero">
    <div class="v-container home-hero__grid">
      <div class="home-hero__copy">
        <h1>Frame the decision before AI answers it.</h1>
        <p class="v-lead">Use Frame Free with the AI you already use to question the decision, separate evidence from assumption and identify the next gap to check.</p>
        <p class="home-hero__scope">{free.scope}</p>
      </div>
      <div class="d-panel d-panel--ink home-hero__offer">
        <p class="home-hero__offer-line">{free.offerLine}</p>
        <CaptureForm location="home_hero" eager />
        <a class="v-link home-hero__secondary" href="#worked-example">See the Free example</a>
      </div>
    </div>
  </section>

  <section class="v-section home-film" id={frameFreeFilm.id}>
    <div class="v-container">
      <div class="home-film__head">
        <h2>{frameFreeFilm.heading}</h2>
        <p>{frameFreeFilm.intro}</p>
      </div>
      <FrameFreeFilm />
      <div class="home-contrast">
        <p class="home-contrast__label">What the guide’s worked example shows</p>
        <dl class="home-contrast__grid">
          <div><dt>The vendor choice</dt><dd>{presented}</dd></div>
          <div><dt>What it concealed</dt><dd>{underneath}</dd></div>
          <div><dt>Why switching may not help</dt><dd>{assumption}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="v-section v-section--rule" id="output">
    <div class="v-container">
      <div class="home-section__head">
        <h2>The question you bring, and the one you leave with.</h2>
        <p>Frame Free does not answer the question as presented. It returns a framing handoff in seven parts, so you can see what was assumed, what was verified and what to check next.</p>
      </div>
      <div class="home-before-after">
        <div class="d-panel">
          <div class="d-panel__head"><strong>Before</strong><span>The question as presented</span></div>
          <div class="d-panel__body"><p>{presented}</p></div>
        </div>
        <div class="d-panel d-panel--ink">
          <div class="d-panel__head"><strong>After</strong><span>Reframed, with the gap to verify</span></div>
          <div class="d-panel__body"><p>{reframed}</p><p class="home-before-after__gap">{gap}</p></div>
        </div>
      </div>
      <FreeHandoff id="home-handoff" />
    </div>
  </section>

  <section class="v-section v-section--rule" id="situations">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Five decisions it is built to question.</h2>
        <p>Each links to an illustrative example: the starting decision, what was questioned, the framing handoff and what remains unknown. The PDF is the same whichever you read.</p>
      </div>
      <ul class="home-situations">
        {situations.map((s) => (
          <li>
            <a href={withBase(`/examples/#${s.id}`)} data-ff-event="example_selected" data-ff-location={`home_${s.id}`}>
              <strong>{s.title}</strong>
              <span>{s.situation}</span>
              <span class="home-situations__issue">To inspect: {s.issue}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v-section v-section--rule" id="setup">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Three steps to the first question.</h2>
        <p>{free.delivery.setup} Then about ten minutes for one decision.</p>
        <a class="v-link" href={withBase('/start/')}>Read the start guide</a>
      </div>
      <ol class="d-list d-list--indexed">
        {free.setup.map((step, i) => (
          <li><span class="d-list__index">{String(i + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v-section v-section--rule" id="evidence">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>What has and has not been shown.</h2>
      </div>
      <div class="d-panel home-evidence">
        <dl class="d-meta">
          <div><dt>Shown here</dt><dd>The guide’s own worked example, and illustrative examples on fictional inputs. They show how the framing behaves, not customer results.</dd></div>
          <div><dt>Not shown</dt><dd>Frame Free has not been benchmarked. An earlier study tested a method file that predates Frame: it changed how the model worked, and it did not beat an informed baseline on judgement.</dd></div>
          <div><dt>Not offered</dt><dd>Ranking, scoring or a recommendation. Frame Pro, which continues into those, is in development.</dd></div>
        </dl>
        <div class="d-panel__foot"><p><a href={withBase('/research/')}>Read the research overview</a></p></div>
      </div>
    </div>
  </section>

  <Signup location="home_footer" />
</BaseLayoutV2>

<style>
  .home-hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem); }
  .home-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .home-hero__copy h1 { max-width: 13ch; font-size: clamp(2.5rem, 1.7rem + 3vw, 4rem); line-height: 1.04; letter-spacing: -0.02em; }
  .home-hero__copy .v-lead { max-width: 40ch; }
  .home-hero__scope { margin: var(--v-5) 0 0; max-width: 52ch; padding-top: var(--v-4); border-top: 1px solid var(--v-line); font-size: var(--vs-small); color: var(--v-ink-soft); }
  .home-hero__offer { padding: clamp(1.25rem, 3vw, 2rem); }
  .home-hero__offer-line { margin: 0 0 var(--v-4); font-weight: 600; color: var(--v-ink); }
  .home-hero__secondary { display: inline-block; margin-top: var(--v-4); }
  @media (max-width: 860px) {
    .home-hero__grid { grid-template-columns: 1fr; gap: var(--v-6); }
    .home-hero__copy h1 { max-width: 15ch; }
  }

  .home-film { padding-top: clamp(2rem, 4vw, 3rem); }
  .home-film__head { margin-bottom: var(--v-6); max-width: 60ch; }
  .home-film__head h2 { max-width: 18ch; }
  .home-film__head p { color: var(--v-ink-soft); margin-top: var(--v-4); }
  .home-contrast { margin-top: var(--v-6); }
  .home-contrast__label { margin: 0 0 var(--v-3); font-size: var(--vs-meta); font-weight: 500; color: var(--v-ink-soft); }
  .home-contrast__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--v-5); margin: 0; border-top: 1px solid var(--v-ink); }
  .home-contrast__grid > div { padding-top: var(--v-4); }
  .home-contrast__grid dt { font-size: var(--vs-small); font-weight: 600; color: var(--v-ink); }
  .home-contrast__grid dd { margin: var(--v-2) 0 0; font-size: var(--vs-small); color: var(--v-ink-soft); }
  @media (max-width: 800px) {
    .home-contrast__grid { grid-template-columns: 1fr; gap: 0; }
    .home-contrast__grid > div + div { border-top: 1px solid var(--v-line); margin-top: var(--v-4); }
  }

  .home-section__head { max-width: 60ch; margin-bottom: var(--v-6); }
  .home-section__head p { color: var(--v-ink-soft); margin-top: var(--v-4); }
  .home-before-after { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--v-4); margin-bottom: var(--v-4); }
  .home-before-after .d-panel__body p { margin: 0; }
  .home-before-after .d-panel__body .home-before-after__gap { margin-top: var(--v-3); padding-top: var(--v-3); border-top: 1px solid var(--v-line); font-size: var(--vs-small); color: var(--v-ink-soft); }
  @media (max-width: 760px) { .home-before-after { grid-template-columns: 1fr; } }

  .home-situations { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--v-line); }
  .home-situations a { display: grid; gap: var(--v-1); padding: var(--v-4) 0; border-bottom: 1px solid var(--v-line); color: var(--v-ink); text-decoration: none; }
  .home-situations a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .home-situations strong { font-weight: 600; }
  .home-situations span { font-size: var(--vs-small); color: var(--v-ink-soft); }
  .home-situations .home-situations__issue { color: var(--v-ink); }

  .home-evidence .d-meta { padding: var(--v-2) var(--v-5); }
  .home-evidence dt { color: var(--v-ink); font-weight: 600; }
</style>
