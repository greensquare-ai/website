---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';
import ThroughFlowHero from '../components/ThroughFlowHero.astro';
---
<BaseLayoutV2
  title="GreenSquare AI | Turn capable AI into a disciplined strategy partner"
  description="GreenSquare gives Claude, ChatGPT and Gemini a disciplined strategy process for consequential business decisions, from the first material question to a defensible recommendation."
  current="home"
>
  <section class="hero-split-section v-off hero">
    <div class="v-container hero-split__grid">
      <div class="hero-split__text v-reveal">
        <h1 class="v-display">Turn capable AI into a disciplined strategy partner.</h1>
        <p class="v-lead" style="margin-top: var(--v-6);">
          Compass loads a structured decision process into Claude, ChatGPT and Gemini. Instead of simply answering
          the question it is given, it clarifies the real decision, compares credible alternatives and shows what
          is known, inferred or uncertain before recommending.
        </p>
        <p class="hero-audience v-small">
          For operators accountable for consequential decisions across strategy, investment, risk and resource allocation.
        </p>
        <div class="hero-actions">
          <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Lens worksheet</a>
          <a class="v-btn v-btn--grey" href={withBase('/benchmark/')}>Read the benchmark</a>
        </div>
      </div>
    </div>
    <div class="hero-split__media v-reveal d1">
      <ThroughFlowHero />
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <p class="v-quote v-reveal">The quality of a recommendation depends on the questions asked before it, the evidence beneath it and the conditions that could change it.</p>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 24ch;">A disciplined recommendation starts before the model answers.</h2>
      <div class="v-caplist">
        <div class="v-caprow v-reveal">
          <span class="v-index">Frame</span>
          <h3>Clarify the real decision before answering</h3>
          <p class="v-small v-cap-body">
            Compass asks for missing facts, checks whether the stated question is the decision that actually matters,
            and surfaces contradictions before they harden into assumptions.
          </p>
        </div>
        <div class="v-caprow v-reveal d1">
          <span class="v-index">Compare</span>
          <h3>Force genuine alternatives, including doing nothing</h3>
          <p class="v-small v-cap-body">
            It develops credible options, keeps the current position in the set, and tests each against criteria
            fixed before a preferred answer is known.
          </p>
        </div>
        <div class="v-caprow v-reveal d2">
          <span class="v-index">Substantiate</span>
          <h3>Show what is known, derived, inferred or still unknown</h3>
          <div class="v-small v-cap-body">
            <p>
              Material claims are labelled so a reader can inspect the basis of the recommendation, then test the
              assumptions, trade-offs and conditions that could change it.
            </p>
            <p class="evidence-tag-row" aria-label="Evidence labels">
              <span class="v-tag">GIVEN</span>
              <span class="v-tag">DERIVED</span>
              <span class="v-tag">INFERRED</span>
              <span class="v-tag">UNKNOWN</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green">
    <div class="v-container v-split is-reverse">
      <div class="v-reveal">
        <h2 class="v-h2">The benchmark shows a more disciplined process, not better judgement.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          In the benchmark, Compass consistently asked before advising, compared genuine alternatives and tagged
          the basis for its claims. The study does not establish that Compass makes better decisions than an
          informed operator. We publish that boundary.
        </p>
        <p class="v-small" style="margin-top: var(--v-5); color: var(--v-cream-soft);">
          45 runs across two frontier models and three business cases. The protocol was pre-registered; the cases,
          scoring rubric and departures from the plan are published.
        </p>
        <p class="v-small" style="margin-top: var(--v-3); color: var(--v-cream-soft);">
          The product was renamed on 30 August 2026, after the study was run and scored. The product named
          Compass here is the one that was tested under its former name.
        </p>
        <a class="v-link" href={withBase('/benchmark/')} style="display:inline-block; margin-top: var(--v-6);">See what the benchmark supports, and what it does not</a>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> What is published</div>
          <div class="v-readout__body">
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Pre-registration</span><span class="v-run__val"><b>Hashed</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Cases and rubric</span><span class="v-run__val"><b>Public</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Deviations</span><span class="v-run__val"><b>Published</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Transcripts</span><span class="v-run__val">Withheld</span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Results</span><span class="v-run__val">See benchmark</span></div></div>
          </div>
          <div class="v-readout__foot">One evidence record / results and limitations on the benchmark page</div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-next v-fill-2" aria-label="Get started">
    <div class="v-container home-next__inner">
      <div class="home-next__copy v-reveal">
        <h2 class="v-h2">Start with the decision itself.</h2>
        <p class="v-lead">
          Lens is a free 10-minute worksheet for naming the real choice, surfacing the assumption carrying the most
          risk and separating evidence from interpretation before asking AI for an answer.
        </p>
      </div>
      <div class="home-next__action v-reveal d1">
        <EmailCaptureForm client:visible buttonLabel="Email me the Lens worksheet" />
        <a class="v-link home-next__benchmark" href={withBase('/benchmark/')}>Review the evidence and limitations</a>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  /* Full-bleed split-screen hero: text left, Through-flow Passage right. */
  .hero-split-section {
    position: relative;
    min-height: clamp(480px, 62vh, 680px);
    display: flex;
    overflow: hidden;
  }
  .hero-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 100%;
  }
  .hero-split__text {
    grid-column: 1;
    max-width: 34rem;
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vh, 4rem);
    position: relative;
    z-index: 1;
  }
  .hero-audience { margin-top: var(--v-4); max-width: 48ch; color: var(--v-ink-soft); }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
  .hero-split__media {
    position: absolute; top: 0; bottom: 0;
    left: 50%;
    right: 0;
  }
  .evidence-tag-row { display: flex; flex-wrap: wrap; gap: var(--v-2); margin-top: var(--v-3); }
  @media (max-width: 900px) {
    .hero-split-section { min-height: 0; display: block; }
    .hero-split__grid { grid-template-columns: 1fr; }
    .hero-split__media { position: static; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 640px) {
    .hero-split__text { padding-block: var(--v-8); }
    .hero-split__text .v-lead { margin-top: var(--v-4) !important; }
    .hero-actions { margin-top: var(--v-6); }
    .hero-split__media { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 560px) {
    .v-caprow .v-cap-body { grid-column: 1; }
  }
  .home-next { padding-block: clamp(4.5rem, 8vw, 6.5rem); }
  .home-next__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(25rem, 1.1fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .home-next__copy { max-width: 40rem; }
  .home-next__copy .v-lead { max-width: 48ch; margin-top: var(--v-4); color: var(--v-ink-soft); }
  .home-next__action { width: min(100%, 35rem); justify-self: end; }
  .home-next__benchmark { display: inline-block; margin-top: var(--v-4); color: var(--v-green); }
  @media (max-width: 900px) {
    .home-next__inner { grid-template-columns: 1fr; gap: var(--v-8); }
    .home-next__action { justify-self: start; }
  }
</style>
