---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';
import ThroughFlowHero from '../components/ThroughFlowHero.astro';
import MethodFigure from '../components/research-figures/MethodFigure.astro';
---
<BaseLayoutV2
  title="GreenSquare AI | Professional judgement for capable AI"
  description="GreenSquare gives capable AI a disciplined professional judgement process for consequential business decisions, from the first material question to a traceable recommendation and execution path."
  current="home"
>
  <section class="hero-split-section v-off hero">
    <div class="v-container hero-split__grid">
      <div class="hero-split__text v-reveal">
        <h1 class="v-display">Turn capable AI into a disciplined strategy partner.</h1>
        <p class="v-lead" style="margin-top: var(--v-6);">
          GreenSquare gives capable AI a disciplined process for consequential business decisions. It frames the real
          choice, interrogates evidence, tests credible options and shows what supports the call.
        </p>
        <div class="hero-actions">
          <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free beta</a>
          <a class="v-btn v-btn--grey" href={withBase('/benchmark/')}>Read the benchmark</a>
        </div>
      </div>
    </div>
    <div class="hero-split__media v-reveal d1">
      <ThroughFlowHero />
    </div>
  </section>

  <section class="v-section figure-section" aria-labelledby="method-figure-title">
    <div class="v-container">
      <div class="figure-intro v-reveal">
        <p class="v-index">Research figure / decision method</p>
        <h2 class="v-h2" id="method-figure-title">A judgement process designed around the professional who owns the call.</h2>
        <p class="v-measure">
          GreenSquare structures the work between a business problem and an accountable decision. The model supplies intelligence; the method determines what should be established before that intelligence becomes advice.
        </p>
      </div>
      <div class="v-reveal d1 figure-frame">
        <MethodFigure />
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <p class="v-quote v-reveal">The quality of a recommendation depends on the questions asked before it, the evidence beneath it and the conditions that could change it.</p>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 24ch;">A disciplined recommendation starts before the model answers.</h2>
      <div class="v-caplist">
        <div class="v-caprow v-reveal">
          <span class="v-index">Frame</span>
          <h3>Find the question behind the question</h3>
          <p class="v-small v-cap-body">
            The Decision Frame asks for missing facts before offering advice. It checks whether the stated question is
            the real decision and makes contradictions visible while they can still change the work.
          </p>
        </div>
        <div class="v-caprow v-reveal d1">
          <span class="v-index">Compare</span>
          <h3>Test credible options against the same criteria</h3>
          <p class="v-small v-cap-body">
            It develops genuine alternatives, including keeping the current position. Each option is tested against
            criteria fixed for the decision rather than criteria introduced to justify a preferred answer.
          </p>
        </div>
        <div class="v-caprow v-reveal d2">
          <span class="v-index">Substantiate</span>
          <h3>Keep the evidence and uncertainty inspectable</h3>
          <p class="v-small v-cap-body">
            Material claims are marked GIVEN, DERIVED, INFERRED or UNKNOWN. The final synthesis keeps the assumptions,
            trade-offs, evidence thresholds and conditions that would change the recommendation visible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green">
    <div class="v-container v-split is-reverse">
      <div class="v-reveal">
        <h2 class="v-h2">The current evidence is strongest on process discipline.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          In a 45-run pre-registered test across two frontier models and three business cases, the earlier GreenSquare
          decision method consistently asked before advising, compared real options and tagged its evidence. Decision
          Frame V2 is now launching separately as a beta; the historical benchmark is not a fresh quantitative test of
          V2. Cross-model V2 validation continues after launch.
        </p>
        <a class="v-link" href={withBase('/benchmark/')} style="display:inline-block; margin-top: var(--v-6);">See what the benchmark supports, and what it does not</a>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> What is published</div>
          <div class="v-readout__body">
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Pre-registration</span><span class="v-run__val"><b>Hashed</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Cases and rubric</span><span class="v-run__val"><b>Public</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Deviations</span><span class="v-run__val"><b>Published</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Transcripts</span><span class="v-run__val">Withheld</span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Results</span><span class="v-run__val">See benchmark</span></div></div>
          </div>
          <div class="v-readout__foot">Historical benchmark / V2 beta validation continues after launch</div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-next v-fill-2" aria-label="Get started">
    <div class="v-container home-next__inner">
      <div class="home-next__copy v-reveal">
        <h2 class="v-h2">Give it the problem. Let the method work out what to ask next.</h2>
        <p class="v-lead">
          The free Decision Frame V2 beta is a portable decision system for a capable AI model. It moves from the
          mandate through evidence, hypotheses and options to a traceable recommendation and proportionate execution path.
        </p>
      </div>
      <div class="home-next__action v-reveal d1">
        <EmailCaptureForm client:visible buttonLabel="Email me the free beta" />
        <a class="v-link home-next__benchmark" href={withBase('/benchmark/')}>Review the evidence and limitations</a>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .hero-split-section {
    position: relative;
    min-height: clamp(480px, 62vh, 680px);
    display: flex;
    overflow: hidden;
  }
  .hero-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 100%;
  }
  .hero-split__text {
    grid-column: 1;
    max-width: 34rem;
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vh, 4rem);
    position: relative;
    z-index: 1;
  }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
  .hero-split__media {
    position: absolute; top: 0; bottom: 0;
    left: 50%;
    right: 0;
  }
  .figure-section { padding-top: clamp(4rem, 7vw, 6.5rem); }
  .figure-intro { max-width: 52rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .figure-intro .v-h2 { margin-top: var(--v-3); }
  .figure-intro .v-measure { margin-top: var(--v-4); color: var(--v-ink-soft); }
  .figure-frame { max-width: 1320px; }
  @media (max-width: 900px) {
    .hero-split-section { min-height: 0; display: block; }
    .hero-split__grid { grid-template-columns: 1fr; }
    .hero-split__media { position: static; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 640px) {
    .hero-split__text { padding-block: var(--v-8); }
    .hero-split__text .v-lead { margin-top: var(--v-4) !important; }
    .hero-actions { margin-top: var(--v-6); }
    .hero-split__media { aspect-ratio: 4 / 3; }
  }
  .home-next { padding-block: clamp(4.5rem, 8vw, 6.5rem); }
  .home-next__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(25rem, 1.1fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .home-next__copy { max-width: 40rem; }
  .home-next__copy .v-lead { max-width: 48ch; margin-top: var(--v-4); color: var(--v-ink-soft); }
  .home-next__action { width: min(100%, 35rem); justify-self: end; }
  .home-next__benchmark { display: inline-block; margin-top: var(--v-4); color: var(--v-green); }
  @media (max-width: 900px) {
    .home-next__inner { grid-template-columns: 1fr; gap: var(--v-8); }
    .home-next__action { justify-self: start; }
  }
</style>
