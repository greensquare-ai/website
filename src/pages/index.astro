---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import PlanComparison from '../components/PlanComparison.astro';
import Signup from '../components/Signup.astro';
import { briefExcerpt } from '../data/brief-excerpt';
import { method, offer } from '../data/offer';
import { people } from '../data/operator';
import { armBvsArmC, check, dates, deviations, grid, limitations, spell } from '../lib/benchmark';

const g = grid();
const d = dates();
const cmp = armBvsArmC();
const c6 = check('c6');
const c7 = check('c7');
const c8 = check('c8');
const nDev = deviations().length;
const nLim = spell(limitations().length);
const useWhen = [
  { when: 'A capital or contract commitment that is hard to reverse', why: 'The brief separates the options that keep a way back from the ones that do not.' },
  { when: 'A paper you have to put your name to', why: 'Every material claim is tagged given, derived, inferred or unknown, so the reader can see what you are standing on.' },
  { when: 'A recommendation you already believe', why: 'The method tests the framing you arrived with before it tests anything else.' },
  { when: 'A decision with a date and an owner', why: 'It will not produce a brief without one. If neither exists yet, that is the first finding.' },
];
---
<BaseLayoutV2
  title="GreenSquare AI | Decision support for consequential work"
  description="Frame gives the AI you already use a disciplined process for consequential business decisions. Frame Free, the beta available now, frames the decision and stops before evaluation."
  current="home"
>
  <section class="v-hero home-hero">
    <div class="v-container">
      <div class="home-hero__grid">
        <div class="home-hero__copy">
          <h1>Decision support for consequential work, built to sit beside the AI you already use.</h1>
          <p class="v-lead">Frame gives ChatGPT, Claude or Gemini a disciplined process for one consequential decision. It makes the model ask before it answers, separate evidence from assumption and expose the weak point before confidence hardens.</p>
          <p class="home-hero__delivery"><strong>Available now:</strong> {offer.free.oneLine} {offer.free.boundary}</p>
          <div class="v-actions">
            <a class="v-btn v-btn--green" href="#get-free">Get the Frame Free beta</a>
            <a class="v-btn" href={withBase('/product/#brief')}>See a Decision Brief</a>
          </div>
        </div>
        <figure class="home-hero__visual">
          <picture>
            <source srcset={withBase('/assets/frame-decision-path.avif')} type="image/avif" />
            <img
              src={withBase('/assets/frame-decision-path.webp')}
              width="960"
              height="1440"
              alt="Abstract paper pathways converging on a green square frame."
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </div>
  </section>

  <section class="v-section v-section--rule" id="when">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>For the decisions where a fluent answer is not enough.</h2>
        <p>Frame is for professionals who already use a capable model and know that a confident paragraph is not the same as a defensible recommendation. It adds the discipline a senior reviewer would apply, in the session, before anything reaches a committee.</p>
      </div>
      <dl class="d-meta home-when">
        {useWhen.map((row) => (
          <div><dt>{row.when}</dt><dd>{row.why}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="v-section v-section--rule" id="method">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Six steps, run in order, on one decision.</h2>
        <p>Frame Free covers the first three moves and stops there. Compare, Decide and Execute belong to Frame Pro, which is in development. The path adapts to the answers; the order does not.</p>
      </div>
      <ol class="d-list d-list--indexed home-method">
        {method.map(([name, text, plan], i) => (
          <li><span class="d-list__index">{String(i + 1).padStart(2, '0')}</span><div><h3>{name}</h3><p>{text}</p><p class="method-plan">{plan === 'free' ? 'Frame Free' : 'Frame Pro, in development'}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v-section v-section--rule" id="anatomy">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>Every material claim carries its evidence class.</h2>
        <p>The four classes are the reading aid a reviewer uses to find the weak point. From the {briefExcerpt.case} brief, quoted:</p>
      </div>
      <ul class="home-anatomy">
        {briefExcerpt.evidence.map((row) => (
          <li><span class={`d-tag d-tag--${row.tag}`}>{row.tag}</span><p>{row.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v-section v-section--rule" id="evidence">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>The research, and its limits.</h2>
        <p>A {g.runs_total}-run preregistered benchmark across two models and three fictional cases, scored on {spell(cmp.total)} checks, with every count, all {nDev} protocol deviations and all {nLim} limitations published.</p>
        <a class="v-link" href={withBase('/research/')}>Read the research overview</a>
      </div>
      <div class="d-panel home-evidence">
        <dl class="d-meta">
          <div><dt>Supported</dt><dd>Under the tested conditions the loaded method changed how the model worked: it asked before answering, compared real options including doing nothing, and tagged its evidence on every run.</dd></div>
          <div><dt>Not supported</dt><dd>Better judgement. On the three judgement checks the informed baseline matched or exceeded the loaded method: {c6.armB.met} of {c6.armB.n} against {c6.armC.met} of {c6.armC.n} on surfacing the hidden decision, {c7.armB.met} of {c7.armB.n} against {c7.armC.met} of {c7.armC.n} on direction, and {c8.armB.met} of {c8.armB.n} against {c8.armC.met} of {c8.armC.n} on catching the planted bias.</dd></div>
          <div><dt>Boundary</dt><dd>The study tested a method file that predates Frame. It is not a test of Frame Free or Frame Pro. Record current as at {d.currentAsAt}.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="v-section v-section--rule" id="people">
    <div class="v-container v-cols">
      <div class="v-cols__head">
        <h2>{people.heading}</h2>
        <p>{people.lines[0]}</p>
        <a class="v-link" href={withBase('/about/')}>Who is accountable, and how to check</a>
      </div>
      <dl class="d-meta">
        {people.verify.map((row) => (
          <div><dt>{row.label}</dt><dd>{row.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="v-section v-section--rule" id="offer">
    <div class="v-container">
      <div class="home-offer__head">
        <h2>Frame Free is the only plan today.</h2>
      </div>
      <div>
        <PlanComparison compact />
        <a class="v-link home-offer__link" href={withBase('/free/')}>What you receive, and how to run it</a>
      </div>
    </div>
  </section>

  <Signup />
</BaseLayoutV2>

<style>
  .home-hero { padding-bottom: var(--v-10); }
  .home-hero__grid { display: grid; grid-template-columns: minmax(0, 6.5fr) minmax(20rem, 5.5fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .home-hero__grid > * { min-width: 0; }
  .home-hero__copy h1 { max-width: 15ch; font-size: clamp(2.4rem, 1.4rem + 3.2vw, 4rem); line-height: 1.02; letter-spacing: -0.02em; }
  .home-hero__copy .v-lead { max-width: 52ch; }
  .home-hero__visual { margin: 0; border: 1px solid var(--v-line); overflow: hidden; background: #eee8dc; }
  .home-hero__visual picture,
  .home-hero__visual img { display: block; width: 100%; }
  .home-hero__visual img { height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  @media (max-width: 1000px) {
    .home-hero__grid { grid-template-columns: 1fr; }
    .home-hero__visual { width: min(100%, 40rem); margin-top: var(--v-4); }
  }
  .home-hero__delivery { margin-top: var(--v-5); font-size: var(--vs-small); color: var(--v-ink); max-width: 58ch; padding-left: var(--v-4); border-left: 1px solid var(--v-ink); }
  .home-when > div { grid-template-columns: minmax(12rem, 0.9fr) 1.1fr; }
  .home-when dt { font-size: var(--vs-small); font-weight: 600; color: var(--v-ink); }
  .home-method h3 { font-size: 1.0625rem; }
  .home-method p { color: var(--v-ink-soft); }
  .home-anatomy { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--v-line); }
  .home-anatomy li { display: grid; grid-template-columns: 6rem 1fr; gap: var(--v-4); padding: 14px 0; border-bottom: 1px solid var(--v-line); }
  .home-anatomy p { margin: 0; font-size: var(--vs-small); }
  .home-evidence { padding: var(--v-2) var(--v-5); }
  .home-offer__link { display: inline-block; margin-top: var(--v-4); }
  .home-offer__head { max-width: 54ch; margin-bottom: var(--v-6); }
  @media (max-width: 800px) {
    .home-when > div { grid-template-columns: 1fr; }
    .home-anatomy li { grid-template-columns: 1fr; gap: var(--v-1); }
  }
</style>
