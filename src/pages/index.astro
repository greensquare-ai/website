---
import { withBase } from '../lib/paths';
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';
---
<BaseLayoutV2
  title="GreenSquare AI | Turn capable AI into a disciplined strategy partner"
  description="GreenSquare gives Claude, ChatGPT and Gemini a disciplined strategy process for consequential business decisions, from the questions that matter to a defensible recommendation."
  current="home"
>
  <section class="hero-split-section v-off hero">
    <div class="v-container hero-split__grid">
      <div class="hero-split__text v-reveal">
        <h1 class="v-display">Turn capable AI into a disciplined strategy partner.</h1>
        <p class="v-lead" style="margin-top: var(--v-6);">
          GreenSquare gives the AI account you already use a rigorous process for consequential business
          decisions. It asks before advising, challenges the framing, compares credible options and produces a
          recommendation that can be traced back to the evidence.
        </p>
        <p class="v-small hero-audience">
          Built for strategy, finance and operating leaders whose work must withstand a steering committee,
          investment committee or executive team.
        </p>
        <div class="hero-actions">
          <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Decision Frame</a>
          <a class="v-btn v-btn--grey" href={withBase('/benchmark/')}>Read the benchmark</a>
        </div>
      </div>
    </div>
    <div class="hero-split__media v-reveal d1">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={withBase('/assets/hero-poster.jpg')}
        src={withBase('/assets/hero-loop.mp4')}
        aria-hidden="true"
        disablepictureinpicture
      ></video>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <p class="v-quote v-reveal">The model provides the intelligence. GreenSquare provides the discipline around it.</p>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2" style="max-width: 24ch;">What disciplined strategy work requires.</h2>
      <div class="v-caplist">
        <div class="v-caprow v-reveal">
          <span class="v-index">Interrogate</span>
          <h3>Ask the questions that change the call</h3>
          <p class="v-small v-cap-body">
            The Decision asks for missing facts before offering advice, checks whether the stated question is
            the real decision and makes contradictions visible.
          </p>
        </div>
        <div class="v-caprow v-reveal d1">
          <span class="v-index">Challenge</span>
          <h3>Compare credible options and trade-offs</h3>
          <p class="v-small v-cap-body">
            It develops genuine alternatives, including keeping the current position, then compares them against
            criteria fixed before the preferred answer is known.
          </p>
        </div>
        <div class="v-caprow v-reveal d2">
          <span class="v-index">Defend</span>
          <h3>Make the recommendation inspectable</h3>
          <p class="v-small v-cap-body">
            Every material claim is marked GIVEN, DERIVED, INFERRED or UNKNOWN. The final brief states the
            assumptions, the trade-offs and the conditions that would change the recommendation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green">
    <div class="v-container v-split is-reverse">
      <div class="v-reveal">
        <h2 class="v-h2">The benchmark shows process discipline. It does not yet prove better judgement.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          In a 45-run pre-registered test across two frontier models and three business cases, The Decision
          consistently asked before advising, compared real options and tagged its evidence. The cases, protocol,
          scoring rubric and every departure from the plan are published so the result can be scrutinised.
        </p>
        <a class="v-link" href={withBase('/benchmark/')} style="display:inline-block; margin-top: var(--v-6);">See what the benchmark proves — and what it does not</a>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> What is published</div>
          <div class="v-readout__body">
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Pre-registration</span><span class="v-run__val"><b>Hashed</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Cases and rubric</span><span class="v-run__val"><b>Public</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Deviations</span><span class="v-run__val"><b>Published</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Transcripts</span><span class="v-run__val">Withheld</span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">Results</span><span class="v-run__val">See benchmark</span></div></div>
          </div>
          <div class="v-readout__foot">One evidence record / results and limitations on the benchmark page</div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-next v-fill-2" aria-label="Get started">
    <div class="v-container home-next__inner">
      <div class="home-next__copy v-reveal">
        <h2 class="v-h2">Start with the decision beneath the question.</h2>
        <p class="v-lead">
          Use the free Decision Frame to name the real choice, surface the assumption carrying the most risk and
          separate evidence from interpretation in about ten minutes.
        </p>
      </div>
      <div class="home-next__action v-reveal d1">
        <EmailCaptureForm client:visible buttonLabel="Email me the Decision Frame" />
        <a class="v-link home-next__benchmark" href={withBase('/benchmark/')}>Review the evidence and limitations</a>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  /* Full-bleed split-screen hero: text left (aligned to page gutter), video right (bleeds to edge). */
  .hero-split-section {
    position: relative;
    min-height: clamp(480px, 62vh, 680px);
    display: flex;             /* stretch the container to full band height */
    overflow: hidden;          /* clip the bleeding video */
  }
  .hero-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;   /* divider sits at container centre = screen centre */
    align-items: center;              /* vertically centre the text */
    width: 100%;
  }
  .hero-split__text {
    grid-column: 1;                   /* text occupies the left half only */
    max-width: 34rem;
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vh, 4rem);
    position: relative;
    z-index: 1;
  }
  .hero-audience { margin-top: var(--v-5); max-width: 52ch; }
  .hero-actions { display: flex; gap: var(--v-4); align-items: center; flex-wrap: wrap; margin-top: var(--v-8); }
  .hero-split__media {
    position: absolute; top: 0; bottom: 0;
    left: 50%;                        /* meets the text column's right edge exactly */
    right: 0;                         /* full-bleed to the right viewport edge */
  }
  .hero-split__media::before {        /* Palantir-style hairline at the split */
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 1px;
    background: var(--v-line); z-index: 1;
  }
  .hero-video {
    display: block; width: 100%; height: 100%;
    object-fit: cover; border-radius: 0; box-shadow: none;
  }
  @media (max-width: 900px) {
    .hero-split-section { min-height: 0; display: block; }
    .hero-split__grid { grid-template-columns: 1fr; }
    .hero-split__media { position: static; }
    .hero-split__media::before { display: none; }
    .hero-video { aspect-ratio: 16 / 9; height: auto; border-top: 2px solid var(--v-ink); }
  }
  .home-next { padding-block: clamp(4.5rem, 8vw, 6.5rem); }
  .home-next__inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(25rem, 1.1fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .home-next__copy { max-width: 40rem; }
  .home-next__copy .v-lead { max-width: 48ch; margin-top: var(--v-4); color: var(--v-ink-soft); }
  .home-next__action { width: min(100%, 35rem); justify-self: end; }
  .home-next__benchmark { display: inline-block; margin-top: var(--v-4); color: var(--v-green); }
  @media (max-width: 900px) {
    .home-next__inner { grid-template-columns: 1fr; gap: var(--v-8); }
    .home-next__action { justify-self: start; }
  }
</style>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  if (heroVideo && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroVideo.pause();
    heroVideo.removeAttribute('autoplay');
  }
</script>
