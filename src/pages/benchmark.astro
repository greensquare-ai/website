  .bm-artifacts a:hover strong { text-decoration: underline; text-underline-offset: 3px; }
  .bm-artifacts strong, .bm-artifacts small { display: block; }
  .bm-artifacts small { margin-top: .2rem; color: var(--v-ink-soft); }
  .bm-artifacts a > span:last-child { color: var(--v-green); font-size: var(--vs-small); font-weight: 600; }
  .bm-disclosure { border-top: 1px solid var(--v-ink); border-bottom: 1px solid var(--v-ink); }
  .bm-disclosure + .bm-disclosure { border-top: 0; }
  .bm-disclosure summary { padding: var(--v-4) 2rem var(--v-4) 0; font-weight: 600; cursor: pointer; }
  .bm-disclosure__body { padding: var(--v-2) 0 var(--v-6); }
  .bm-hash, .bm-departures p { overflow-wrap: anywhere; }
  .bm-hash { font-size: .88em; font-variant-numeric: tabular-nums; }
  .bm-notes { display: grid; gap: var(--v-3); }
  .bm-departures { list-style: none; padding: 0; margin: 0; }
  .bm-departures li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--v-4); border-top: 1px solid var(--v-line); padding: var(--v-5) 0; }
  .bm-departures li:last-child { border-bottom: 1px solid var(--v-line); }
  .bm-departures li > * { min-width: 0; }
  /* Eighteen items in one vertical run is roughly three viewports, and scroll
     length is what converts candour into posture. Two columns at desktop, at a
     weight below every other h3 on the page. */
  .v2 .bm-departures h3 { margin-bottom: var(--v-2); font-family: var(--vf-body); font-size: var(--vs-h4); font-weight: 600; line-height: 1.35; }
  @media (min-width: 900px) {
    .bm-departures { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--v-8); }
  }

  /* ---------- S8 ---------- */
  .bm-splitcta { margin-block: var(--v-10); }

  @media (max-width: 900px) {
    .bm-band { padding-block: var(--v-8); }
