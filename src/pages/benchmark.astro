---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import EmailCaptureForm from '../components/EmailCaptureForm.tsx';
import CheckComparisonChart from '../components/benchmark/CheckComparisonChart.astro';
import ResultPromptTabs from '../components/benchmark/ResultPromptTabs.astro';
import { withBase } from '../lib/paths';
import {
  grid, checks, check, composite, goCase, directionByCase, dates, refresh,
  prereg, parity, deviations, cleanItems, limitations, fmt, isDefinitional,
  sealedKey, hashedInputs, transcripts, armLabels, spell, ARMS, armBvsArmC,
} from '../lib/benchmark';
import { demo, demoProvenance, demoRunDate, demoExchange, demoDifferences, demoBriefHtml } from '../lib/demo';
import { compiledContent } from '../data/demonstrations/demo-1.md';

const g = grid();
const d = dates();
const r = refresh();
const p = prereg();
const comp = composite();
const gc = goCase();
const dbc = directionByCase();
const sk = sealedKey();
const hi = hashedInputs();
const tx = transcripts();
const inv = tx.inventory;
const arms = armLabels();

const openai = r.legs.find((leg) => leg.vendor === 'OpenAI')!;
const anthropic = r.legs.find((leg) => leg.vendor === 'Anthropic')!;
const c1 = check('c1');
const c2 = check('c2');
const c3 = check('c3');
const c6 = check('c6');
const c7 = check('c7');
const c8 = check('c8');
const caseSizes = g.cases.map((businessCase) => businessCase.n_per_arm);
/* The check-by-check tally, derived rather than written down, so the sentence cannot
   drift from the grid. Splitting measured from definitional keeps the page from
   counting a cell the baseline cannot pass as a cell the file won. */
const bvc = armBvsArmC();

/* Figure 1. Every coordinate the chart draws is derived from these, which are
   derived from the accessors, so no count is written here or in the component. */
const chartRow = (result: ReturnType<typeof check>) => ({
  id: result.id,
  label: result.page_label,
  baseline: { met: result.armB.met, text: fmt(result.armB).text, pct: fmt(result.armB).pct },
  loaded: { met: result.armC.met, text: fmt(result.armC).text, pct: fmt(result.armC).pct },
  baselineDefinitional: isDefinitional(result, 'armB') === 'full',
});

/* Figure 3, the demonstration. The brief is the file's own markdown, rendered
   through Astro's markdown pipeline and split at the file's own heading, so the
   panel cannot drift from the transcript demo.ts guards. */
const demoHtml = await compiledContent();
const briefHtml = demoBriefHtml(demoHtml, 'd1');
const exchange = demoExchange();
const differences = demoDifferences();
const dm = demo();
const demoRun = demoRunDate();

const stages = [
  { n: 1, name: 'Ask', body: 'The model asks three to six focused questions before offering advice. The depth of the interrogation scales with the stakes.' },
  { n: 2, name: 'Frame', body: 'It tests whether the stated question is the real decision and identifies choices that have been treated as fixed too early.' },
  { n: 3, name: 'Confirm', body: 'It plays the situation back in a few lines, then asks you to resolve contradictions, missing evidence and untested assumptions.' },
  { n: 4, name: 'Compare', body: 'It develops credible alternatives, including keeping the current position, and compares them against explicit criteria.' },
  { n: 5, name: 'Recommend', body: 'It produces a five-part Decision Brief and checks whether the call follows from the evidence before handing it to you.' },
];

const briefParts = [
  'The decision and why it matters now',
  'The Options compared',
  'The recommendation',
  'The next actions',
  'The Assumptions and reversal conditions',
];

const businessCases = [
  {
    code: 'A',
    name: 'Meridian',
    decision: 'Structure a major contract bid',
    hidden: 'Decide whether to accept the concentration, regulatory dependency and non-redeployable investment at all.',
    type: 'Reversal case',
  },
  {
    code: 'B',
    name: 'Larkfield',
    decision: 'Sequence an in-house e-commerce build',
    hidden: 'Decide whether to pursue a live acquisition before the eight-week window closes.',
    type: 'Go case',
  },
  {
    code: 'C',
    name: 'Corvan',
    decision: 'Fund the next phase of a venture',
    hidden: 'Decide whether to exit and redeploy capital into the under-invested core business.',
    type: 'Exit and reallocate case',
  },
];

const artefacts = [
  { title: 'Case A, Meridian', sub: 'The frozen prompt and fact sheet.', path: 'evidence/preregistration/v3/cases/case-A-anchor-client.md' },
  { title: 'Case B, Larkfield', sub: 'The go case, and the case where Compass adds least.', path: 'evidence/preregistration/v3/cases/case-B-go-case.md' },
  { title: 'Case C, Corvan', sub: 'Adapted from a documented Australian post-mortem.', path: 'evidence/preregistration/v3/cases/case-C-disguised-real.md' },
  { title: 'Test protocol', sub: 'Conditions, answering rule, target grid and scoring procedure.', path: 'evidence/preregistration/v3/protocol.md' },
  { title: 'Scoring rubric', sub: 'The pass criteria for all eight checks.', path: 'evidence/preregistration/v3/rubric-operationalisations.md' },
  { title: 'Pre-registration record', sub: 'The hashes and the record\'s edit history.', path: 'evidence/preregistration/v3/PREREGISTRATION.md' },
];

const limitationLeads = [
  'No realistic operator.',
  'One person throughout.',
  'Definitional cells.',
  'Mandated behaviours.',
  'Unequal fact sheets.',
  'Small, unbalanced grid.',
  'Inventory now reconciled.',
  'One fixed file.',
];
---

<BaseLayoutV2
  title="Compass | GreenSquare AI"
  description={`Compass is a plain markdown file that interrogates before it advises. A ${g.runs_total}-run pre-registered study of what it changed, and what it did not.`}
  current="benchmark"
>
<div class="bm-page">

<!-- S1 · Hero, what it is -->
<section class="v-section v-off bm-hero">
  <div class="v-container">
    <div class="v-split is-top">
      <div>
        <h1 class="v-display bm-hero__title">Compass is an instruction file that interrogates before it advises.</h1>
        <p class="v-lead bm-s6">
          Compass is a plain markdown file. You load it into Claude, ChatGPT or Gemini, describe one
          consequential business decision in your own words, and the model interrogates you before it
          advises. What it produces is the Decision Brief, clean markdown you can edit, challenge or
          move into your own document.
        </p>
        <p class="v-small bm-s5 bm-hero__note">
          Open a new chat, paste or upload Compass, then describe the choice in your own words. The
          process runs inside the AI account and workplace policy you already use. Compass is not yet
          on sale and the launch edition is in preparation. The only thing available from this page
          today is Lens, the free one-page worksheet.
        </p>
        <div class="hero-actions bm-s8">
          <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Lens worksheet</a>
          <a class="v-btn v-btn--grey" href="#result">Read the result</a>
        </div>
      </div>
      <div class="v-readout">
        <div class="v-readout__bar"><span class="v-readout__dot"></span> The Compass workflow</div>
        <div class="v-readout__body">
          <ul class="v-spec__list">
            {stages.map((stage) => <li><span class="n">{stage.n}</span> {stage.name}</li>)}
          </ul>
        </div>
        <div class="v-readout__foot">Compass is the file / the Decision Brief is what it produces / Lens is the free worksheet</div>
      </div>
    </div>
  </div>
</section>

<!-- S2 · The result and the anti-claim -->
<section class="v-section bm-s2" id="result">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2 bm-claim">Compass changed the process on every loaded run. It did not beat an informed baseline on judgement.</h2>
    <p class="v-lead bm-s5">
      On the two pre-registered judgement checks, the informed baseline came out one run ahead on one
      and level on the other. It surfaced the hidden decision in {fmt(c6.armB).text} runs against
      Compass at {fmt(c6.armC).text}, and both matched the sealed direction in {fmt(c7.armB).text}.
      n is {g.n_per_arm} per condition, pooled across {spell(g.models.length)} models and
      {spell(g.cases.length)} cases.
    </p>

    <CheckComparisonChart
      class="bm-s10"
      id="fig1"
      title="The informed baseline matched or exceeded Compass on judgement. Compass separated on process."
      svgTitle={`Eight pre-registered checks, the informed baseline compared with Compass, counts out of ${g.n_per_arm} runs per condition.`}
      perArm={g.n_per_arm}
      unit="runs"
      baseline={{ name: arms[1].label, keyLabel: `${arms[1].label}, the informed baseline`, columnHead: arms[1].label }}
      loaded={{ name: arms[2].label, keyLabel: arms[2].label, columnHead: 'Compass' }}
      judgement={checks('judgment').map(chartRow)}
      process={checks('process').map(chartRow)}
      scaleNote={`The track runs from zero on the left to ${g.n_per_arm} runs on the right.`}
      definitionalPhrase="fixed by the single-turn test design"
    >
      <Fragment slot="basis">
        Read the judgement rows first. On {c7.page_label} and {c8.page_label} the two conditions land
        on the same mark, and on {c6.page_label} the informed baseline is one run ahead. The process
        rows separate, and those are behaviours Compass instructs the model to perform, so they are
        evidence the file was followed rather than evidence the model reasoned better. “Def” marks a
        cell fixed by the test design: a single-turn condition cannot ask before answering. The
        question-only condition is not plotted here and appears in the full grid below. Counts out of
        {g.n_per_arm} per condition / pooled across {g.models.length} models and {g.cases.length} cases
        / scored {d.scoredOn} / adjudicated {d.adjudicatedOn} / pre-registered at commit {p.short}
      </Fragment>
    </CheckComparisonChart>

    <p class="v-small bm-s8">
      Counted across all {spell(bvc.total)} checks: the two conditions tied on {spell(bvc.tied.length)},
      the informed baseline was higher on {spell(bvc.baselineHigher.length)}, and Compass was higher on
      {spell(bvc.loadedHigherMeasured.length)} measured checks. A further
      {spell(bvc.loadedHigherDefinitional.length)} is not a result, because a single-turn condition
      cannot ask before answering. One check is flat across all three conditions and separates nothing.
    </p>

    <dl class="bm-status bm-s10">
      <div><dt>Runs</dt><dd>{g.runs_total}</dd></div>
      <div><dt>Conditions</dt><dd>{arms.length}</dd></div>
      <div><dt>Cases</dt><dd>{g.cases.length}</dd></div>
      <div><dt>Models run</dt><dd>{g.models.length}</dd></div>
      <div><dt>Scored</dt><dd>{d.scoredOn}</dd></div>
      <div><dt>Adjudicated</dt><dd>{d.adjudicatedOn}</dd></div>
    </dl>

    <p class="v-small bm-s5">
      Both tested models have since been superseded and no re-run has been published, so these results
      should be read as historical. The product was renamed on 30 August 2026, after the study was run
      and scored: the arm labelled Compass throughout this page is the arm that was tested under its
      former name.
    </p>
  </div>

  <div class="v-green bm-band">
    <div class="v-container v-container--narrow">
      <h3 class="v-h3">What the evidence supports, and where it stops.</h3>
      <div class="bm-boundary bm-s6">
        <div>
          <p class="bm-boundary__label">Supported</p>
          <p>Compass caused the models to ask before advising, compare real Options and tag the basis of material claims. It produced that structured process in every loaded run.</p>
        </div>
        <div>
          <p class="bm-boundary__label">Not established</p>
          <p>The study does not show better judgement than an informed operator, better real-world decisions, or an effect that a capable operator could not reproduce with their own instructions.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S3 · See it run -->
<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">See the file work, then read the transcript it came from.</h2>
    <p class="v-lead bm-s5">
      No transcript from the study is published. What follows is a single demonstration run on a fresh
      case, shown as the brief it produced and the exchange it came from, so the product can be read
      rather than only counted.
    </p>
    <p class="v-small bm-s5">{tx.withdrawn_note}</p>

    <ResultPromptTabs
      class="bm-s10"
      id="d1"
      title="Compass reframed the decision it was handed, obtained one buried fact by asking for it, and generated an option the operator had not put on the table."
      provenance={demoProvenance()}
      transcriptTitle="Transcript, verbatim and unedited"
      transcriptLabel="Demonstration transcript"
    >
      <Fragment slot="result" set:html={briefHtml} />
      <Fragment slot="prompt">{exchange}</Fragment>
      <Fragment slot="basis">
        Read the brief first, then the exchange it came from. The run reframed the stated question,
        obtained one fact the operator had not volunteered, generated an option the operator had not
        considered, tagged the basis of its material claims, and reached a recommendation whose
        direction follows that evidence. It does not show the run finding the whole of the case's
        hidden decision, and it is not evidence of anything the study measured: one run, on a
        fictional case, not scored, not adjudicated, with no sealed key and no baseline to compare
        against. It differs from a buyer's own use in three ways. {differences.join(' ')}
        {spell(dm.attemptsBefore + 1)} attempts were made and this is the only one published. The
        rest were abandoned for a fault in the way the run was orchestrated rather than a fault in
        the file, and no content from them was carried forward. Demonstration / model {dm.model} /
        run {demoRun} / {dm.productFile}, asserted at build to hash to the value published below
        / not part of the pre-registered study
      </Fragment>
      <Fragment slot="defect">
        <strong>One tagging error in this run, found on review and left in place.</strong> In the
        options table, the evidence column for option A reads "Integrator attestation, assessed by
        nobody independent of the integrator", tagged given. The operator did not say that. They
        said they did not know who assesses the attestation independently of the integrator. Under
        the scheme Compass is applying, an absence of knowledge is unknown, not given, so the tag is
        wrong and the claim is stronger than the answer it rests on. It is the same class of error
        that withdrew one of the two excerpts previously shown here, which is why it is named rather
        than quietly corrected. State the base rate plainly rather than leave it to be counted: of
        the three transcripts of this feature ever published on this page, two are now known to
        carry a tagging error, and this is one of them. The transcript is published unedited and
        this note sits beside it.
      </Fragment>
    </ResultPromptTabs>
  </div>
</section>

<!-- S4 · What the discipline buys -->
<section class="v-section">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">The informed baseline needed the full fact sheet. Compass started from the question.</h2>
    <p class="v-lead bm-s5">
      What the file changes is the input it can start from. The informed baseline reaches its results
      from a complete fact sheet handed to it in the first message. Compass reaches them from the
      short executive question, by asking.
    </p>
  </div>

  <div class="v-container">
    <div class="v-caplist">
      {stages.map((stage) => (
        <div class="v-caprow">
          <span class="v-index">Step {stage.n}</span>
          <h3>{stage.name}</h3>
          <p class="v-small v-cap-body">{stage.body}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="v-container v-container--narrow">
    <div class="v-readout bm-s10">
      <div class="v-readout__bar"><span class="v-readout__dot"></span> Decision Brief structure</div>
      <div class="v-readout__body">
        <ul class="v-spec__list">
          {briefParts.map((part, index) => <li><span class="n">{index + 1}</span> {part}</li>)}
        </ul>
        <div class="bm-tags">
          <span class="v-tag">GIVEN</span><span class="v-tag">DERIVED</span><span class="v-tag">INFERRED</span><span class="v-tag">UNKNOWN</span>
        </div>
      </div>
    </div>

    <figure class="bm-fig bm-fig--meter bm-s10">
      <h3 class="bm-fig__title bm-fig__title--sm">
        A derived process figure, not a result: starting from the short question, Compass produced a
        brief with its Options, evidence tags and change criteria attached on every run, and the
        informed baseline, holding every fact, produced none. This is not the study's headline, and
        leading with it as though it were is the departure this page ranks first.
      </h3>
      <div class="v-readout bm-s5">
        <div class="v-readout__bar"><span class="v-readout__dot"></span> {comp.label}</div>
        <div class="v-readout__body">
          {ARMS.map((arm, index) => (
            <div class="v-run">
              <div class="v-run__head">
                <span class="v-run__name">{arms[index].label}</span>
                <span class="v-run__val"><b>{fmt(comp[arm]).text}</b></span>
              </div>
              <div class="v-meter"><span class="v-meter__fill" style={`--w: ${fmt(comp[arm]).pct}%`}></span></div>
            </div>
          ))}
        </div>
        <div class="v-readout__foot">{comp.provenance}</div>
      </div>
      <p class="bm-fig__basis">
        This is a derived composite, not a ninth result. Recomputed without the asking-first check the
        counts do not move: {comp.recomputed_note} Counts out of {g.n_per_arm} per condition / pooled
        across {g.models.length} models and {g.cases.length} cases / scored {d.scoredOn} / adjudicated
        {' '}{d.adjudicatedOn}
      </p>
    </figure>

    <ol class="bm-pairs bm-s10">
      {[c2, c3].map((result) => (
        <li>
          <p class="bm-pairs__name">{result.page_label}</p>
          <p class="bm-pairs__vals">
            <span>{arms[1].label} <b>{fmt(result.armB).text}</b></span>
            <span>{arms[2].label} <b>{fmt(result.armC).text}</b></span>
          </p>
          {result.caveat && <p class="bm-pairs__note">{result.caveat}</p>}
        </li>
      ))}
      <li>
        <p class="bm-pairs__name">{c1.page_label}</p>
        <p class="bm-pairs__vals">
          <span>{arms[1].label} <b>{fmt(c1.armB).text} def</b></span>
          <span>{arms[2].label} <b>{fmt(c1.armC).text}</b></span>
        </p>
        <p class="bm-pairs__note">{c1.definitional_note}</p>
      </li>
    </ol>

    <p class="bm-s6">
      These three are behaviours the file instructs the model to perform. They are evidence the file
      was followed, not evidence the model reasoned better. The study also did not run the obvious
      fourth condition, a capable operator writing equivalent instructions of their own, so nothing
      here separates Compass from that operator either.
    </p>

    <ul class="v-leadlist bm-s6">
      <li>Tested: one consequential business decision at a time, on {spell(g.cases.length)} fictional cases, a managed-service bid, a build-versus-buy sequencing call and a continue-versus-exit call on a venture. All three case files are published in full and linked below.</li>
      <li>Not tested: any decision outside those three shapes, any operator who holds most of the facts and one blind spot they cannot see, and any comparison against a capable operator writing their own instructions.</li>
    </ul>
  </div>
</section>

<!-- S5 · How the test worked -->
<section class="v-section v-off">
  <div class="v-container">
    <div class="bm-section-head">
      <h2 class="v-h2">Three conditions separated missing information from process discipline.</h2>
      <div>
        <p class="v-lead">A public business case may already appear in model training data, commentary or search results. That can build the answer into the test.</p>
        <p class="bm-s4">GreenSquare therefore created {spell(g.cases.length)} fictional cases whose material facts existed only in the frozen fact sheets. Each case began with a plausible but incomplete executive question. The facts that changed the decision were separated across the case so the model had to connect them.</p>
        <p class="v-small bm-s4">Important caveat. The fictional cases kept the answer key out of retrieval, and they did not keep every run clean. ChatGPT invoked live web search unprompted during six question-only runs on Case B. Both halves of that are true and the first is not usable without the second.</p>
      </div>
    </div>
  </div>

  <div class="v-container v-container--narrow">
    <ol class="bm-arms bm-s8">
      {arms.map((arm, index) => (
        <li>
          <span class="v-index">/{String.fromCharCode(65 + index)}</span>
          <div>
            <h3>{arm.label}</h3>
            <p>{arm.note}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="bm-method-note bm-s6">
      <h3>Why the informed baseline matters</h3>
      <p>{parity().statement}</p>
      <p class="v-small">The operator's answering rule was fixed before the runs. Off-sheet questions received the same reply every time: “That has not been assessed.” Source: {parity().source}, frozen at commit {p.short}.</p>
    </div>
  </div>

  <div class="v-container">
    <ol class="bm-cases" aria-label="The three fictional decision cases">
      {businessCases.map((businessCase) => (
        <li>
          <span class="v-index">/{businessCase.code}</span>
          <div>
            <p class="bm-case__meta">{businessCase.name} / {businessCase.type}</p>
            <h3>{businessCase.decision}</h3>
          </div>
          <p><strong>The decision beneath it.</strong> {businessCase.hidden}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="v-container v-container--narrow">
    <h3 class="v-h3 bm-s10">Recommendation direction, split by case</h3>
    <p class="bm-s5">{dbc.note} Across Cases A and C, all three conditions matched the sealed direction in {fmt(dbc.cases_A_and_C.armA).text} runs. The whole measured deficit sits in Case B, where six ChatGPT question-only runs invoked live search.</p>

    <p class="v-small bm-scrollhint" aria-hidden="true">Scroll the table sideways to compare all three conditions.</p>
    <div class="bm-table-wrap" role="region" aria-label="Recommendation direction by case and condition" tabindex="0">
      <table class="v-table bm-table">
        <thead><tr><th scope="col">Case split</th>{arms.map((arm) => <th scope="col" class="num">{arm.label}</th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">Cases A and C</th><td class="num">{fmt(dbc.cases_A_and_C.armA).text}</td><td class="num">{fmt(dbc.cases_A_and_C.armB).text}</td><td class="num">{fmt(dbc.cases_A_and_C.armC).text}</td></tr>
          <tr><th scope="row">Case B, Larkfield</th><td class="num">{fmt(dbc.case_B.armA).text}</td><td class="num">{fmt(dbc.case_B.armB).text}</td><td class="num">{fmt(dbc.case_B.armC).text}</td></tr>
        </tbody>
      </table>
    </div>

    <p class="v-small bm-s5">{dbc.reading}</p>
    <p class="v-small bm-s4">Case B is also the case where the file adds least, which the protocol required to be identified and which was not identified until now. With every fact supplied, the informed baseline and Compass matched the sealed direction in {fmt(gc.armB).text} runs each, on both models. That is one case, n of {gc.armB.n} per condition, and the generalisation is weak in both directions.</p>

    <h3 class="v-h3 bm-s10">The protocol was public before the scored grid</h3>
    <p class="bm-s5">The cases, answering rule, model plan, repeat counts, scoring rubric and sealed answer-key hash were committed to a public repository before the scored runs. This limits the scope for changing the test after seeing the result.</p>
    <p>It does not make the execution independent or fully reproducible. The public record later departed from the protocol in {deviations().length} places. Every departure is listed below.</p>
  </div>
</section>

<!-- S6 · The limits -->
<section class="v-section v-green">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">This benchmark does not yet answer the real-world question.</h2>
    <p class="v-lead bm-s5">The missing condition is the one the product exists for: a capable operator who holds most of the relevant facts but has a blind spot they cannot see. That condition was not run.</p>

    <div class="bm-limit-lead bm-s6">
      <p>Two comparisons still matter. The next study needs a realistic operator condition, and a condition in which a competent operator writes equivalent instructions without Compass. Until then, this study cannot establish whether the product improves real work, or whether it does anything the operator could not reproduce.</p>
    </div>

    <ul class="v-leadlist bm-limitations bm-s6">
      {limitations().map((limitation, index) => <li><strong>{limitationLeads[index]}</strong> {limitation}</li>)}
    </ul>

    <h3 class="v-h3 bm-s10">The refresh commitment has lapsed</h3>
    <p class="bm-s5">The grid was scored against {g.models[0].name} and {g.models[1].name}. Both have since been superseded, and both {r.commitmentDays}-day re-run windows have expired. No re-run date is published.</p>
    <p class="v-small">OpenAI. {openai.tested_model} was superseded by {openai.superseded_by} on {openai.releasedOn}. The re-run was {openai.daysPastDue} days past due as at {d.currentAsAt}. Source strength: {openai.source_strength}. {openai.caveat}</p>
    <p class="v-small">Anthropic. {anthropic.tested_model} was superseded by {anthropic.superseded_by} on {anthropic.releasedOn}. The re-run was {anthropic.daysPastDue} days past due as at {d.currentAsAt}. Source strength: {anthropic.source_strength}. {anthropic.caveat}</p>
  </div>
</section>

<!-- S7 · The study record -->
<section class="v-section">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">The inputs are public. The scores cannot yet be reproduced independently.</h2>
    <p class="v-lead bm-s5">
      The result is presented first so the study can be read before it is challenged. The
      {' '}{deviations().length} departures from the protocol sit here, below the result, rather than
      at the top. They are listed in full and ranked by how much damage each does when someone hostile
      finds it. None is softened and none is omitted.
    </p>

    <p class="bm-s6">The pre-registration commit is <code class="bm-hash">{p.full}</code>. It was authored at {p.authoredAtTime} and committed at {p.committedAtTime}. A committer timestamp is not proof of push time, and this page does not claim one.</p>

    <div class="bm-verify-grid bm-s6">
      <div>
        <h3>Can be checked</h3>
        <p>Six inputs were hashed and frozen before the first scored run. Their SHA-256 values match the files at the pre-registration commit when read with {hi.line_endings} line endings. The sealed reference answers were verified against the pre-registration table on both LF and CRLF line endings; the key was fixed before any run and has not been altered.</p>
      </div>
      <div>
        <h3>Cannot be checked</h3>
        <p>No transcript and no sealed answer key is published. All {g.runs_total} grid transcripts exist and are held; they are unpublished by decision, not absent. Nobody outside GreenSquare AI can re-score a run or confirm an adjudicated cell.</p>
      </div>
    </div>

    <h3 class="v-h3 bm-s10">The grid was smaller and less balanced than planned</h3>
    <p class="bm-s5">The final grid contains {g.runs_total} runs, {g.n_per_arm} per condition. Case A ran on ChatGPT only. Cases B and C ran on both models. The condition totals split {caseSizes.join(', ')} across cases.</p>
    <p>Nine Claude pilot runs on Case A were excluded by the protocol. A third pre-registered model, {g.planned_models[0].name}, was not run. No per-model result split is published, and every aggregate on this page should be read as an average over an unbalanced grid. The one per-model statement is Case B, where the informed baseline and Compass tied on both.</p>
    <p>The transcript directory holds {inv.grid_files} files, {inv.grid_by_case.map((c) => `${c.files} for Case ${c.case_id}`).join(', ')}, matching the published grid. The pilot directory holds {inv.pilot_files} files: the {g.excluded.pilot_runs} excluded design-phase run transcripts plus the scoring writeup for them, which states in its own opening paragraph that the pilot runs are not pooled with the pre-registered grid. The inventory reconciles. It did not when this page was first published, and the entry that said so is corrected in the limitations above.</p>
    <p>The rubric names per-case, per-condition counts as the headline unit. Two such cuts are published, Case B in full and direction split by case. The other seven checks are aggregate only.</p>

    <h3 class="v-h3 bm-s10">All eight checks</h3>
    <p class="bm-s5">Counts are out of {g.n_per_arm} per condition, pooled across the {spell(g.models.length)} models and {spell(g.cases.length)} cases. “Def” marks a cell fixed by the test design. “Part” marks a cell partly affected by it.</p>
  </div>

  <div class="v-container v-container--narrow">
    <p class="v-small bm-scrollhint" aria-hidden="true">Scroll the table sideways to compare all three conditions.</p>
  </div>
  <div class="v-container v-container--narrow">
    <div class="bm-breakout">
      <div class="bm-table-wrap" role="region" aria-label="All eight checks by condition" tabindex="0">
        <table class="v-table bm-table bm-full-grid">
          <thead><tr><th scope="col">Check</th>{arms.map((arm) => <th scope="col" class="num">{arm.label}</th>)}</tr></thead>
          <tbody>
            {checks('process').map((result) => (
              <tr>
                <th scope="row">{result.page_label}</th>
                {ARMS.map((arm) => {
                  const definition = isDefinitional(result, arm);
                  return <td class="num">{fmt(result[arm]).text}{definition === 'full' ? ' def' : definition === 'partial' ? ' part' : ''}</td>;
                })}
              </tr>
            ))}
            <tr class="bm-composite">
              <th scope="row">{comp.label}, derived<span class="v-small">{comp.provenance}</span></th>
              <td class="num">{fmt(comp.armA).text}</td><td class="num">{fmt(comp.armB).text}</td><td class="num">{fmt(comp.armC).text}</td>
            </tr>
            {checks('judgment').map((result) => (
              <tr>
                <th scope="row">{result.page_label}</th>
                {ARMS.map((arm) => {
                  const definition = isDefinitional(result, arm);
                  return <td class="num">{fmt(result[arm]).text}{definition === 'full' ? ' def' : definition === 'partial' ? ' part' : ''}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="v-container v-container--narrow">
    <p class="v-small bm-s5">This table shows full passes only. The protocol requires baseline partial counts reported prominently, per case, and the rubric describes the full versus partial distinction as the core of the benchmark. No partial count is published anywhere on this site, including here.</p>

    <h3 class="v-h3 bm-s10">The six frozen artefacts</h3>
    <ul class="bm-artifacts bm-s5">
      {artefacts.map((artefact) => (
        <li>
          <a href={p.fileUrl(artefact.path)} target="_blank" rel="noopener">
            <span><strong>{artefact.title}</strong><small>{artefact.sub}</small></span>
            <span>View</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="v-small bm-s4">Every link is pinned to commit {p.short}, not to the current branch, so a later edit cannot change what was verified.</p>

    <details class="bm-disclosure bm-s6">
      <summary>View the frozen hashes</summary>
      <div class="bm-disclosure__body">
        <p class="v-small bm-scrollhint" aria-hidden="true">Scroll the table sideways to read the full hashes.</p>
        <div class="bm-table-wrap" role="region" aria-label="The six frozen inputs and their SHA-256 values" tabindex="0">
          <table class="v-table bm-hash-table">
            <thead><tr><th scope="col">File</th><th scope="col">SHA-256</th></tr></thead>
            <tbody>{hi.files.map((file) => <tr><th scope="row"><code class="bm-hash">{file.file}</code></th><td><code class="bm-hash">{file.sha256}</code></td></tr>)}</tbody>
          </table>
        </div>
        <p class="v-small bm-s4">The product under test is <code class="bm-hash">{hi.product_file}</code>, SHA-256 <code class="bm-hash">{hi.product_sha256}</code>. {hi.product_withheld_note}</p>
        <p class="v-small bm-s4">The sealed reference answers hash to <code class="bm-hash">{sk.sha256}</code>. The key itself is not published, so this verification cannot be repeated outside GreenSquare AI.</p>
      </div>
    </details>

    <details class="bm-disclosure">
      <summary>Read the scoring and adjudication notes</summary>
      <div class="bm-disclosure__body bm-notes">
        <p class="v-small"><strong>Asked before answering.</strong> {c1.definitional_note}</p>
        <p class="v-small"><strong>Surfaced the hidden decision.</strong> {c6.definitional_note}</p>
        {checks().filter((result) => result.definitional_note && !['c1', 'c6'].includes(result.id)).map((result) => <p class="v-small"><strong>{result.page_label}.</strong> {result.definitional_note}</p>)}
        {checks().filter((result) => result.adjudication).map((result) => <p class="v-small"><strong>{result.page_label}, adjudication.</strong> {result.adjudication}</p>)}
        {checks().filter((result) => result.caveat).map((result) => <p class="v-small"><strong>{result.page_label}, caveat.</strong> {result.caveat}</p>)}
        <p class="v-small"><strong>The composite.</strong> It was previously the headline number of this benchmark and it should never have been used that way.</p>
        <p class="v-small"><strong>Adjudication.</strong> Five cells the two scoring passes disagreed on were adjudicated on {d.adjudicatedOn} against the sealed reference answers. No cell is withheld.</p>
      </div>
    </details>

    <details class="bm-disclosure">
      <summary>Read all {deviations().length} departures</summary>
      <div class="bm-disclosure__body">
        <ol class="bm-departures">
          {deviations().map((departure) => (
            <li>
              <span class="v-index">{String(departure.n).padStart(2, '0')}</span>
              <div><h3>{departure.title}</h3><p class="v-small">{departure.detail}</p></div>
            </li>
          ))}
        </ol>
        <h3 class="v-h3 bm-s6">Two obligations were met exactly</h3>
        <ul class="v-leadlist bm-s5">{cleanItems().map((item) => <li>{item}</li>)}</ul>
      </div>
    </details>
  </div>
</section>

<!-- S8 · Get started -->
<section class="v-section">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">Start with Lens 4.0 on a decision you are holding now.</h2>
