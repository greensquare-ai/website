---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import { withBase } from '../lib/paths';
import {
  grid, checks, check, composite, goCase, directionByCase, dates, refresh,
  prereg, parity, deviations, cleanItems, limitations, fmt, isDefinitional,
  sealedKey, hashedInputs, transcripts, armLabels,
} from '../lib/benchmark';

const g = grid();
const d = dates();
const r = refresh();
const p = prereg();
const comp = composite();
const gc = goCase();
const dbc = directionByCase();
const sk = sealedKey();
const hi = hashedInputs();
const tx = transcripts();
const arms = armLabels();

const openai = r.legs.find((leg) => leg.vendor === 'OpenAI')!;
const anthropic = r.legs.find((leg) => leg.vendor === 'Anthropic')!;
const c1 = check('c1');
const c2 = check('c2');
const c3 = check('c3');
const c6 = check('c6');
const c7 = check('c7');
const caseSizes = g.cases.map((businessCase) => businessCase.n_per_arm);

const businessCases = [
  {
    code: 'A',
    name: 'Meridian',
    decision: 'Structure a major contract bid',
    hidden: 'Decide whether to accept the concentration, regulatory dependency and non-redeployable investment at all.',
    type: 'Reversal case',
  },
  {
    code: 'B',
    name: 'Larkfield',
    decision: 'Sequence an in-house e-commerce build',
    hidden: 'Decide whether to pursue a live acquisition before the eight-week window closes.',
    type: 'Go case',
  },
  {
    code: 'C',
    name: 'Corvan',
    decision: 'Fund the next phase of a venture',
    hidden: 'Decide whether to exit and redeploy capital into the under-invested core business.',
    type: 'Exit and reallocate case',
  },
];

const artefacts = [
  { title: 'Case A, Meridian', sub: 'The frozen prompt and fact sheet.', path: 'evidence/preregistration/v3/cases/case-A-anchor-client.md' },
  { title: 'Case B, Larkfield', sub: 'The go case, and the case where The Decision adds least.', path: 'evidence/preregistration/v3/cases/case-B-go-case.md' },
  { title: 'Case C, Corvan', sub: 'Adapted from a documented Australian post-mortem.', path: 'evidence/preregistration/v3/cases/case-C-disguised-real.md' },
  { title: 'Test protocol', sub: 'Conditions, answering rule, target grid and scoring procedure.', path: 'evidence/preregistration/v3/protocol.md' },
  { title: 'Scoring rubric', sub: 'The pass criteria for all eight checks.', path: 'evidence/preregistration/v3/rubric-operationalisations.md' },
  { title: 'Pre-registration record', sub: 'The hashes and the record\'s edit history.', path: 'evidence/preregistration/v3/PREREGISTRATION.md' },
];

const limitationLeads = [
  'No realistic operator.',
  'One person throughout.',
  'Definitional cells.',
  'Mandated behaviours.',
  'Unequal fact sheets.',
  'Small, unbalanced grid.',
  'Inventory not reconciled.',
  'One fixed file.',
];
---

<BaseLayoutV2
  title="Benchmarking The Decision | GreenSquare AI"
  description={`A ${g.runs_total}-run pre-registered study of whether The Decision changes how frontier AI models handle consequential business decisions.`}
  current="benchmark"
>

<section class="v-section bm-hero">
  <div class="v-container bm-hero__grid">
    <div>
      <p class="v-label">Benchmark study</p>
      <h1 class="v-h1 bm-mt3">We tested whether a structured process changes how AI handles a business decision.</h1>
      <p class="v-lead bm-mt5">Across {g.runs_total} pre-registered runs, two frontier models worked through three synthetic business cases under three conditions: a question only, the same question with all facts, and the question with The Decision loaded.</p>
      <p class="bm-hero__finding bm-mt5"><strong>The result is specific.</strong> The Decision reliably changed the process the models followed. It did not outperform an informed baseline on the two pre-registered judgement checks.</p>
    </div>

    <aside class="bm-summary" aria-label="Study summary">
      <p class="bm-summary__title">Study at a glance</p>
      <dl>
        <div><dt>Runs</dt><dd>{g.runs_total}</dd></div>
        <div><dt>Conditions</dt><dd>3</dd></div>
        <div><dt>Cases</dt><dd>{g.cases.length}</dd></div>
        <div><dt>Models run</dt><dd>{g.models.length}</dd></div>
        <div><dt>Scored</dt><dd>{d.scoredOn}</dd></div>
        <div><dt>Adjudicated</dt><dd>{d.adjudicatedOn}</dd></div>
      </dl>
      <p class="v-small">Both tested models have since been superseded. The results should be read as historical.</p>
    </aside>
  </div>
</section>

<section class="v-section v-green">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">What the evidence supports, and where it stops.</h2>
    <div class="bm-boundary bm-mt6">
      <div>
        <p class="bm-boundary__label">Supported</p>
        <p>The Decision caused the models to ask before advising, compare real Options and tag the basis of material claims. It produced that structured process in every loaded run.</p>
      </div>
      <div>
        <p class="bm-boundary__label">Not established</p>
        <p>The study does not show better judgement than an informed operator, better real-world decisions, or an effect that a capable operator could not reproduce with their own instructions.</p>
      </div>
    </div>
  </div>
</section>

<section class="v-section v-off">
  <div class="v-container">
    <div class="bm-section-head">
      <h2 class="v-h2">Synthetic cases kept the answers out of the models' reach.</h2>
      <div>
        <p class="v-lead">A public business case may already appear in model training data, commentary or search results. That can build the answer into the test.</p>
        <p class="bm-mt4">GreenSquare therefore created three fictional cases whose material facts existed only in the frozen fact sheets. Each case began with a plausible but incomplete executive question. The facts that changed the decision were separated across the case so the model had to connect them.</p>
        <p class="v-small bm-mt4"><strong>Important caveat.</strong> Fictional cases protected the answer key from retrieval. They did not keep every run clean: ChatGPT invoked live web search during six question-only runs in Case B.</p>
      </div>
    </div>

    <ol class="bm-cases" aria-label="The three synthetic decision cases">
      {businessCases.map((businessCase) => (
        <li>
          <span class="v-index">/{businessCase.code}</span>
          <div>
            <p class="bm-case__meta">{businessCase.name} / {businessCase.type}</p>
            <h3>{businessCase.decision}</h3>
          </div>
          <p><strong>The decision beneath it.</strong> {businessCase.hidden}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="v-section">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">Three conditions separated missing information from process discipline.</h2>
    <p class="v-lead bm-mt5">The frozen question was identical in all three conditions. The controlled comparison is between the informed baseline and The Decision: both had access to the same case facts, but only one was given the GreenSquare process.</p>

    <ol class="bm-arms bm-mt6">
      {arms.map((arm, index) => (
        <li>
          <span class="v-index">/{String.fromCharCode(65 + index)}</span>
          <div>
            <h3>{arm.label}</h3>
            <p>{arm.note}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="bm-method-note bm-mt6">
      <h3>Why the informed baseline matters</h3>
      <p>{parity().statement}</p>
      <p class="v-small">The operator's answering rule was fixed before the runs. Off-sheet questions received the same response: “That has not been assessed.” Source: {parity().source}, frozen at commit {p.short}.</p>
    </div>

    <h3 class="v-h3 bm-mt7">The protocol was public before the scored grid</h3>
    <p class="bm-mt3">The cases, answering rule, model plan, repeat counts, scoring rubric and sealed answer-key hash were committed to a public repository before the scored runs. This limits the scope for changing the test after seeing the result.</p>
    <p class="bm-mt4">It does not make the execution independent or fully reproducible. The public record later departed from the protocol in {deviations().length} places. Every departure is listed below.</p>
  </div>
</section>

<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">The clearest effect was behavioural: ask, compare and show the evidence.</h2>
    <p class="v-lead bm-mt5">The Decision changed the process the models followed. Against the informed, all-facts baseline, two measured behaviours separated cleanly. A third behaviour, asking before answering, also separated but was fixed by the single-turn test design.</p>

    <div class="bm-results-grid bm-mt6">
      <article>
        <p class="bm-result__name">Compared real Options</p>
        <p class="bm-result__number">{fmt(c2.armC).text}</p>
        <p>The Decision loaded</p>
        <p class="v-small">All-facts baseline: {fmt(c2.armB).text}</p>
      </article>
      <article>
        <p class="bm-result__name">Tagged its evidence</p>
        <p class="bm-result__number">{fmt(c3.armC).text}</p>
        <p>The Decision loaded</p>
        <p class="v-small">All-facts baseline: {fmt(c3.armB).text}</p>
      </article>
      <article>
        <p class="bm-result__name">Asked before advising</p>
        <p class="bm-result__number">{fmt(c1.armC).text}</p>
        <p>The Decision loaded</p>
        <p class="v-small">All-facts baseline: {fmt(c1.armB).text}, definitional</p>
      </article>
    </div>

    <div class="bm-callout bm-mt6">
      <h3>What changed in the output</h3>
      <p>The loaded condition produced a brief with real Options, evidence tags, named Assumptions and reversal conditions in {fmt(comp.armC).text} runs. The informed baseline produced that five-part process composite in {fmt(comp.armB).text}.</p>
      <p class="v-small">This is a derived composite, not an independent ninth result or the pre-registered headline. It includes the asking-first check, which a single-turn baseline cannot pass. Removing that check does not change the counts because the remaining process checks still separate the conditions.</p>
    </div>
  </div>
</section>

<section class="v-section">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">On judgement, the informed baseline matched or slightly exceeded The Decision.</h2>
    <p class="v-lead bm-mt5">The two pre-registered headline checks were whether the model surfaced the hidden decision and whether its recommendation matched the sealed direction. The all-facts baseline was one run higher on the first and equal on the second.</p>

    <div class="bm-judgement bm-mt6">
      {[c6, c7].map((result) => (
        <article>
          <h3>{result.page_label}</h3>
          <dl>
            <div><dt>Question only</dt><dd>{fmt(result.armA).text}{isDefinitional(result, 'armA') === 'full' ? ' def' : ''}</dd></div>
            <div><dt>All facts</dt><dd>{fmt(result.armB).text}</dd></div>
            <div><dt>The Decision</dt><dd>{fmt(result.armC).text}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <div class="bm-callout bm-mt6">
      <h3>Disciplined process is the supported claim</h3>
      <p>The informed baseline tied The Decision on four of the eight checks and scored higher on one. The Decision scored higher on two measured checks, comparing real Options and tagging evidence. Asking first also separated, but that difference restates the test design.</p>
      <p class="v-small">The behaviours that separate most cleanly are the behaviours the file explicitly requires. They show that the process was followed. They do not show that the model reasoned better.</p>
    </div>

    <h3 class="v-h3 bm-mt7">Recommendation direction did not improve outside one contaminated case</h3>
    <p class="bm-mt3">Across Cases A and C, all three conditions matched the sealed direction in {fmt(dbc.cases_A_and_C.armA).text} runs. The whole question-only deficit sits in Case B, where six ChatGPT runs invoked live search.</p>

    <div class="bm-table-wrap bm-mt5">
      <table class="v-table bm-table">
        <thead><tr><th scope="col">Case split</th><th scope="col" class="num">Question only</th><th scope="col" class="num">All facts</th><th scope="col" class="num">The Decision</th></tr></thead>
        <tbody>
          <tr><th scope="row">Cases A and C</th><td class="num">{fmt(dbc.cases_A_and_C.armA).text}</td><td class="num">{fmt(dbc.cases_A_and_C.armB).text}</td><td class="num">{fmt(dbc.cases_A_and_C.armC).text}</td></tr>
          <tr><th scope="row">Case B, Larkfield</th><td class="num">{fmt(dbc.case_B.armA).text}</td><td class="num">{fmt(dbc.case_B.armB).text}</td><td class="num">{fmt(dbc.case_B.armC).text}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="v-small bm-mt3">Case B is also where The Decision adds least. With every fact supplied, the informed baseline and The Decision both matched the sealed direction in {fmt(gc.armB).text} runs.</p>
  </div>
</section>

<section class="v-section v-green">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">This benchmark does not yet answer the real-world question.</h2>
    <p class="v-lead bm-mt5">The missing condition is the one the product exists for: a capable operator who holds most of the relevant facts but has a blind spot they cannot see. That condition was not run.</p>

    <div class="bm-limit-lead bm-mt6">
      <p><strong>Two comparisons still matter.</strong> The next study needs a realistic operator condition and a condition in which a competent operator writes equivalent instructions without The Decision. Until then, this study cannot establish whether the product improves real work or does something the operator could not reproduce.</p>
    </div>

    <ul class="v-leadlist bm-limitations bm-mt6">
      {limitations().map((limitation, index) => <li><strong>{limitationLeads[index]}</strong> {limitation}</li>)}
    </ul>

    <h3 class="v-h3 bm-mt7">The refresh commitment has lapsed</h3>
    <p class="bm-mt3">The grid was scored against {g.models[0].name} and {g.models[1].name}. Both have since been superseded, and both {r.commitmentDays}-day re-run windows have expired. No re-run date is published.</p>
    <p class="v-small bm-mt4"><strong>OpenAI.</strong> {openai.tested_model} was superseded by {openai.superseded_by} on {openai.releasedOn}. The re-run was {openai.daysPastDue} days past due as at {d.currentAsAt}. Source strength: {openai.source_strength}. {openai.caveat}</p>
    <p class="v-small bm-mt3"><strong>Anthropic.</strong> {anthropic.tested_model} was superseded by {anthropic.superseded_by} on {anthropic.releasedOn}. The re-run was {anthropic.daysPastDue} days past due as at {d.currentAsAt}. Source strength: {anthropic.source_strength}. {anthropic.caveat}</p>
  </div>
</section>

<section class="v-section">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">The inputs are public. The scores cannot yet be reproduced independently.</h2>
    <p class="v-lead bm-mt5">The pre-registration commit is <code class="bm-hash">{p.full}</code>. It was authored at {p.authoredAtTime} and committed at {p.committedAtTime}. A committer timestamp is not proof of push time, and this page does not claim one.</p>

    <div class="bm-verify-grid bm-mt6">
      <div>
        <h3>What can be checked</h3>
        <p>Six inputs were hashed and frozen before the first scored run. Their SHA-256 values match the files at the pre-registration commit when read with {hi.line_endings} line endings.</p>
      </div>
      <div>
        <h3>What cannot be checked</h3>
        <p>No transcript or sealed answer key is published. Nobody outside GreenSquare AI can re-score a run or confirm an adjudicated cell.</p>
      </div>
    </div>

    <h3 class="v-h3 bm-mt7">The six frozen artefacts</h3>
    <ul class="bm-artifacts bm-mt4">
      {artefacts.map((artefact) => (
        <li>
          <a href={p.fileUrl(artefact.path)} target="_blank" rel="noopener">
            <span><strong>{artefact.title}</strong><small>{artefact.sub}</small></span>
            <span>View</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="v-small bm-mt3">Every link is pinned to commit {p.short}, not to the current branch.</p>

    <details class="bm-disclosure bm-mt6">
      <summary>View the frozen hashes</summary>
      <div class="bm-disclosure__body">
        <div class="bm-table-wrap">
          <table class="v-table bm-hash-table">
            <thead><tr><th scope="col">File</th><th scope="col">SHA-256</th></tr></thead>
            <tbody>{hi.files.map((file) => <tr><th scope="row"><code class="bm-hash">{file.file}</code></th><td><code class="bm-hash">{file.sha256}</code></td></tr>)}</tbody>
          </table>
        </div>
        <p class="v-small bm-mt4">The product under test is <code class="bm-hash">{hi.product_file}</code>, SHA-256 <code class="bm-hash">{hi.product_sha256}</code>. {hi.product_withheld_note}</p>
        <p class="v-small bm-mt3">The sealed reference answers hash to <code class="bm-hash">{sk.sha256}</code>. The key itself is not published, so this verification cannot be repeated outside GreenSquare AI.</p>
      </div>
    </details>
  </div>
</section>

<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">The complete record includes {deviations().length} departures from the protocol.</h2>
    <p class="v-lead bm-mt5">The result is presented first so the study can be understood. The full grid, adjudication notes and every recorded departure follow so the evidence can be challenged.</p>

    <h3 class="v-h3 bm-mt7">The grid was smaller and less balanced than planned</h3>
    <p class="bm-mt3">The final grid contains {g.runs_total} runs, {g.n_per_arm} per condition. Case A ran on ChatGPT only. Cases B and C ran on both models. The condition totals split {caseSizes.join(', ')} across the cases.</p>
    <p class="bm-mt4">Nine Claude pilot runs on Case A were excluded by the protocol. A third pre-registered model, {g.planned_models[0].name}, was not run. No per-model result split is published.</p>

    <h3 class="v-h3 bm-mt7">All eight checks</h3>
    <p class="bm-mt3">Counts are out of {g.n_per_arm} per condition, pooled across the two models and three cases. “Def” marks a cell fixed by the test design. “Part” marks a cell partly affected by it.</p>
    <div class="bm-table-wrap bm-mt5">
      <table class="v-table bm-table bm-full-grid">
        <thead><tr><th scope="col">Check</th><th scope="col" class="num">Question only</th><th scope="col" class="num">All facts</th><th scope="col" class="num">The Decision</th></tr></thead>
        <tbody>
          {checks('process').map((result) => (
            <tr>
              <th scope="row">{result.page_label}</th>
              {(['armA', 'armB', 'armC'] as const).map((arm) => {
                const definition = isDefinitional(result, arm);
                return <td class="num">{fmt(result[arm]).text}{definition === 'full' ? ' def' : definition === 'partial' ? ' part' : ''}</td>;
              })}
            </tr>
          ))}
          <tr class="bm-composite"><th scope="row">{comp.label}, derived</th><td class="num">{fmt(comp.armA).text}</td><td class="num">{fmt(comp.armB).text}</td><td class="num">{fmt(comp.armC).text}</td></tr>
          {checks('judgment').map((result) => (
            <tr>
              <th scope="row">{result.page_label}</th>
              {(['armA', 'armB', 'armC'] as const).map((arm) => {
                const definition = isDefinitional(result, arm);
                return <td class="num">{fmt(result[arm]).text}{definition === 'full' ? ' def' : definition === 'partial' ? ' part' : ''}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <details class="bm-disclosure bm-mt6">
      <summary>Read the scoring and adjudication notes</summary>
      <div class="bm-disclosure__body bm-notes">
        <p class="v-small"><strong>Asked before answering.</strong> {c1.definitional_note}</p>
        <p class="v-small"><strong>Surfaced the hidden decision.</strong> {c6.definitional_note}</p>
        {checks().filter((result) => result.definitional_note && !['c1', 'c6'].includes(result.id)).map((result) => <p class="v-small"><strong>{result.page_label}.</strong> {result.definitional_note}</p>)}
        {checks().filter((result) => result.adjudication).map((result) => <p class="v-small"><strong>{result.page_label}, adjudication.</strong> {result.adjudication}</p>)}
        {checks().filter((result) => result.caveat).map((result) => <p class="v-small"><strong>{result.page_label}, caveat.</strong> {result.caveat}</p>)}
        <p class="v-small"><strong>Partial passes.</strong> The table shows full passes only. The protocol requires baseline partial counts prominently, per case. No partial count is published on this site.</p>
        <p class="v-small"><strong>Withdrawn excerpts.</strong> {tx.withdrawn_note}</p>
      </div>
    </details>

    <details class="bm-disclosure bm-mt4">
      <summary>Read all {deviations().length} departures</summary>
      <div class="bm-disclosure__body">
        <ol class="bm-departures">
          {deviations().map((departure) => (
            <li>
              <span class="v-index">{String(departure.n).padStart(2, '0')}</span>
              <div><h3>{departure.title}</h3><p class="v-small">{departure.detail}</p></div>
            </li>
          ))}
        </ol>
        <h3 class="v-h3 bm-mt6">Two obligations were met exactly</h3>
        <ul class="v-leadlist bm-mt4">{cleanItems().map((item) => <li>{item}</li>)}</ul>
      </div>
    </details>
  </div>
</section>

<section class="v-section bm-cta">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">Test the first six questions on a decision you are holding now.</h2>
    <p class="v-lead bm-mt5">The free Decision Frame puts the first six questions on one page. It takes about ten minutes and is designed to expose a missing fact, a weak Assumption or a better Option.</p>
    <div class="hero-actions bm-mt5">
      <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Decision Frame</a>
      <a class="v-btn v-btn--grey" href={withBase('/methodology/')}>Read the full methodology</a>
    </div>
    <p class="v-small bm-mt5">The Decision is not yet on sale. To pressure-test this benchmark or propose the next study, write to <a class="v-link" href="mailto:hello@greensquare.ai">hello@greensquare.ai</a>.</p>
  </div>
</section>

</BaseLayoutV2>

<style is:global>
  .bm-mt3 { margin-top: var(--v-3); }
  .bm-mt4 { margin-top: var(--v-4); }
  .bm-mt5 { margin-top: var(--v-5); }
  .bm-mt6 { margin-top: var(--v-6); }
  .bm-mt7 { margin-top: var(--v-8); }
  .bm-hero { border-top: 0; }
  .bm-hero__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .55fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .v2 .bm-hero .v-h1 { max-width: 20ch; }
  .bm-hero__finding { max-width: 62ch; font-size: 1.05rem; line-height: 1.65; }
  .bm-summary { border-top: 2px solid var(--v-ink); border-bottom: 1px solid var(--v-ink); padding: var(--v-4) 0; }
  .bm-summary__title { font-weight: 600; }
  .bm-summary dl { margin: var(--v-4) 0; }
  .bm-summary dl div { display: flex; justify-content: space-between; gap: var(--v-4); border-top: 1px solid var(--v-line); padding: .7rem 0; }
  .bm-summary dt { color: var(--v-ink-soft); font-size: var(--vs-small); }
  .bm-summary dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .bm-boundary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--v-line-green); border-left: 1px solid var(--v-line-green); }
  .bm-boundary > div { padding: clamp(1.5rem, 4vw, 3rem); border-right: 1px solid var(--v-line-green); border-bottom: 1px solid var(--v-line-green); }
  .bm-boundary p { color: var(--v-cream-soft); }
  .bm-boundary__label { color: var(--v-lime) !important; font-weight: 600; }
  .bm-section-head { display: grid; grid-template-columns: minmax(16rem, .8fr) minmax(20rem, 1.2fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .bm-cases { list-style: none; padding: 0; margin: var(--v-8) 0 0; border-top: 2px solid var(--v-ink); }
