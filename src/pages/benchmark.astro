---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import benchmarkResults from '../data/benchmark-results.json';

type Score = { met: number; partial?: number; n: number };

const agg = (benchmarkResults as any).aggregate;
const groups = agg.groups as Record<string, { label: string; checks: Record<string, { label: string; armA: Score; armB: Score; armC: Score }> }>;
const goCase = (benchmarkResults as any).go_case as { label: string; note: string; armA: Score; armB: Score; armC: Score };

const scoreGroups = [
  {
    label: 'Process checks',
    rows: [
      { label: 'Asked before advising', score: groups.process_discipline.checks.asked_before_answering },
      { label: 'Compared three real options, including the current position', score: groups.process_discipline.checks.real_options_compared },
      { label: 'Marked the basis of important claims', score: groups.process_discipline.checks.evidence_tagged },
      { label: 'Named an untested assumption', score: groups.process_discipline.checks.named_untested_constraint },
      { label: 'Stated what would change the recommendation', score: groups.process_discipline.checks.stated_kill_criteria },
    ],
  },
  {
    label: 'Judgment checks',
    rows: [
      { label: 'Connected the facts into the underlying decision', score: groups.judgment.checks.surfaced_hidden_decision },
      { label: 'Recommendation matched the sealed answer', score: groups.judgment.checks.direction_matched_key },
      { label: 'Caught the planted inconsistency or bias', score: groups.judgment.checks.caught_planted_bias },
    ],
  },
];

const GH_BASE = 'https://github.com/ks-projects-66/greensquare';
const artefacts = [
  {
    title: 'Case A: Meridian managed service bid',
    subtitle: 'The frozen prompt and fact sheet for the anchor client case.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/cases/case-A-anchor-client.md`,
  },
  {
    title: 'Case B: Larkfield acquisition',
    subtitle: 'The case where the evidence supports the more aggressive option.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/cases/case-B-go-case.md`,
  },
  {
    title: 'Case C: Corvan exit decision',
    subtitle: 'A fictional case adapted from a documented Australian post mortem.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/cases/case-C-disguised-real.md`,
  },
  {
    title: 'Test protocol',
    subtitle: 'The conditions, answering rule, target grid and scoring procedure.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/protocol.md`,
  },
  {
    title: 'Scoring rubric',
    subtitle: 'The process and judgment checks with pass criteria.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/rubric-operationalisations.md`,
  },
  {
    title: 'Pre-registration record',
    subtitle: 'The hashes and public commit recorded before the scored runs.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/PREREGISTRATION.md`,
  },
];
---
<BaseLayoutV2
  title="Benchmark | GreenSquare"
  description="A 54 run benchmark of The Decision across two AI models, three business cases and three test conditions, with the method, results and limitations stated plainly."
  current="benchmark"
>
  <section class="v-section v-off bm-hero">
    <div class="v-container v-container--narrow">
      <h1 class="v-h1 v-reveal">54 runs show what changes when the model asks first.</h1>
      <p class="v-lead v-reveal" style="margin-top: var(--v-6);">
        We tested The Decision on three business cases using Claude Opus 4.8 and ChatGPT GPT-5.5. Each case ran
        three ways, with three repeats. The loaded file completed every process check in all 18 runs and surfaced
        the underlying decision in 17 of 18. A question only baseline surfaced it in 0 of 18.
      </p>
      <div class="bm-status v-reveal" style="margin-top: var(--v-8);">
        <span>Completed grid: 54 runs</span>
        <span>Two models</span>
        <span>Three cases</span>
        <span>Gemini pending</span>
        <span>One scorer</span>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container">
      <h2 class="v-h2 v-reveal">The result in one view.</h2>
      <div class="bm-results" style="margin-top: var(--v-8);">
        <article class="v-card v-reveal">
          <p class="v-label">Question only</p>
          <p class="bm-result-number">0 / 18</p>
          <h3 class="v-h3">Surfaced the underlying decision</h3>
          <p class="v-small">
            The answers were fluent and often commercially sensible. They never connected all the facts needed
            to reframe the decision. The recommendation matched the sealed answer in 9 of 18 runs.
          </p>
        </article>
        <article class="v-card v-reveal d1">
          <p class="v-label">All facts provided</p>
          <p class="bm-result-number">15 / 18</p>
          <h3 class="v-h3">Surfaced the underlying decision</h3>
          <p class="v-small">
            The same models were strong when every relevant fact appeared in the first message. They matched the
            sealed answer in all 18 runs. The full Decision Brief structure appeared in 0 of 18.
          </p>
        </article>
        <article class="v-card bm-result-key v-reveal d2">
          <p class="v-label">The Decision loaded</p>
          <p class="bm-result-number">17 / 18</p>
          <h3 class="v-h3">Surfaced the underlying decision</h3>
          <p class="v-small">
            The file asked questions first, then matched the sealed answer in all 18 runs. Every loaded run also
            compared real options, marked the evidence, named an assumption and stated change criteria.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2 v-reveal">What we tested.</h2>
      <p class="v-measure v-reveal" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        Each model received the same three cases under three conditions. The conditions separate the value of
        getting the right facts from the value of reasoning once those facts are available.
      </p>
      <div class="v-caplist">
        <div class="v-caprow v-reveal">
          <span class="v-index">/A</span>
          <h3>Question only</h3>
          <p class="v-small v-cap-body">The short question a business user might type into a new chat. The model answered once with no further information.</p>
        </div>
        <div class="v-caprow v-reveal d1">
          <span class="v-index">/B</span>
          <h3>All facts provided</h3>
          <p class="v-small v-cap-body">The same question with the full case fact sheet in the first message. The model answered once with all relevant information available.</p>
        </div>
        <div class="v-caprow v-reveal d2">
          <span class="v-index">/C</span>
          <h3>The Decision loaded</h3>
          <p class="v-small v-cap-body">The file and the short question. The model asked its own questions, and the operator answered only from the same fact sheet used in condition B.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2 v-reveal">One case in plain English.</h2>
      <p class="v-measure v-reveal" style="margin-top: var(--v-5);">
        Meridian Field Services is considering a five year, A$190 million managed service contract. The question
        asks how to structure the bid and delivery model. Sales, delivery and the chief executive favour the deal.
      </p>
      <p class="v-measure v-reveal">
        Three facts change the call. The contract would approach 40 percent of the division's revenue during the
        ramp years. The client can pause or reshape the contract after a regulatory decision in year three.
        Meridian must also fund a bespoke A$14 million platform and hire 60 people for the work.
      </p>
      <p class="v-measure v-reveal">
        The question only baseline calculated the contract at roughly 8 percent of group revenue and gave sound
        bid protections. It never saw the combined concentration, exit clause and stranded investment risk. The
        loaded file asked for the missing facts and advised Meridian to hold approval until the structure was
        tested.
      </p>

      <div class="bm-quotes v-reveal" style="margin-top: var(--v-8);">
        <div class="bm-quote-block">
          <p class="v-label">Question only excerpt</p>
          <blockquote>“A$190m over five years is roughly A$38m a year, roughly 8% of revenue, from a single client.”</blockquote>
        </div>
        <div class="bm-quote-block">
          <p class="v-label">The Decision excerpt</p>
          <blockquote>“Do not authorise a bid yet.”</blockquote>
          <blockquote>“Close to 40% of the Utilities division in years two and three, derived from your figures.”</blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-green">
    <div class="v-container v-split">
      <div class="v-reveal">
        <h2 class="v-h2">The strongest result is consistency.</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          In every loaded run, the model paused for questions, compared genuine options, marked the basis of its
          claims, identified an untested assumption, and stated what would change the recommendation.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> PROCESS DISCIPLINE / LOADED RUNS</div>
          <div class="v-readout__body">
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">ASKED FIRST</span><span class="v-run__val"><b>18 / 18</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">REAL OPTIONS COMPARED</span><span class="v-run__val"><b>18 / 18</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">EVIDENCE MARKED</span><span class="v-run__val"><b>18 / 18</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">ASSUMPTION NAMED</span><span class="v-run__val"><b>18 / 18</b></span></div></div>
            <div class="v-run"><div class="v-run__head"><span class="v-run__name">CHANGE CRITERIA STATED</span><span class="v-run__val"><b>18 / 18</b></span></div></div>
          </div>
          <div class="v-readout__foot">TWO MODELS / THREE CASES / THREE REPEATS</div>
        </div>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container">
      <div class="v-container--narrow">
        <h2 class="v-h2 v-reveal">All scored checks.</h2>
        <p class="v-measure v-reveal" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
          Process checks measure behaviours the file requests. Judgment checks use a sealed answer prepared for
          each case. Counts are aggregated across both models and all three cases.
        </p>
      </div>
      <div class="bm-table-scroll v-reveal" style="margin-top: var(--v-8);">
        <table class="v-table bm-table">
          <thead>
            <tr>
              <th scope="col">Check</th>
              <th scope="col" class="num">Question only</th>
              <th scope="col" class="num">All facts</th>
              <th scope="col" class="num">The Decision</th>
            </tr>
          </thead>
          <tbody>
            {scoreGroups.map((group) => (
              <>
                <tr class="bm-group-row"><td colspan="4">{group.label}</td></tr>
                {group.rows.map((row) => (
                  <tr>
                    <td>{row.label}</td>
                    <td class="num">{row.score.armA.met} / {row.score.armA.n}</td>
                    <td class="num">{row.score.armB.met} / {row.score.armB.n}</td>
                    <td class="num"><strong>{row.score.armC.met} / {row.score.armC.n}</strong></td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="v-small v-reveal" style="margin-top: var(--v-4);">
        A partial score is recorded separately for the hidden decision check. The table shows full passes only.
      </p>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2 v-reveal">What the result supports.</h2>
      <p class="v-measure v-reveal" style="margin-top: var(--v-5);">
        The informed condition shows that both models can reason well when someone already knows which facts to
        provide. The Decision adds a repeatable way to draw those facts out and package the answer for review.
      </p>
      <p class="v-measure v-reveal">
        The Larkfield case also tested direction. Its evidence supported the aggressive acquisition. The question
        only condition chose the cautious build in all six runs. The loaded condition chose the acquisition in
        all six, with the supporting evidence and change criteria stated.
      </p>
      <div class="v-card v-card--fill v-reveal" style="margin-top: var(--v-8);">
        <p class="v-label">Larkfield result</p>
        <p style="margin-top: var(--v-3); margin-bottom: 0;">
          Question only: {goCase.armA.met} of {goCase.armA.n} matched the evidence backed direction.<br />
          The Decision: {goCase.armC.met} of {goCase.armC.n} matched the evidence backed direction.
        </p>
      </div>
    </div>
  </section>

  <section class="v-section v-fill">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2 v-reveal">Limitations and current status.</h2>
      <ul class="v-leadlist bm-limitations v-reveal" style="margin-top: var(--v-6);">
        <li><strong>Small completed grid.</strong> Each cell has three repeats. The pre-registered protocol targeted about 180 runs. The completed and scored grid currently contains 54.</li>
        <li><strong>Two models completed.</strong> Claude Opus 4.8 and ChatGPT GPT-5.5 are complete. Gemini remains pending.</li>
        <li><strong>One scorer.</strong> The current grid has one scorer. An independent re-score and the blind senior reviewer study have yet to run.</li>
        <li><strong>Vendor built cases.</strong> GreenSquare wrote two cases. The third adapts a documented Australian post mortem. Pre-registration limits changes after the design was fixed.</li>
        <li><strong>One loaded near miss.</strong> A ChatGPT run integrated two of the three facts because its questions did not probe payment structure. The reported result remains 17 of 18.</li>
        <li><strong>Transcripts pending publication.</strong> The run transcripts are saved. They will be published when the Gemini grid is complete. The public counts cannot yet be independently re-scored from this site.</li>
      </ul>
      <p class="v-small v-reveal" style="margin-top: var(--v-6);">
        Current as at 14 July 2026. The OpenAI result remains labelled GPT-5.5 until the GPT-5.6 refresh is complete.
      </p>
    </div>
  </section>

  <section class="v-section">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2 v-reveal">Inspect the test.</h2>
      <p class="v-measure v-reveal" style="margin-top: var(--v-5); color: var(--v-ink-soft);">
        The cases, fact sheets, protocol, rubric and pre-registration record are public. The paid product file and
        sealed answer remain represented by their recorded hashes.
      </p>
      <div class="bm-artefact-list" style="margin-top: var(--v-6);">
        {artefacts.map((artefact) => (
          <a class="bm-artefact v-reveal" href={artefact.href} target="_blank" rel="noopener">
            <span>
              <span class="bm-artefact-title">{artefact.title}</span>
              <span class="bm-artefact-subtitle">{artefact.subtitle}</span>
            </span>
            <span class="bm-artefact-action">View</span>
          </a>
        ))}
      </div>
      <div class="bm-refresh v-reveal" style="margin-top: var(--v-10);">
        <h3 class="v-h3">Refresh policy</h3>
        <p class="v-small" style="margin-top: var(--v-3); margin-bottom: 0;">
          GreenSquare commits to re-running the benchmark within 14 days of a major model release. Each result
          stays labelled with the model version and test date until the new run is complete.
        </p>
      </div>
    </div>
  </section>

  <section class="bm-next v-green" aria-label="Next step">
    <div class="v-container bm-next__inner">
      <div class="bm-next__copy v-reveal">
        <h2 class="v-h2">Test it on a real decision.</h2>
        <p class="v-lead">Use the free Decision Frame to work through the first six questions in about ten minutes.</p>
      </div>
      <div class="bm-next__action v-reveal d1">
        <a class="v-btn v-btn--on-green bm-next__button" href="/decision-frame/">Get the free Decision Frame</a>
        <a class="v-link bm-next__link" href="/product/">See how the complete process works</a>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .bm-hero { padding-top: clamp(3rem, 6vh, 5rem); }
  .bm-status { display: flex; flex-wrap: wrap; gap: var(--v-2) var(--v-5); padding-top: var(--v-4); border-top: 1px solid var(--v-line-strong); color: var(--v-ink-soft); font-size: var(--vs-small); }
  .bm-results { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--v-5); }
  .bm-result-key { box-shadow: 0 3px 8px rgba(23,27,24,0.14); }
  .bm-result-key .v-label { color: var(--v-green); }
  .bm-result-number { font-family: var(--vf-display); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1; letter-spacing: -0.02em; margin: var(--v-5) 0 var(--v-3); color: var(--v-green); }
  .bm-results .v-h3 { margin-bottom: var(--v-4); }
  .bm-quotes { display: grid; grid-template-columns: 1fr 1fr; gap: var(--v-6); }
  .bm-quote-block { background: var(--v-fill); padding: var(--v-6); }
  .bm-quote-block blockquote { margin: var(--v-4) 0 0; font-family: var(--vf-display); font-size: 1.08rem; line-height: 1.45; }
  .bm-table-scroll { overflow-x: auto; }
  .bm-table { min-width: 720px; font-size: var(--vs-small); }
  .bm-group-row td { padding-top: var(--v-6); color: var(--v-green); font-weight: 600; border-bottom: 1px solid var(--v-line-strong); }
  .bm-limitations { gap: var(--v-5); }
  .bm-artefact-list { display: grid; gap: var(--v-3); }
  .bm-artefact { display: flex; align-items: center; justify-content: space-between; gap: var(--v-6); padding: var(--v-4) var(--v-5); background: var(--v-fill); text-decoration: none; color: var(--v-ink); transition: transform var(--v-fast) var(--v-ease), background-color var(--v-fast) var(--v-ease); }
  .bm-artefact:hover { transform: translateY(-2px); background: var(--v-fill-2); }
  .bm-artefact-title, .bm-artefact-subtitle { display: block; }
  .bm-artefact-title { font-weight: 600; }
  .bm-artefact-subtitle { margin-top: var(--v-1); font-size: var(--vs-small); color: var(--v-ink-soft); }
  .bm-artefact-action { flex: none; font-weight: 600; font-size: var(--vs-small); color: var(--v-green); }
  .bm-refresh { padding-top: var(--v-6); border-top: 1px solid var(--v-line-strong); }
  .bm-next { padding-block: clamp(4.5rem, 8vw, 6.5rem); }
  .bm-next__inner { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
  .bm-next__copy { max-width: 42rem; }
  .bm-next__copy .v-lead { max-width: 48ch; margin-top: var(--v-4); color: var(--v-cream-soft); }
  .bm-next__action { display: flex; flex-direction: column; align-items: flex-start; gap: var(--v-4); justify-self: end; }
  .bm-next__button { min-height: 48px; padding-inline: var(--v-6); white-space: nowrap; }
  .bm-next__link { color: var(--v-cream); }
  @media (max-width: 900px) {
    .bm-results, .bm-quotes, .bm-next__inner { grid-template-columns: 1fr; }
    .bm-next__inner { gap: var(--v-8); }
    .bm-next__action { justify-self: start; }
  }
  @media (max-width: 560px) {
    .bm-next__action, .bm-next__button { width: 100%; }
    .bm-next__link { line-height: 1.5; }
  }
</style>
