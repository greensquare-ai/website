---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import benchmarkResults from '../data/benchmark-results.json';

type Score = { met: number; partial?: number; n: number };

const agg = (benchmarkResults as any).aggregate;
const groups = agg.groups as Record<string, { label: string; checks: Record<string, { label: string; armA: Score; armB: Score; armC: Score }> }>;
const defensible = agg.defensible_brief_structure as { label: string; armA: Score; armB: Score; armC: Score };
const goCase = (benchmarkResults as any).go_case as { label: string; note: string; armA: Score; armB: Score; armC: Score };

function dots(score: Score) {
  const partial = score.partial ?? 0;
  const met = score.met;
  const notMet = Math.max(score.n - met - partial, 0);
  return { met, partial, notMet, n: score.n };
}

const GH_BASE = 'https://github.com/ks-projects-66/greensquare';
const artefacts = [
  {
    title: 'Case A: the anchor-client brief',
    subtitle: 'Meridian Field Services managed-service bid (fictional, ASX-scale). The frozen prompt and fact sheet.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/cases/case-A-anchor-client.md`,
  },
  {
    title: 'Case B: the GO case',
    subtitle: 'Pre-registered. The correct call is the aggressive option, not caution.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/cases/case-B-go-case.md`,
  },
  {
    title: 'Case C: the disguised-real case',
    subtitle: 'Adapted and disguised from a documented Australian post-mortem.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/cases/case-C-disguised-real.md`,
  },
  {
    title: 'Test protocol',
    subtitle: 'The three conditions, the answering rule, and the scoring procedure.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/protocol.md`,
  },
  {
    title: 'Scoring rubric and operationalisations',
    subtitle: 'Binary checks, split into process discipline and judgment, with pass criteria.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/rubric-operationalisations.md`,
  },
  {
    title: 'Methodology',
    subtitle: 'Design rationale, repetition, independent scoring, and the limitations we do not hide.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/methodology.md`,
  },
  {
    title: 'Pre-registration hashes',
    subtitle: 'Commit hashes for the cases, rubric, and sealed answer key, timestamped before any scored run.',
    href: `${GH_BASE}/blob/main/evidence/preregistration/v3/PREREGISTRATION.md`,
  },
];

const rubricChecks = [
  { group: 'Process discipline', label: 'Asked before answering', def: 'Did the run ask clarifying questions before offering a recommendation.' },
  { group: 'Process discipline', label: 'Real options, including doing nothing, compared on criteria', def: 'Did the run set out genuine alternatives, not just the plan as pitched, scored against named criteria.' },
  { group: 'Process discipline', label: 'Evidence tagged', def: "Is every load-bearing claim marked given, inferred, derived, or unknown." },
  { group: 'Process discipline', label: 'Named an untested constraint or assumption', def: 'Did the run flag at least one thing the organisation was treating as fixed but had not actually verified.' },
  { group: 'Process discipline', label: 'Stated kill criteria', def: 'Did the run name a condition that would stop or reverse the recommended course.' },
  { group: 'Judgment', label: 'Surfaced the hidden decision by integrating the three separated facts', def: 'Scored blind against the sealed answer key. Naming one component risk is partial; connecting all three facts into the reframed decision is a full pass.' },
  { group: 'Judgment', label: 'Recommendation direction matched the sealed key', def: 'Scored blind. Did the final call point the same way as the pre-registered answer.' },
  { group: 'Judgment', label: 'Caught the planted inconsistency or bias', def: 'Scored blind. Did the run name the advocacy or optimism bias in the brief, and distinguish it correctly from sunk cost.' },
];
---
<BaseLayoutV2
  title="Benchmark | GreenSquare"
  description="A pre-registered, three-condition benchmark across two frontier models and three fictional ASX-scale cases (54 runs). Only the Decision Brief produced a defensible, evidence-tagged brief, every run, 18 of 18 on both models across all three cases. On the anchor case, the naked baseline sizes the risk at 8% when the real figure is close to 40%, and never sees the clause that could strand the investment."
  current="benchmark"
>
  <!-- INTRO — header + key findings -->
  <section class="v-section v-off bm-hero">
    <div class="v-container v-container--narrow bm-copy">
      <h1 class="v-h1 v-reveal">A frontier model reasons brilliantly once it has the facts. Who gets the facts out of you?</h1>
      <p class="v-lead v-reveal" style="margin-top: var(--v-6);">
        A controlled, pre-registered benchmark, run in three conditions per case: a naked baseline (the question
        exactly as a real person would ask it), an informed baseline (the same question with every fact handed
        over), and the Decision Brief, loaded and interrogating. This is the full pre-registered grid: two
        frontier models (Claude Opus 4.8 and ChatGPT GPT-5.5), three fictional ASX-scale cases, three conditions
        each, three repeats per cell, 54 runs in total. Gemini is pre-registered and its run is still pending.
        Every input, the rubric, and the answer-key hashes were committed to GitHub before any run was scored.
      </p>

      <div class="v-card v-card--fill bm-callout v-reveal" style="margin-top: var(--v-10);">
        <h2 class="bm-callout-title">Key findings</h2>
        <ul class="v-leadlist">
          <li>
            <strong>No reversal, and we are not claiming one.</strong> Even given nothing but the question, the
            model pushed back on the framing. That is not the finding here.
          </li>
          <li>
            <strong>The facts it never asked for.</strong> On the anchor case, given only the question a real
            person asks, the model sized the decisive risk at about 8% of revenue when the fact that mattered put
            it near 40% of the division, and it never surfaced the payment clause that could strand the
            investment. The naked baseline missed the hidden decision on all 18 runs, on either model. Getting
            those facts out of you is the product's work.
          </li>
          <li>
            <strong>Only the loaded product was defensible.</strong> A structured, evidence-tagged brief on every
            run: 18 of 18, both models, all three cases. The naked and informed baselines managed it on none.
            Reliability and defensibility, not raw capability, is the gap.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- METHOD + THE TEST -->
  <section class="v-section bm-copy">
    <div class="v-container v-container--narrow">
      <p class="v-measure v-reveal">
        In July 2026, Claude Opus 4.8 and ChatGPT GPT-5.5 were each asked to advise on three fictional cases,
        Meridian (the anchor client), Larkfield (the GO case) and Corvan (the disguised-real case), in three
        conditions, three repeats each: 54 runs in total. The naked baseline received only the question a real
        executive would ask. The informed baseline received the identical question plus the full fact sheet. The
        Decision Brief received its own product file, then the question, then answered its own interrogation
        using only the fact sheet, saying "that has not been assessed" wherever the sheet was silent. Runs were
        scored against a rubric fixed in advance and a sealed answer key. Gemini is pre-registered and its runs
        are still pending; this page will be updated once they are scored.
      </p>

      <h2 class="v-h2 v-reveal" style="margin-top: var(--v-12);">The test isn't whether the model can reason. It's whether it gets the facts that change the call.</h2>
      <p class="v-measure v-reveal">
        Meridian Field Services is a fictional, ASX-scale provider of inspection, testing and compliance
        services to infrastructure and utility clients (revenue about A$480m, group EBITDA margin about 11%). A
        state water utility has offered to consolidate its national compliance work into a five-year, A$190m
        managed-service contract. Winning it would make Meridian the clear category leader in its slowest-growing
        division, and the sales and delivery teams are strongly in favour.
      </p>
      <p class="v-measure v-reveal">
        <strong>The presented question.</strong> How should Meridian structure its bid and delivery model to win
        and deliver this A$190m, five-year contract. The sales team can quote a win probability at an aggressive
        price. The momentum behind the deal, from sales, delivery and the CEO, is real.
      </p>
      <p class="v-measure v-reveal">
        <strong>The unpresented question.</strong> Whether to accept close to 40% single-client concentration of
        a division in the contract's ramp years, behind a counterparty whose payments depend on a state
        regulator's five-yearly determination (with a rescope-or-pause right at year three, on 90 days'
        notice), funded by a bespoke A$14m platform with little value outside this contract and 60 staff hired
        specifically for it. The tension sits in the brief; the question is whether the model integrates the
        three facts placed far apart in it.
      </p>
      <p class="v-measure v-reveal">
        None of this is hidden. The concentration numbers, the regulator's determination cycle, and the platform
        spend are all in the fact sheet. The naked baseline is not handed the fact sheet, only the question a
        real person would ask. The question this benchmark tests is not whether the model can reason well when
        the facts are in front of it. It is whether not asking is a capability gap, or whether extracting the
        facts was always meant to be the product's job.
      </p>
    </div>
  </section>

  <!-- EXHIBIT 1 -->
  <section class="v-section v-fill">
    <div class="v-container">
      <div class="bm-exhibit-head v-reveal">
        <div class="bm-exhibit-label-row">
          <span class="bm-exhibit-tag">Exhibit 1</span>
          <span class="bm-exhibit-title">How each condition treated the question</span>
        </div>
        <p class="bm-exhibit-source">Source: GreenSquare grid, July 2026. Two models (Claude Opus 4.8, ChatGPT GPT-5.5), three cases, n=3 per cell (54 runs). Gemini pending.</p>
      </div>
      <div class="bm-cols3">
        <div class="v-card bm-col v-reveal">
          <p class="v-label bm-col-label">Naked baseline</p>
          <p class="bm-col-verdict">Reframed, but at the wrong magnitude.</p>
          <p class="v-small">
            On the anchor case, reframed the question and challenged the sales enthusiasm every run, unprompted.
            But because it never interrogates, it never gets the facts that change the decision: it sized the
            concentration at roughly 8% of group revenue and never saw the year-three regulatory cliff at all.
            The same failure to integrate the hidden decision held across all three cases and both models, on
            every one of the 18 runs.
          </p>
        </div>
        <div class="v-card bm-col v-reveal d1">
          <p class="v-label bm-col-label">Informed baseline</p>
          <p class="bm-col-verdict">Strong, once handed every fact, but not defensible.</p>
          <p class="v-small">
            Given the full fact sheet up front, integrated the hidden decision in 15 of 18 runs across the grid,
            matched the sealed key's direction on all 18, and caught the planted bias on all 18. What it did not
            do, on any of the 18 runs: interrogate, or produce a brief structured well enough to defend.
          </p>
        </div>
        <div class="v-card bm-col bm-col--key v-reveal d2">
          <p class="v-label bm-col-label">The Decision Brief</p>
          <p class="bm-col-verdict">Interrogated the facts out, then produced a defensible brief.</p>
          <p class="v-small">
            Asked scaled questions before offering a view, played its read back, named contradictions in the
            answers it was given, then delivered a five-part brief: options compared, evidence tagged, kill
            criteria stated, confidence declared, on 18 of 18 runs across the grid.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- EXHIBIT 2 -->
  <section class="v-section">
    <div class="v-container">
      <div class="bm-exhibit-head v-reveal">
        <div class="bm-exhibit-label-row">
          <span class="bm-exhibit-tag">Exhibit 2</span>
          <span class="bm-exhibit-title">Verbatim output, naked baseline vs the Decision Brief</span>
        </div>
        <p class="bm-exhibit-source">Source: Test transcripts, 3 July 2026, lightly condensed. Full transcripts published on completion of the grid.</p>
      </div>
      <div class="bm-cols2">
        <div class="bm-quote-col v-reveal">
          <div class="bm-quote-head">
            <span class="bm-col-strong">Baseline</span>
            <span class="bm-col-sub">No interrogation</span>
          </div>
          <p class="bm-quote">"A$190m over five years is ~A$38m a year, roughly 8% of revenue, from a single client, on a single contract, under a new commercial model."</p>
          <p class="bm-quote">"Push hard away from pure fixed-price outcome risk and toward a managed-service wrapper over retained rate-card economics&hellip; The non-negotiables: indexation, volume floor, capped at-risk margin, change-of-law relief, funded mobilisation, termination-for-convenience protection."</p>
          <p class="bm-quote">"Set board-approved walk-away parameters (minimum margin, non-negotiable risk terms, maximum acceptable concentration) before you enter final negotiation."</p>
        </div>
        <div class="bm-quote-col v-reveal d1">
          <div class="bm-quote-head">
            <span class="bm-col-strong">The Decision Brief</span>
            <span class="bm-col-sub">Interrogated first</span>
          </div>
          <p class="bm-quote">"Do not authorise a bid yet."</p>
          <p class="bm-quote">"&hellip;close to 40% of the Utilities division in years two and three (derived from your figures)&hellip;"</p>
          <p class="bm-quote">"Meridian would carry the full mobilisation cost in years two and three while the client holds a no-cost exit tied to a regulatory determination expiring in year three&hellip; The evidence does not support bidding blind into that."</p>
          <p class="bm-quote">"Confidence: low. Validate first: the scope split and the actual bid deadline. Those two gate everything else."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SCORING THE RUNS + EXHIBIT 3 (table) -->
  <section class="v-section v-fill">
    <div class="v-container">
      <div class="bm-copy v-container--narrow" style="padding-inline: 0; margin-inline: 0;">
        <h2 class="v-h2 v-reveal">Scoring the runs</h2>
        <p class="v-measure v-reveal">
          Each run is scored against a rubric fixed in advance and a sealed answer key, split into two
          honestly-labelled groups. Process discipline is what the product itself instructs the model to do:
          asking before answering, comparing real options, tagging evidence, naming an untested constraint,
          stating what would change the call. Judgment is not instructed by the product at all, and is scored
          blind against the sealed key: whether the run surfaced the hidden decision, whether its recommendation
          matched the key's direction, and whether it caught the planted inconsistency or bias.
        </p>
      </div>

      <div class="bm-exhibit-head v-reveal" style="margin-top: var(--v-10);">
        <div class="bm-exhibit-label-row">
          <span class="bm-exhibit-tag">Exhibit 3</span>
          <span class="bm-exhibit-title">Scoring, split by rubric group</span>
        </div>
        <p class="bm-exhibit-source">
          Source: GreenSquare grid, July 2026. Two models (Claude Opus 4.8, ChatGPT GPT-5.5), three cases, n=3
          per cell (54 runs). Gemini pending. Binary checks scored against a pre-registered rubric and sealed
          answer key, aggregated across both models and all three cases.
        </p>
      </div>

      <div class="bm-table-scroll v-reveal">
        <table class="v-table bm-table">
          <thead>
            <tr>
              <th scope="col">Check</th>
              <th scope="col">Naked baseline</th>
              <th scope="col">Informed baseline</th>
              <th scope="col">Decision Brief</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(groups).map(([groupKey, group]) => (
              <>
                <tr class="bm-group-row"><td colspan="4">{group.label}</td></tr>
                {Object.entries(group.checks).map(([checkKey, check]) => {
                  const a = dots(check.armA);
                  const b = dots(check.armB);
                  const c = dots(check.armC);
                  return (
                    <tr>
                      <td class="bm-check-label">{check.label}</td>
                      <td>
                        <span class="bm-dotset" aria-hidden="true">
                          {Array.from({ length: a.met }).map(() => <span class="bm-dot met" />)}
                          {Array.from({ length: a.partial }).map(() => <span class="bm-dot partial" />)}
                          {Array.from({ length: a.notMet }).map(() => <span class="bm-dot" />)}
                        </span>
                        <span class="bm-dotcount">{a.met} / {a.n}{a.partial ? ` (+${a.partial} partial)` : ''}</span>
                      </td>
                      <td>
                        <span class="bm-dotset" aria-hidden="true">
                          {Array.from({ length: b.met }).map(() => <span class="bm-dot met" />)}
                          {Array.from({ length: b.partial }).map(() => <span class="bm-dot partial" />)}
                          {Array.from({ length: b.notMet }).map(() => <span class="bm-dot" />)}
                        </span>
                        <span class="bm-dotcount">{b.met} / {b.n}{b.partial ? ` (+${b.partial} partial)` : ''}</span>
                      </td>
                      <td>
                        <span class="bm-dotset" aria-hidden="true">
                          {Array.from({ length: c.met }).map(() => <span class="bm-dot met" />)}
                          {Array.from({ length: c.partial }).map(() => <span class="bm-dot partial" />)}
                          {Array.from({ length: c.notMet }).map(() => <span class="bm-dot" />)}
                        </span>
                        <span class="bm-dotcount">{c.met} / {c.n}{c.partial ? ` (+${c.partial} partial)` : ''}</span>
                      </td>
                    </tr>
                  );
                })}
              </>
            ))}
          </tbody>
        </table>
      </div>

      <p class="v-small v-reveal" style="margin-top: var(--v-4); max-width: 72ch;">
        Each square is one run. Filled marks a pass, empty marks a fail. Counts are aggregated across both
        models and all three cases, 18 runs per arm on every check. Every count traces to a saved transcript
        scored against the rubric below.
      </p>
    </div>
  </section>

  <!-- THE PROOF — green big-block -->
  <section class="v-section v-green">
    <div class="v-container v-split is-reverse">
      <div class="v-reveal">
        <h2 class="v-h2">{defensible.label}</h2>
        <p class="v-lead" style="margin-top: var(--v-5);">
          Only the Decision Brief produced a defensible brief, on every run: both models, all three cases.
        </p>
      </div>
      <div class="v-reveal d1">
        <div class="v-readout">
          <div class="v-readout__bar"><span class="v-readout__dot"></span> DEFENSIBLE_BRIEF / FULL GRID</div>
          <div class="v-readout__body">
            <div class="v-run">
              <div class="v-run__head"><span class="v-run__name">Naked baseline</span><span class="v-run__val">{defensible.armA.met} / {defensible.armA.n}</span></div>
              <div class="v-meter"><div class="v-meter__fill is-muted" style="--w: 0%;"></div></div>
            </div>
            <div class="v-run">
              <div class="v-run__head"><span class="v-run__name">Informed baseline</span><span class="v-run__val">{defensible.armB.met} / {defensible.armB.n}</span></div>
              <div class="v-meter"><div class="v-meter__fill is-muted" style="--w: 0%;"></div></div>
            </div>
            <div class="v-run">
              <div class="v-run__head"><span class="v-run__name">Decision Brief</span><span class="v-run__val"><b>{defensible.armC.met} / {defensible.armC.n}</b></span></div>
              <div class="v-meter"><div class="v-meter__fill" style="--w: 100%;"></div></div>
            </div>
          </div>
          <div class="v-readout__foot">PRE-REGISTERED GRID / N=18 PER ARM / 2 MODELS / 3 CASES</div>
        </div>
      </div>
    </div>
  </section>

  <!-- RUBRIC DISCLOSURE + closing analysis -->
  <section class="v-section bm-copy">
    <div class="v-container v-container--narrow">
      <details class="bm-rubric-disclosure v-reveal">
        <summary>Inspect the rubric</summary>
        <div class="bm-rubric-list">
          {rubricChecks.map((r) => (
            <div class="bm-rubric-item">
              <p class="v-label bm-rubric-group">{r.group}</p>
              <p class="bm-rubric-item-label">{r.label}</p>
              <p class="v-small">{r.def}</p>
            </div>
          ))}
        </div>
      </details>

      <p class="v-measure v-reveal" style="margin-top: var(--v-10);">
        The Decision Brief does not only pull ahead on defensible structure. On judgment, the picture is more
        interesting. The naked baseline missed the hidden decision on every one of the 18 runs, and matched the
        sealed key's direction on only 9 of 18, case-dependent. The informed baseline, handed the same facts as
        the product, is strong: it surfaced the hidden decision in 15 of 18 runs, matched the sealed key's
        direction on all 18, and caught the planted bias on all 18. That says the model is capable, given the
        facts. The loaded Decision Brief surfaced the hidden decision in 17 of 18 runs, one honest near-miss,
        detailed below, and matched every other judgment check, 18 of 18. The product's edge over an informed
        model is not raw judgment. It is defensible structure and reliability, produced without anyone handing
        over a fact sheet first.
      </p>
      <p class="v-measure v-reveal">
        The naked baseline is the honest warning here. It is fluent, commercially literate, and reframes without
        being asked. Across the grid it matched the sealed key's direction on 9 of 18 runs, strong on some
        cases, off on others. What it did not do, on any of the 18 runs, is integrate the facts into the hidden
        decision itself. On the anchor case that meant sizing the risk five times too small, and missing the
        mechanism, a regulatory determination expiring in year three, that could strand a A$14m platform and 60
        staff. That is not a reasoning failure. It is what happens when nobody asks.
      </p>

      <div class="v-card v-card--fill bm-callout v-reveal" style="margin-top: var(--v-8);">
        <h2 class="bm-callout-title">The GO case</h2>
        <p style="margin-bottom: 0;">
          Larkfield is the case pre-registered to test the opposite failure mode: caution when the evidence
          supports moving. Here, the correct call is the aggressive acquisition, not the safe build. Handed only
          the question, both models defaulted to the cautious build, on every run ({goCase.armA.met} of {goCase.armA.n}).
          Loaded, the Decision Brief reframed toward the bold acquisition on both models, with zero hedging
          ({goCase.armC.met} of {goCase.armC.n}). It follows the evidence toward boldness as readily as it does
          toward caution.
        </p>
      </div>
    </div>
  </section>

  <!-- METHOD, ARTEFACTS, LIMITATIONS + OBJECTIONS -->
  <section class="v-section v-fill bm-copy">
    <div class="v-container v-container--narrow">
      <h2 class="v-h2 v-reveal">Method, artefacts, and limitations</h2>
      <p class="v-measure v-reveal">
        This is the full pre-registered grid, not a pilot: two models, three cases, three conditions, n=3 per
        cell, 54 runs. It is built to be replicable and contestable: every input, the rubric, and the sealed
        answer key were hashed and committed to a public repository before any run was scored. Readers who want
        to dispute the protocol, or run the cases themselves, can do so now.
      </p>
      <p class="v-reveal" style="margin-top: var(--v-4);">
        <a class="v-link" href="https://github.com/ks-projects-66/greensquare/tree/main/evidence/preregistration/v3" target="_blank" rel="noopener">Read the test protocol</a>
      </p>

      <details class="bm-artefacts-disclosure v-reveal" style="margin-top: var(--v-12);">
        <summary>Raw artefacts</summary>
        <div class="bm-artefact-list">
          {artefacts.map((a) => (
            <a class="bm-artefact" href={a.href} target="_blank" rel="noopener">
              <span class="bm-artefact-text">
                <span class="bm-artefact-title">{a.title}</span>
                <span class="bm-artefact-subtitle">{a.subtitle}</span>
              </span>
              <span class="bm-artefact-arrow">View</span>
            </a>
          ))}
        </div>
      </details>
      <p class="v-small v-reveal" style="margin-top: var(--v-4);">
        Transcripts for the naked baseline, informed baseline, and Decision Brief runs behind every count on
        this page are published once Gemini's runs complete the full three-model grid.
      </p>

      <p class="v-measure v-reveal" style="margin-top: var(--v-8);">
        <strong>Caveats.</strong> Two models and three cases are fully run and scored (n=3 per cell); Gemini is
        pre-registered and pending, and this page will update when it completes. Single scorer throughout. Some
        naked baselines were strong: on Case C, both models declined the raise as posed, and Claude named the
        sunk-cost trap unprompted on all three runs, the gap the product fills is fact-integration and process
        discipline, not a model failure. One loaded run was an honest near-miss: on Case A, ChatGPT's loaded run
        1 integrated two of three facts because its interrogation never probed payment structure, which is why
        the loaded hidden-decision figure is 17 of 18, not 18 of 18. An independent, blind senior-reviewer study,
        asking verified senior operators which brief they would send to their own executive committee, is
        planned and not yet run. No score-uplift percentage is claimed anywhere on this page. Every count above
        traces to a saved transcript, and independent re-scoring against the published rubric is welcome.
      </p>

      <h3 class="v-h3 v-reveal" style="margin-top: var(--v-12);">Anticipated objections</h3>
      <div class="bm-objections v-reveal">
        <details>
          <summary>Isn't this just a prompt that will be copied?</summary>
          <p class="v-small">
            Yes, it is a file. That is the point: nothing to install, nothing for IT to approve, and your data
            never leaves your own account. What is harder to copy is the standing commitment behind it: a rubric
            and answer key we did not grade ourselves, transcripts published for every run, and a re-test within
