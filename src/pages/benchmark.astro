<style is:global>
  /* ---------- spacing utilities, section 2.4 ----------
     Named for the token they apply. The old bm-mt ladder is gone: bm-mt7
     resolved to --v-8, which is a name that lied. */
  .bm-s3 { margin-top: var(--v-3); }
  .bm-s4 { margin-top: var(--v-4); }
  .bm-s5 { margin-top: var(--v-5); }
  .bm-s6 { margin-top: var(--v-6); }
  .bm-s8 { margin-top: var(--v-8); }
  .bm-s10 { margin-top: var(--v-10); }

  /* Figure numbers come from a counter, so they cannot go stale when a figure is
     added or dropped. Section 2.6. */
  .bm-page { counter-reset: bm-fig; }

  /* ---------- S1, section 3.1 ---------- */
  .bm-hero { border-top: 0; padding-top: clamp(3rem, 6vh, 5rem); }
  .bm-hero__title { max-width: 16ch; }
  /* The page stylesheet loads before global-v2.css, so anything that has to beat
     a global rule needs the specificity to do it on its own. .v2 p caps the
     measure at 70ch and would otherwise win this. */
  .v2 .bm-hero__note { max-width: 58ch; }

  /* ---------- S2, section 3.2 ----------
     The band is a direct child of the section, outside .v-container, which is the
     only safe full-bleed on this site because .v-section has no horizontal padding.
     The section drops its own bottom padding and border so the band sits flush:
     --v-line drawn across the foot of a green band is a visible pale hairline. */
  .bm-s2 { padding-bottom: 0; border-bottom: 0; }
  .bm-band { padding-block: var(--v-10); }
  .bm-claim { max-width: 24ch; }
  .bm-status { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 0; border-top: 2px solid var(--v-ink); border-bottom: 1px solid var(--v-ink); }
  .bm-status > div { padding: var(--v-4) 0; }
  .bm-status dt { font-size: var(--vs-label); color: var(--v-ink-soft); }
  .bm-status dd { margin: 0; font-size: var(--vs-body); font-weight: 600; font-variant-numeric: tabular-nums; }
  .bm-boundary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--v-line-green); border-left: 1px solid var(--v-line-green); }
  .bm-boundary > div { padding: clamp(1.5rem, 4vw, 3rem); border-right: 1px solid var(--v-line-green); border-bottom: 1px solid var(--v-line-green); }
  .bm-boundary p { color: var(--v-cream-soft); }
  .bm-boundary__label { color: var(--v-lime) !important; font-weight: 600; }

  /* ---------- the breakout, section 2.2 ----------
     Both margins come from one variable, so they are equal by construction at
     every width. The components carry the same rule in their own scope; this copy
     serves the S7 grid, which is page markup. */
  .bm-breakout { width: min(1100px, 100%); margin-inline: auto; }
  @media (min-width: 1171px) {
    .bm-breakout {
      --bm-bw: min(1100px, calc(100vw - 2 * var(--v-gutter)));
      width: var(--bm-bw);
      margin-inline: calc((100% - var(--bm-bw)) / 2);
    }
  }

  /* ---------- figures written by the page, not by a component ----------
     Figure 2 is a readout, so it has no component of its own. The counter and the
     title treatment have to exist globally for it. */
  .bm-fig { margin: 0; counter-increment: bm-fig; }
  .bm-fig .bm-fig__title { margin: 0; font-family: var(--vf-body); font-size: var(--vs-h3); font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .bm-fig .bm-fig__title::before { content: 'Figure ' counter(bm-fig) '. '; }
  .bm-fig .bm-fig__title--sm { font-size: var(--vs-h4); }
  .bm-fig .bm-fig__basis { margin: var(--v-3) 0 0; max-width: 72ch; font-size: var(--vs-small); color: var(--v-ink-soft); }

  /* Section 5.2. Two of the three rows are zero, so their fill has no width. The
     left-edge tick makes a zero row read as zero rather than as unrendered. It
     sits under the fill, so a non-zero row is unchanged. */
  .bm-fig .v-meter { position: relative; }
  .bm-fig .v-meter::after { content: ''; position: absolute; inset-block: 0; left: 0; width: 2px; background: var(--v-ink-faint); }

  /* Section 8.1, and the second permitted repair. The at-rest declaration in
     global-v2.css is untouched: this adds a start state under .js only, so
     without scripting the fill renders at rest and a broken observer cannot leave
     a bar empty. */
  .js .bm-fig .v-meter__fill { transform: scaleX(0); }
  .js .bm-fig.is-visible .v-meter__fill { transform: scaleX(1); }
  .js .bm-fig.is-visible .v-run:nth-child(2) .v-meter__fill { transition-delay: 60ms; }
  .js .bm-fig.is-visible .v-run:nth-child(3) .v-meter__fill { transition-delay: 120ms; }
  /* Reduced motion renders at rest and fully visible, with no dependence on the
     observer having run. */
  @media (prefers-reduced-motion: reduce) {
    .js .bm-fig .v-meter__fill { transform: none; }
  }

  /* ---------- S3, the demonstration brief ----------
     The Result panel is the product's output read as text, so it carries no
     border and no chrome. Its part headings are h3 elements held at --vs-h4, a
     level below every other h3 on the page, the same treatment the departures
     get in section 7.5. */
  .v2 .bm-brief__part { font-family: var(--vf-body); font-size: var(--vs-h4); font-weight: 600; line-height: 1.35; margin-top: var(--v-6); margin-bottom: var(--v-3); }
  .bm-brief__table table { min-width: 34rem; }
  .bm-tabs__panel--result table { width: 100%; border-collapse: collapse; font-size: var(--vs-small); }
  .bm-tabs__panel--result th, .bm-tabs__panel--result td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--v-line); vertical-align: top; }
  .bm-tabs__panel--result thead th { border-bottom: 2px solid var(--v-ink); }
  .bm-tabs__panel--result hr { display: none; }
  .bm-tabs__panel--result .v-tag { display: inline-block; }

  /* ---------- S4 ---------- */
  .bm-tags { display: flex; flex-wrap: wrap; gap: var(--v-2); margin-top: var(--v-2); }
  /* Section 2.4: .bm-pairs replaces the deleted big-number cards. Both counts
     share one selector, so there is no way to enlarge one without the other. */
  .bm-pairs { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--v-ink); }
  .bm-pairs li { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--v-5); align-items: baseline; padding: var(--v-5) 0; border-bottom: 1px solid var(--v-line); }
  .bm-pairs .bm-pairs__name { margin: 0; max-width: none; font-weight: 600; }
  .bm-pairs .bm-pairs__vals { margin: 0; max-width: none; display: flex; flex-wrap: wrap; gap: var(--v-2) var(--v-6); font-size: var(--vs-body); color: var(--v-ink-soft); }
  .bm-pairs .bm-pairs__vals b { font-weight: 600; color: var(--v-ink); font-variant-numeric: tabular-nums; }
  .bm-pairs .bm-pairs__note { grid-column: 1 / -1; margin: 0; font-size: var(--vs-small); color: var(--v-ink-soft); }

  /* ---------- S5 ---------- */
  .bm-section-head { display: grid; grid-template-columns: minmax(16rem, .8fr) minmax(20rem, 1.2fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .bm-cases { list-style: none; padding: 0; margin: var(--v-8) 0 0; border-top: 2px solid var(--v-ink); }
  .bm-cases li { display: grid; grid-template-columns: 4rem minmax(14rem, .8fr) minmax(20rem, 1.2fr); gap: var(--v-5); align-items: start; border-bottom: 1px solid var(--v-line); padding: var(--v-5) 0; }
  .bm-cases h3 { font-size: 1.2rem; line-height: 1.3; }
  .bm-case__meta { margin-bottom: var(--v-2); color: var(--v-ink-faint); font-size: var(--vs-label); }
  .bm-cases li > p { color: var(--v-ink-soft); font-size: var(--vs-small); }
  .bm-arms { list-style: none; padding: 0; border-top: 2px solid var(--v-ink); }
  .bm-arms li { display: grid; grid-template-columns: 4rem 1fr; gap: var(--v-4); border-bottom: 1px solid var(--v-line); padding: var(--v-5) 0; }
  .bm-arms h3 { margin-bottom: var(--v-2); font-size: 1.2rem; }
  .bm-arms p { color: var(--v-ink-soft); }
  .bm-method-note { border: 1.5px solid var(--v-ink); background: var(--v-paper); padding: var(--v-6); }
  .bm-method-note h3 { margin-bottom: var(--v-3); font-size: 1.2rem; }

  /* ---------- tables, sections 7.1 to 7.3 ---------- */
  .bm-table-wrap { max-width: 100%; overflow-x: auto; }
  /* overflow-x clips a ring drawn outside the box, so these three regions draw
     theirs inside. */
  .bm-table-wrap:focus-visible { outline-offset: -2px; }
  .bm-table { min-width: 38rem; }
  .v2 .bm-table th[scope='row'] { font-weight: 400; }
  .bm-scrollhint { display: none; margin-bottom: var(--v-3); color: var(--v-ink-faint); }
  @media (max-width: 900px) { .bm-scrollhint { display: block; } }
  /* The Compass column carries a full-height square outline: the one to look at,
     not the winner. Composed from cell borders because <col> borders are
     unreliable across engines. The header cell's own 2px bottom rule closes the
     top corners. There is deliberately no sticky thead: the wrapper scrolls
     horizontally only, so a sticky header would have nothing to stick within. */
  .bm-full-grid th:nth-child(4), .bm-full-grid td:nth-child(4) { border-left: 2px solid var(--v-ink); border-right: 2px solid var(--v-ink); }
  .bm-full-grid thead th:nth-child(4) { border-top: 2px solid var(--v-ink); }
  .bm-full-grid tbody tr:last-child > :nth-child(4) { border-bottom: 2px solid var(--v-ink); }
  /* A sticky cell with a transparent background lets the scrolled numerals slide
     underneath it. */
  .bm-full-grid th[scope='row'] { position: sticky; left: 0; z-index: 1; background: var(--v-paper); }
  .bm-full-grid tr.bm-composite th[scope='row'] { background: var(--v-fill-2); }
  .bm-composite th, .bm-composite td { background: var(--v-fill-2); font-weight: 600 !important; }
  .bm-composite th[scope='row'] { line-height: 1.4; }
  .bm-composite th[scope='row'] .v-small { display: block; margin-top: var(--v-1); font-size: var(--vs-label); color: var(--v-ink-soft); font-weight: 400; }
  .bm-hash-table { min-width: 52rem; }

  /* ---------- S6 ---------- */
  .bm-limit-lead { border: 1px solid var(--v-cream); padding: var(--v-5); }
  .bm-limit-lead p { color: var(--v-cream); }
  /* The gutter token was --v-7, which does not exist, and one invalid value
     invalidates the whole gap declaration. First permitted repair. */
  .v-leadlist.bm-limitations { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--v-5) var(--v-8); }

  /* ---------- S7 ---------- */
  .bm-verify-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid var(--v-ink); }
  .bm-verify-grid > div { padding: var(--v-5) 0; border-bottom: 1px solid var(--v-ink); }
  .bm-verify-grid > div + div { margin-left: var(--v-6); padding-left: var(--v-6); border-left: 1px solid var(--v-line); }
  .bm-verify-grid h3 { margin-bottom: var(--v-3); font-size: 1.15rem; }
