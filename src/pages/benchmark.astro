---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import { withBase } from '../lib/paths';
import {
  grid, checks, check, composite, directionByCase, dates, refresh,
  prereg, parity, deviations, cleanItems, limitations, fmt, isDefinitional,
  sealedKey, hashedInputs, transcripts, armLabels,
} from '../lib/benchmark';

const g = grid();
const d = dates();
const r = refresh();
const p = prereg();
const comp = composite();
const dbc = directionByCase();
const sk = sealedKey();
const hi = hashedInputs();
const tx = transcripts();
const arms = armLabels();

const openai = r.legs.find((leg) => leg.vendor === 'OpenAI')!;
const anthropic = r.legs.find((leg) => leg.vendor === 'Anthropic')!;
const c1 = check('c1');
const c2 = check('c2');
const c3 = check('c3');
const c6 = check('c6');
const c7 = check('c7');
const caseSizes = g.cases.map((businessCase) => businessCase.n_per_arm);

const comparisonMetrics = [
  { group: 'Process discipline', label: 'Compared real Options', baseline: c2.armB, loaded: c2.armC },
  { group: 'Process discipline', label: 'Tagged its evidence', baseline: c3.armB, loaded: c3.armC },
  { group: 'Judgement', label: c6.page_label, baseline: c6.armB, loaded: c6.armC },
  { group: 'Judgement', label: c7.page_label, baseline: c7.armB, loaded: c7.armC },
];

const businessCases = [
  {
    code: 'A',
    name: 'Meridian',
    decision: 'Structure a major contract bid',
    hidden: 'Decide whether to accept the concentration, regulatory dependency and non-redeployable investment at all.',
    type: 'Reversal case',
  },
  {
    code: 'B',
    name: 'Larkfield',
    decision: 'Sequence an in-house e-commerce build',
    hidden: 'Decide whether to pursue a live acquisition before the eight-week window closes.',
    type: 'Go case',
  },
  {
    code: 'C',
    name: 'Corvan',
    decision: 'Fund the next phase of a venture',
    hidden: 'Decide whether to exit and redeploy capital into the under-invested core business.',
    type: 'Exit and reallocate case',
  },
];

const artefacts = [
  { title: 'Case A, Meridian', sub: 'The frozen prompt and fact sheet.', path: 'evidence/preregistration/v3/cases/case-A-anchor-client.md' },
  { title: 'Case B, Larkfield', sub: 'The go case, and the case where The Decision adds least.', path: 'evidence/preregistration/v3/cases/case-B-go-case.md' },
  { title: 'Case C, Corvan', sub: 'Adapted from a documented Australian post-mortem.', path: 'evidence/preregistration/v3/cases/case-C-disguised-real.md' },
  { title: 'Test protocol', sub: 'Conditions, answering rule, target grid and scoring procedure.', path: 'evidence/preregistration/v3/protocol.md' },
  { title: 'Scoring rubric', sub: 'The pass criteria for all eight checks.', path: 'evidence/preregistration/v3/rubric-operationalisations.md' },
  { title: 'Pre-registration record', sub: 'The hashes and the record\'s edit history.', path: 'evidence/preregistration/v3/PREREGISTRATION.md' },
];

const limitationLeads = [
  'No realistic operator.',
  'One person throughout.',
  'Definitional cells.',
  'Mandated behaviours.',
  'Unequal fact sheets.',
  'Small, unbalanced grid.',
  'Inventory not reconciled.',
  'One fixed file.',
];

const materialLimitations = [
  {
    title: 'The intended real-world operator condition was not tested.',
    body: limitations()[0],
  },
  {
    title: 'Execution and scoring were not independent.',
    body: limitations()[1],
  },
  {
    title: 'Some apparent differences were fixed by the test design.',
    body: limitations()[2],
  },
  {
    title: 'Case B question-only runs were contaminated by live search.',
    body: 'Six ChatGPT question-only runs in Case B invoked live web search. The whole question-only recommendation deficit sits in that case, so it should not be read as clean evidence of an information effect.',
  },
];
---

<BaseLayoutV2
  title="Benchmarking The Decision | GreenSquare AI"
  description={`A ${g.runs_total}-run pre-registered study of whether The Decision changes how frontier AI models handle consequential business decisions.`}
  current="benchmark"
>

<section class="v-section bm-hero" id="result">
  <div class="v-container bm-hero__inner">
    <div class="bm-hero__copy">
      <h1 class="v-h1">The Decision changed process discipline. It did not improve judgement against an informed baseline.</h1>
      <p class="v-lead bm-mt5">Across {g.runs_total} pre-registered runs, two frontier models worked through three synthetic business cases. The Decision consistently changed how they approached the problem, but did not outperform an equally informed baseline on the two pre-registered judgement checks.</p>
      <p class="bm-status bm-mt5"><span aria-hidden="true"></span><strong>Historical benchmark.</strong> Both tested models have since been superseded{r.anyLapsed ? ', and the published refresh commitment has lapsed.' : '.'}</p>
    </div>

    <dl class="bm-meta" aria-label="Study at a glance">
      <div><dt>Runs</dt><dd>{g.runs_total}</dd></div>
      <div><dt>Cases</dt><dd>{g.cases.length}</dd></div>
      <div><dt>Conditions</dt><dd>3</dd></div>
      <div><dt>Models</dt><dd>{g.models.length}</dd></div>
    </dl>
  </div>
</section>

<nav class="bm-subnav" aria-label="Benchmark sections">
  <div class="v-container bm-subnav__inner">
    <a href="#evidence">Evidence</a>
    <a href="#study-design">Study design</a>
    <a href="#limitations">Limitations</a>
    <a href="#research-record">Research record</a>
  </div>
</nav>

<section class="v-section v-off" id="evidence">
  <div class="v-container">
    <div class="bm-section-head">
      <div>
        <h2 class="v-h2">Process discipline separated sharply. Judgement did not.</h2>
      </div>
      <div>
        <p class="v-lead">The controlled comparison is <strong>All facts versus The Decision</strong>. Both conditions received the same case information. Only The Decision received the GreenSquare process.</p>
        <p class="v-small bm-mt3">Counts are full passes out of {g.n_per_arm} runs per condition. “Asked before advising” is intentionally excluded from this headline exhibit because the one-turn baseline was unable to pass it by construction.</p>
      </div>
    </div>

    <figure class="bm-comparison bm-mt7" aria-labelledby="comparison-title">
      <figcaption id="comparison-title" class="bm-comparison__legend">
        <span><i class="bm-dot bm-dot--baseline" aria-hidden="true"></i>All facts</span>
        <span><i class="bm-dot bm-dot--loaded" aria-hidden="true"></i>The Decision</span>
      </figcaption>

      <div class="bm-comparison__axis" aria-hidden="true"><span>0</span><span>{g.n_per_arm} of {g.n_per_arm}</span></div>

      {comparisonMetrics.map((metric, index) => (
        <div class:list={['bm-compare-row', index === 2 && 'bm-compare-row--break']} aria-label={`${metric.label}: All facts ${fmt(metric.baseline).text}, The Decision ${fmt(metric.loaded).text}`}>
          <div class="bm-compare-row__label">
            {index === 0 && <p class="bm-group-label">Process discipline</p>}
            {index === 2 && <p class="bm-group-label">Judgement</p>}
            <h3>{metric.label}</h3>
          </div>
          <div class="bm-compare-row__plot">
            <div class="bm-track" style={`--baseline:${fmt(metric.baseline).pct}%; --loaded:${fmt(metric.loaded).pct}%;`} aria-hidden="true">
              <span class="bm-track__line"></span>
              <span class="bm-track__connector"></span>
              <span class="bm-marker bm-marker--baseline"></span>
              <span class="bm-marker bm-marker--loaded"></span>
            </div>
          </div>
          <div class="bm-compare-row__values">
            <span>{fmt(metric.baseline).text}</span>
            <strong>{fmt(metric.loaded).text}</strong>
          </div>
        </div>
      ))}

      <p class="v-small bm-comparison__note">The behavioural gaps show that the prescribed process was followed. They do not establish that the models reasoned better. On the two pre-registered judgement checks, the informed baseline was one run higher on surfacing the hidden decision and equal on recommendation direction.</p>
    </figure>
  </div>
</section>

<section class="v-section">
  <div class="v-container bm-interpretation">
    <div>
      <h2 class="v-h2">What the evidence supports</h2>
      <ul class="bm-plain-list bm-mt5">
        <li>The Decision caused the models to compare genuine alternatives.</li>
        <li>It caused them to distinguish the evidentiary basis of material claims.</li>
        <li>It produced the prescribed structured process in every loaded run.</li>
      </ul>
    </div>
    <div>
      <h2 class="v-h2">What it does not establish</h2>
      <ul class="bm-plain-list bm-mt5">
        <li>Superior judgement to an informed operator.</li>
        <li>Better real-world decision outcomes.</li>
        <li>An effect a capable operator could not reproduce with equivalent instructions.</li>
      </ul>
    </div>
  </div>
</section>

<section class="v-section v-off" id="study-design">
  <div class="v-container">
    <div class="bm-section-head">
      <div>
        <h2 class="v-h2">The experiment separated missing information from process discipline.</h2>
      </div>
      <div>
        <p class="v-lead">The question was identical in all three conditions. The informed baseline and The Decision received the same case facts, making their comparison the cleanest test of what the structured process itself changed.</p>
      </div>
    </div>

    <div class="bm-condition-diagram bm-mt7" role="img" aria-label="Three experimental conditions. Question only had incomplete information. All facts and The Decision had equal information, with only The Decision receiving the structured GreenSquare process. The controlled comparison is between All facts and The Decision.">
      {arms.map((arm, index) => (
        <div class:list={['bm-condition', index === 0 && 'bm-condition--context', index > 0 && 'bm-condition--controlled']}>
          <span class="bm-condition__index">{String.fromCharCode(65 + index)}</span>
          <h3>{arm.label}</h3>
          <p>{arm.note}</p>
          <p class="bm-condition__state">{index === 0 ? 'Incomplete information' : 'Equal information'}</p>
        </div>
      ))}
      <div class="bm-control-line" aria-hidden="true"><span>Controlled comparison</span></div>
    </div>

    <div class="bm-method-rows bm-mt7">
      <div><span>01</span><h3>Cases</h3><p>Three synthetic business decisions kept the material answer out of public training data and search results.</p></div>
      <div><span>02</span><h3>Conditions</h3><p>Question only, all facts, and The Decision loaded.</p></div>
      <div><span>03</span><h3>Runs</h3><p>{g.runs_total} scored runs, with {g.n_per_arm} per condition across the final grid.</p></div>
      <div><span>04</span><h3>Measures</h3><p>Eight pre-registered checks spanning process behaviour and judgement.</p></div>
      <div><span>05</span><h3>Record</h3><p>Cases, answering rule, model plan, scoring rubric and a sealed answer-key hash were committed before the scored grid.</p></div>
    </div>

    <details class="bm-inline-disclosure bm-mt6">
      <summary>Read the three synthetic cases</summary>
      <div class="bm-cases">
        {businessCases.map((businessCase) => (
          <article>
            <span class="bm-case__index">{businessCase.code}</span>
            <div>
              <p class="bm-case__meta">{businessCase.name} · {businessCase.type}</p>
              <h3>{businessCase.decision}</h3>
              <p><strong>The decision beneath it.</strong> {businessCase.hidden}</p>
            </div>
          </article>
        ))}
      </div>
    </details>

    <p class="v-small bm-mt5"><strong>Why the informed baseline matters.</strong> {parity().statement} The operator's answering rule was fixed before the runs, and off-sheet questions received the same response: “That has not been assessed.”</p>
  </div>
</section>

<section class="v-section" id="limitations">
  <div class="v-container">
    <div class="bm-section-head">
      <div>
        <h2 class="v-h2">Four limitations materially change how the result should be read.</h2>
      </div>
      <div>
        <p class="v-lead">These are presented with the interpretation, not buried in the audit trail. The complete limitation set remains available below.</p>
      </div>
    </div>

    <div class="bm-limitations bm-mt7">
      {materialLimitations.map((limitation, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><h3>{limitation.title}</h3><p>{limitation.body}</p></div>
        </article>
      ))}
    </div>

    <details class="bm-inline-disclosure bm-mt6">
      <summary>See all methodological limitations</summary>
      <ul class="bm-full-limitations">
        {limitations().map((limitation, index) => <li><strong>{limitationLeads[index]}</strong> {limitation}</li>)}
      </ul>
    </details>

    <div class="bm-refresh bm-mt7">
      <h3>The refresh commitment has lapsed</h3>
      <p>The grid was scored against {g.models[0].name} and {g.models[1].name}. Both have since been superseded, and both {r.commitmentDays}-day re-run windows have expired. No re-run date is published.</p>
      <p class="v-small bm-mt3"><strong>OpenAI.</strong> {openai.tested_model} was superseded by {openai.superseded_by} on {openai.releasedOn}. The re-run was {openai.daysPastDue} days past due as at {d.currentAsAt}. {openai.caveat}</p>
      <p class="v-small bm-mt3"><strong>Anthropic.</strong> {anthropic.tested_model} was superseded by {anthropic.superseded_by} on {anthropic.releasedOn}. The re-run was {anthropic.daysPastDue} days past due as at {d.currentAsAt}. {anthropic.caveat}</p>
    </div>
  </div>
</section>

<section class="v-section v-off bm-next-study">
  <div class="v-container bm-next-study__grid">
    <div>
      <h2 class="v-h2">The next benchmark needs to test the situation GreenSquare actually exists for.</h2>
      <p class="v-lead bm-mt5">This study established process discipline. The next one needs to test whether that discipline improves decisions under realistic operating conditions.</p>
    </div>
    <ol>
      <li><span>01</span><div><h3>Realistic information asymmetry</h3><p>Can The Decision expose a blind spot when a capable operator already holds most, but not all, of what matters?</p></div></li>
      <li><span>02</span><div><h3>Equivalent-instruction baseline</h3><p>Does GreenSquare outperform a competent operator writing their own structured instructions?</p></div></li>
      <li><span>03</span><div><h3>Independent evaluation</h3><p>Do the results survive independent execution, scoring and adjudication?</p></div></li>
    </ol>
  </div>
</section>

<section class="v-section bm-research" id="research-record">
  <div class="v-container">
    <div class="bm-research__head">
      <div>
        <h2 class="v-h2">Research record</h2>
        <p class="v-lead bm-mt4">Everything required to inspect the benchmark, including unresolved issues and all {deviations().length} recorded departures from protocol.</p>
      </div>
      <button type="button" class="bm-expand-all" data-expand-research>Expand all research record</button>
    </div>

    <div class="bm-record-list bm-mt7" data-research-record>
      <details class="bm-record" id="record-results">
        <summary><span>Complete results</span><small>Eight checks, case split and scoring notes</small></summary>
        <div class="bm-record__body">
          <p>Counts are out of {g.n_per_arm} per condition, pooled across the two models and three cases. “Def” marks a cell fixed by the test design. “Part” marks a cell partly affected by it.</p>
          <div class="bm-table-wrap bm-mt5">
            <table class="v-table bm-table bm-full-grid">
              <thead><tr><th scope="col">Check</th><th scope="col" class="num">Question only</th><th scope="col" class="num">All facts</th><th scope="col" class="num">The Decision</th></tr></thead>
              <tbody>
                {checks('process').map((result) => (
                  <tr>
                    <th scope="row">{result.page_label}</th>
                    {(['armA', 'armB', 'armC'] as const).map((arm) => {
                      const definition = isDefinitional(result, arm);
                      return <td class="num">{fmt(result[arm]).text}{definition === 'full' ? ' def' : definition === 'partial' ? ' part' : ''}</td>;
                    })}
                  </tr>
                ))}
                <tr class="bm-composite"><th scope="row">{comp.label}, derived</th><td class="num">{fmt(comp.armA).text}</td><td class="num">{fmt(comp.armB).text}</td><td class="num">{fmt(comp.armC).text}</td></tr>
                {checks('judgment').map((result) => (
                  <tr>
                    <th scope="row">{result.page_label}</th>
                    {(['armA', 'armB', 'armC'] as const).map((arm) => {
                      const definition = isDefinitional(result, arm);
                      return <td class="num">{fmt(result[arm]).text}{definition === 'full' ? ' def' : definition === 'partial' ? ' part' : ''}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 class="v-h3 bm-mt7">Recommendation direction by case</h3>
          <p class="bm-mt3">Across Cases A and C, all three conditions matched the sealed direction in {fmt(dbc.cases_A_and_C.armA).text} runs. The whole question-only deficit sits in Case B, where six ChatGPT runs invoked live search.</p>
          <div class="bm-table-wrap bm-mt5">
            <table class="v-table bm-table">
              <thead><tr><th scope="col">Case split</th><th scope="col" class="num">Question only</th><th scope="col" class="num">All facts</th><th scope="col" class="num">The Decision</th></tr></thead>
              <tbody>
                <tr><th scope="row">Cases A and C</th><td class="num">{fmt(dbc.cases_A_and_C.armA).text}</td><td class="num">{fmt(dbc.cases_A_and_C.armB).text}</td><td class="num">{fmt(dbc.cases_A_and_C.armC).text}</td></tr>
                <tr><th scope="row">Case B, Larkfield</th><td class="num">{fmt(dbc.case_B.armA).text}</td><td class="num">{fmt(dbc.case_B.armB).text}</td><td class="num">{fmt(dbc.case_B.armC).text}</td></tr>
              </tbody>
            </table>
          </div>

          <div class="bm-notes bm-mt6">
            <p class="v-small"><strong>Asked before answering.</strong> {c1.definitional_note}</p>
            <p class="v-small"><strong>Surfaced the hidden decision.</strong> {c6.definitional_note}</p>
            {checks().filter((result) => result.definitional_note && !['c1', 'c6'].includes(result.id)).map((result) => <p class="v-small"><strong>{result.page_label}.</strong> {result.definitional_note}</p>)}
            {checks().filter((result) => result.adjudication).map((result) => <p class="v-small"><strong>{result.page_label}, adjudication.</strong> {result.adjudication}</p>)}
            {checks().filter((result) => result.caveat).map((result) => <p class="v-small"><strong>{result.page_label}, caveat.</strong> {result.caveat}</p>)}
            <p class="v-small"><strong>Partial passes.</strong> The table shows full passes only. The protocol requires baseline partial counts prominently, per case. No partial count is published on this site.</p>
            <p class="v-small"><strong>Withdrawn excerpts.</strong> {tx.withdrawn_note}</p>
          </div>
        </div>
      </details>

      <details class="bm-record" id="record-method">
        <summary><span>Method and reproducibility</span><small>Pre-registration, grid design and what can be independently checked</small></summary>
        <div class="bm-record__body">
          <p>The cases, answering rule, model plan, repeat counts, scoring rubric and sealed answer-key hash were committed to a public repository before the scored runs. This limits the scope for changing the test after seeing the result.</p>
          <p class="bm-mt4">The pre-registration commit is <code class="bm-hash">{p.full}</code>. It was authored at {p.authoredAtTime} and committed at {p.committedAtTime}. A committer timestamp is not proof of push time, and this page does not claim one.</p>

          <div class="bm-verify-grid bm-mt6">
            <div><h3>What can be checked</h3><p>Six inputs were hashed and frozen before the first scored run. Their SHA-256 values match the files at the pre-registration commit when read with {hi.line_endings} line endings.</p></div>
            <div><h3>What cannot be checked</h3><p>No transcript or sealed answer key is published. Nobody outside GreenSquare AI can re-score a run or confirm an adjudicated cell.</p></div>
          </div>

          <h3 class="v-h3 bm-mt7">Final grid versus plan</h3>
          <p class="bm-mt3">The final grid contains {g.runs_total} runs, {g.n_per_arm} per condition. Case A ran on ChatGPT only. Cases B and C ran on both models. The condition totals split {caseSizes.join(', ')} across the cases.</p>
          <p class="bm-mt4">Nine Claude pilot runs on Case A were excluded by the protocol. A third pre-registered model, {g.planned_models[0].name}, was not run. No per-model result split is published.</p>
        </div>
      </details>

      <details class="bm-record" id="record-artefacts">
        <summary><span>Frozen artefacts</span><small>Cases, protocol, scoring rubric and hashes pinned to the pre-registration commit</small></summary>
        <div class="bm-record__body">
          <ul class="bm-artifacts">
            {artefacts.map((artefact) => (
              <li>
                <a href={p.fileUrl(artefact.path)} target="_blank" rel="noopener">
                  <span><strong>{artefact.title}</strong><small>{artefact.sub}</small></span>
                  <span>View</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="v-small bm-mt3">Every link is pinned to commit {p.short}, not to the current branch.</p>

          <details class="bm-inline-disclosure bm-mt6">
            <summary>View the frozen hashes</summary>
            <div class="bm-table-wrap bm-mt5">
              <table class="v-table bm-hash-table">
                <thead><tr><th scope="col">File</th><th scope="col">SHA-256</th></tr></thead>
                <tbody>{hi.files.map((file) => <tr><th scope="row"><code class="bm-hash">{file.file}</code></th><td><code class="bm-hash">{file.sha256}</code></td></tr>)}</tbody>
              </table>
            </div>
            <p class="v-small bm-mt4">The product under test is <code class="bm-hash">{hi.product_file}</code>, SHA-256 <code class="bm-hash">{hi.product_sha256}</code>. {hi.product_withheld_note}</p>
            <p class="v-small bm-mt3">The sealed reference answers hash to <code class="bm-hash">{sk.sha256}</code>. The key itself is not published, so this verification cannot be repeated outside GreenSquare AI.</p>
          </details>
        </div>
      </details>

      <details class="bm-record" id="record-departures">
        <summary><span>Protocol departures</span><small>All {deviations().length} recorded deviations, plus obligations met exactly</small></summary>
        <div class="bm-record__body">
          <p>The record departed from the pre-registered protocol in {deviations().length} places. They are listed in full rather than netted into a single quality judgement.</p>
          <ol class="bm-departures bm-mt6">
            {deviations().map((departure) => (
              <li>
                <span>{String(departure.n).padStart(2, '0')}</span>
                <div><h3>{departure.title}</h3><p class="v-small">{departure.detail}</p></div>
              </li>
            ))}
          </ol>
          <h3 class="v-h3 bm-mt7">Two obligations were met exactly</h3>
          <ul class="bm-plain-list bm-mt4">{cleanItems().map((item) => <li>{item}</li>)}</ul>
        </div>
      </details>
    </div>
  </div>
</section>

<section class="v-section v-off bm-close">
  <div class="v-container v-container--narrow">
    <h2 class="v-h2">What this benchmark establishes today</h2>
    <p class="v-lead bm-mt5">The Decision reliably changed process behaviour in this test. It did not demonstrate superior judgement to an informed baseline. The next test needs to establish whether that discipline produces better decisions under realistic operating conditions.</p>
    <div class="bm-close__actions bm-mt6">
      <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free Decision Frame</a>
      <a class="v-link" href={withBase('/methodology/')}>Read the full methodology</a>
      <a class="v-link" href={p.commitUrl} target="_blank" rel="noopener">Inspect the pre-registration record</a>
    </div>
    <p class="v-small bm-mt5">The Decision is not yet on sale. To pressure-test this benchmark or propose the next study, write to <a class="v-link" href="mailto:hello@greensquare.ai">hello@greensquare.ai</a>.</p>
  </div>
</section>

<script>
  const button = document.querySelector('[data-expand-research]');
  const record = document.querySelector('[data-research-record]');
  if (button && record) {
    button.addEventListener('click', () => {
      const details = Array.from(record.querySelectorAll(':scope > details'));
      const shouldOpen = details.some((item) => !item.open);
      details.forEach((item) => { item.open = shouldOpen; });
      button.textContent = shouldOpen ? 'Collapse research record' : 'Expand all research record';
    });
  }
</script>

</BaseLayoutV2>

<style is:global>
  .bm-mt3 { margin-top: var(--v-3); }
  .bm-mt4 { margin-top: var(--v-4); }
  .bm-mt5 { margin-top: var(--v-5); }
  .bm-mt6 { margin-top: var(--v-6); }
