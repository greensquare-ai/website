</style>

<script>
  /* Figure 2 has no connector, so the chart component's own observer does not
     reach it, and its meter fills would stay at their .js start state. This adds
     .is-visible to any figure holding a meter, and nothing else. */
  const meterFigures = Array.from(document.querySelectorAll<HTMLElement>('.bm-fig')).filter((figure) =>
    figure.querySelector('.v-meter__fill'),
  );
  if (meterFigures.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    meterFigures.forEach((figure) => io.observe(figure));
  }
</script>
