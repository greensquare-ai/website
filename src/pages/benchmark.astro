---
import BaseLayoutV2 from '../layouts/BaseLayoutV2.astro';
import { withBase } from '../lib/paths';
import {
  grid, checks, check, composite, goCase, directionByCase, dates, refresh,
  prereg, parity, deviations, cleanItems, limitations, fmt, isDefinitional,
  sealedKey, hashedInputs, transcripts, protocolQuotes, armBvsArmC, armLabels, spell,
} from '../lib/benchmark';

const g = grid();
const d = dates();
const r = refresh();
const p = prereg();
const comp = composite();
const gc = goCase();
const dbc = directionByCase();
const sk = sealedKey();
const hi = hashedInputs();
const tx = transcripts();
const pq = protocolQuotes();
const cmp = armBvsArmC();
const arms = armLabels();

const openai = r.legs.find((l) => l.vendor === 'OpenAI')!;
const anthropic = r.legs.find((l) => l.vendor === 'Anthropic')!;

const c6 = check('c6');
const c7 = check('c7');

// One cell per run. Grouped 3 / 6 / 6 to show the case shape of the grid.
const caseSizes = g.cases.map((c) => c.n_per_arm);

// The two pre-registered primary checks, then the derived composite beneath them.
const headline = [
  { label: c6.page_label, check: c6 },
  { label: c7.page_label, check: c7 },
];

const artefacts = [
  { title: 'Case A, Meridian', sub: 'The frozen prompt and fact sheet.', path: 'evidence/preregistration/v3/cases/case-A-anchor-client.md' },
  { title: 'Case B, Larkfield', sub: 'The GO case, and the case where the file adds least.', path: 'evidence/preregistration/v3/cases/case-B-go-case.md' },
  { title: 'Case C, Corvan', sub: 'Adapted from a documented Australian post mortem.', path: 'evidence/preregistration/v3/cases/case-C-disguised-real.md' },
  { title: 'Test protocol', sub: 'Conditions, the answering rule, the target grid and the scoring procedure.', path: 'evidence/preregistration/v3/protocol.md' },
  { title: 'Scoring rubric', sub: 'The pass criteria for each of the eight checks.', path: 'evidence/preregistration/v3/rubric-operationalisations.md' },
  { title: 'Pre-registration record', sub: 'The hashes, and this record’s own edit history.', path: 'evidence/preregistration/v3/PREREGISTRATION.md' },
];

const statusItems = [
  `${g.runs_total} runs`,
  `${g.n_per_arm} per condition`,
  `${g.cases.length} cases`,
  `${g.models.length} models`,
  `Scored ${d.scoredOn}`,
  `Adjudicated ${d.adjudicatedOn}`,
  'Both models superseded',
];

// Authored labels for the lead-list component. The sentence after each lead is the
// bound limitation text and is never edited here.
const limitationLeads = [
  'No realistic operator.',
  'One person throughout.',
  'Two definitional cells.',
  'Mandated behaviours.',
  'Unequal fact sheets.',
  'Small, unbalanced grid.',
  'Inventory not reconciled.',
  'One hashed file.',
];
---
<BaseLayoutV2
  title="Benchmark | GreenSquare AI"
  description={`A ${g.runs_total} run pre-registered benchmark of The Decision across two AI models, three business cases and three conditions, with the method, the results, every deviation and the limitations stated plainly.`}
  current="benchmark"
>

<!-- 1. THE CLAIM AND THE CORE RESULT -->
<section class="v-section bm-open">
  <div class="v-container v-container--narrow">
    <h1 class="v-h1">The file asked its own questions, obtained the decisive facts, and surfaced the hidden decision in {fmt(c6.armC).text} runs.</h1>

    <p class="v-lead bm-mt5">It started from a short question with no facts supplied. The informed baseline reached {fmt(c6.armB).text} on the same check, and it was handed the complete fact sheet before it answered. Those two numbers are the finding, and what the file closes is the gap between typing a short question and holding a complete fact sheet.</p>

    <div class="v-readout bm-mt6">
      <div class="v-readout__bar"><span class="v-readout__dot"></span> The pre-registered result</div>
      <div class="v-readout__body">
        {headline.map((h) => (
          <div class="bm-block">
            <p class="v-label bm-block__k">{h.label}</p>
            {(['armA', 'armB', 'armC'] as const).map((arm) => {
              const cell = h.check[arm];
              const f = fmt(cell);
              const def = isDefinitional(h.check, arm);
              return (
                <div class="v-run">
                  <div class="v-run__head">
                    <span class="v-run__name">{arms.find((a) => a.id === arm)!.label}</span>
                    <span class="v-run__val"><b>{f.text}</b>{def === 'full' ? ', definitional' : def === 'partial' ? ', partly definitional' : ''}</span>
                  </div>
                  <div class="v-meter"><div class={`v-meter__fill${def ? ' is-muted' : ''}`} style={`--w:${f.pct}%`}></div></div>
                </div>
              );
            })}
          </div>
        ))}

        <div class="bm-block">
          <p class="v-label bm-block__k">{comp.label}, derived</p>
          {(['armA', 'armB', 'armC'] as const).map((arm) => {
            const f = fmt(comp[arm]);
            return (
              <div class="v-run">
                <div class="v-run__head">
                  <span class="v-run__name">{arms.find((a) => a.id === arm)!.label}</span>
                  <span class="v-run__val"><b>{f.text}</b></span>
                </div>
                <div class="v-meter"><div class="v-meter__fill" style={`--w:${f.pct}%`}></div></div>
              </div>
            );
          })}
          <p class="v-small bm-mt3">{comp.provenance}</p>
        </div>
      </div>
      <div class="v-readout__foot">Counts are out of {g.n_per_arm} runs per condition, pooled across both models and all three cases. Source: adjudicated grid, {d.adjudicatedOn}.</div>
    </div>

    <ul class="bm-status">{statusItems.map((s) => <li>{s}</li>)}</ul>
  </div>
</section>

<!-- 2. WHY THIS IS THE FAIR COMPARISON -->
<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">The comparison</p>
    <h2 class="v-h2">The comparison is against an operator who has already pasted in every fact.</h2>

    <p class="v-lead bm-mt5">The objection this page has to answer is not someone typing one lazy question. It is you, doing your job, pasting in what you already know before you ask. That reader is the all-facts condition, and it is the condition this page reports hardest.</p>

    <ul class="v-caplist bm-caplist">
      {arms.map((a, i) => (
        <li class="v-caprow">
          <span class="v-index">/{String.fromCharCode(65 + i)}</span>
          <h3>{a.label}</h3>
          <p class="v-small">{a.note}</p>
        </li>
      ))}
    </ul>

    <p class="v-small bm-mt5">The third condition is named for the file that was tested. The Decision is that file, plain markdown that you paste into the AI account you already use, so nothing is installed and the decision stays in your account. The Decision Brief is the output it produces. The Decision Frame, at the foot of this page, is a free one-page worksheet and a different thing again.</p>

    <div class="v-card v-card--fill bm-mt5">
      <p class="v-label">Why that is a fair comparison</p>
      <p class="bm-mt3">{parity().statement}</p>
      <p class="bm-mt3">The frozen prompt is {parity().frozen_prompt.toLowerCase()}</p>
      <p class="bm-mt3">The answering rule is not a courtesy. The protocol fixes it and publishes it: {pq.answering_rule.text}</p>
      <p class="v-small bm-mt3">Source: {parity().source}, hashed and frozen at commit {p.short}.</p>
    </div>

    <p class="bm-mt5">The loaded condition and the question-only condition start from the same input. The all-facts condition does not. So the comparison that carries the product claim is the loaded condition against the all-facts condition on the result, and against the question-only condition on the starting position.</p>

    <p class="bm-mt4">The question-only condition scored {fmt(c6.armA).text} on the hidden-decision check, and that zero is not evidence of anything. It is an artefact of the design, for the reason set out in the next section, and it is not a measurement of baseline judgement.</p>
  </div>
</section>

<!-- 3. THE KEY CHECKS, IN ONE VIEW -->
<section class="v-section">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">The result</p>
    <h2 class="v-h2">The pre-registered result is checks 6 and 7, and the informed baseline is above the loaded file on one of them.</h2>

    <p class="v-lead bm-mt5">The scoring rubric pre-registers those two checks as the primary result. On surfacing the hidden decision, the informed baseline scored {fmt(c6.armB).text} and the loaded file {fmt(c6.armC).text}. The informed baseline is above the loaded file, and it held the complete fact sheet before it answered.</p>

    <figure class="bm-fig">
      <figcaption class="bm-fig__read">Surfacing the hidden decision. The all-facts condition was handed the facts. The loaded condition had to ask for them.</figcaption>
      <div class="bm-mx" role="img" aria-label={`Surfaced the hidden decision. Question only, ${fmt(c6.armA).text}, definitional. All facts, ${fmt(c6.armB).text}. The Decision loaded, ${fmt(c6.armC).text}.`}>
        {(['armA', 'armB', 'armC'] as const).map((arm) => {
          const cell = c6[arm];
          const def = isDefinitional(c6, arm);
          let drawn = 0;
          return (
            <div class="bm-mx__row">
              <span class="bm-mx__lab">{arms.find((a) => a.id === arm)!.label}</span>
              <span class="bm-mx__n"><b>{fmt(cell).text}</b>{def === 'full' ? <em> definitional</em> : null}</span>
              <span class="bm-strip" aria-hidden="true">
                {caseSizes.map((size) => (
                  <span class="bm-grp">
                    {Array.from({ length: size }).map(() => {
                      const met = drawn++ < cell.met;
                      return <span class={`bm-c${met ? ' is-met' : ''}${def === 'full' ? ' is-def' : ''}`}></span>;
                    })}
                  </span>
                ))}
              </span>
            </div>
          );
        })}
      </div>
      <figcaption class="v-small">One cell per run, grouped by case, {caseSizes.join(' / ')}. Fill shows the count, not which specific runs passed. Source: adjudicated grid, {d.adjudicatedOn}.</figcaption>
    </figure>

    <div class="bm-note bm-mt5"><p class="v-small">{c6.definitional_note}</p></div>

    <h3 class="v-h3 bm-mt6">The informed baseline against the loaded file, on all {cmp.total} checks</h3>
    <div class="bm-tw">
      <table class="v-table bm-t">
        <thead>
          <tr><th scope="col">Check</th><th scope="col" class="num">All facts</th><th scope="col" class="num">Loaded</th><th scope="col">Reading</th></tr>
        </thead>
        <tbody>
          {checks().map((c) => (
            <tr>
              <th scope="row">{c.page_label}</th>
              <td class="num">{fmt(c.armB).text}{isDefinitional(c, 'armB') === 'full' ? <span class="bm-def">def</span> : null}</td>
              <td class="num">{fmt(c.armC).text}</td>
              <td class="v-small">{
                isDefinitional(c, 'armB') === 'full' ? 'Definitional on the all-facts cell'
                : c.armB.met === c.armC.met ? 'Equal'
                : c.armB.met > c.armC.met ? 'Informed baseline above'
                : 'Loaded file above'
              }</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="bm-mt5">The informed baseline returned the same count as the loaded file on {spell(cmp.tied.length)} of the {spell(cmp.total)} checks, and a higher count on {spell(cmp.baselineHigher.length)}. The loaded file is above it on {spell(cmp.loadedHigherMeasured.length)} measured checks: comparing real options including doing nothing, and tagging its evidence. The next section sets out what those are worth and what they are not.</p>

    <p class="bm-mt4">The remaining check, asking before answering, also shows a gap, and it is deliberately not counted above. The all-facts condition is single-turn by construction and cannot pass it, so that gap restates the design of the test rather than measuring anything. Counting it as a win would repeat the error this page records as departure 1.</p>

    <p class="bm-mt4">Some of these counts do not separate the conditions at all. Stating what would change the call sits at {fmt(check('c5').armA).text}, {fmt(check('c5').armB).text} and {fmt(check('c5').armC).text} across the three conditions, so it discriminates nowhere. Naming an untested constraint, direction, and catching the planted bias are all equal between the informed baseline and the loaded file.</p>

    <p class="v-small bm-mt4">The full grid, every departure from the pre-registration, and the adjudication record for every disputed cell are further down this page.</p>
  </div>
</section>

<!-- 4. WHAT THE DISCIPLINE ACTUALLY BUYS -->
<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">What it buys</p>
    <h2 class="v-h2">The file produced a complete brief from a short question, on every run, where the informed baseline produced none.</h2>

    <figure class="bm-fig bm-mt5">
      <figcaption class="bm-fig__read">{comp.label}, derived.</figcaption>
      <div class="bm-mx" role="img" aria-label={`${comp.label}. Question only, ${fmt(comp.armA).text}. All facts, ${fmt(comp.armB).text}. The Decision loaded, ${fmt(comp.armC).text}.`}>
        {(['armA', 'armB', 'armC'] as const).map((arm) => {
          const cell = comp[arm];
          let drawn = 0;
          return (
            <div class="bm-mx__row">
              <span class="bm-mx__lab">{arms.find((a) => a.id === arm)!.label}</span>
              <span class="bm-mx__n"><b>{fmt(cell).text}</b></span>
              <span class="bm-strip" aria-hidden="true">
                {caseSizes.map((size) => (
                  <span class="bm-grp">
                    {Array.from({ length: size }).map(() => <span class={`bm-c${drawn++ < cell.met ? ' is-met' : ''}`}></span>)}
                  </span>
                ))}
              </span>
            </div>
          );
        })}
      </div>
      <figcaption class="v-small">{comp.provenance} Source: adjudicated grid, {d.adjudicatedOn}.</figcaption>
    </figure>

    <div class="v-card v-card--fill bm-mt5">
      <p class="v-small">This composite is gated by a definitional cell, check {comp.gated_by}, because a single-turn condition cannot ask before answering. Recomputed over the four remaining checks the figures do not move, at {comp.recomputed_without_c1.armA} of {g.n_per_arm}, {comp.recomputed_without_c1.armB} of {g.n_per_arm} and {comp.recomputed_without_c1.armC} of {g.n_per_arm}.</p>
      <p class="v-small bm-mt3">{comp.recomputed_note}</p>
    </div>

    <p class="bm-mt5">What the file changes is the input it can start from. The informed baseline reaches its results from a complete fact sheet. The loaded file reaches them from the short question, and it produced a brief with its options, evidence tags and change criteria attached in {fmt(comp.armC).text} runs, where the informed baseline produced one in {fmt(comp.armB).text}.</p>

    <p class="bm-mt4">For a reader preparing a paper, that is the concrete difference: options that include doing nothing, compared on stated criteria; every fact carrying an evidence tag showing where it came from; and named criteria for what would change the call. From a short question, without first assembling the fact sheet.</p>

    <h3 class="v-h3 bm-mt6">The limit on that claim</h3>
    <p class="bm-mt3">Asking first, comparing options and tagging evidence are the three behaviours the file instructs the model to perform, and they are the three that separate cleanly. They are evidence that the file was followed. They are not evidence that the model reasoned better.</p>

    <p class="bm-mt4">The grid ran the three conditions set out above. A fourth condition, in which a competent operator writes those instructions themselves and gets the same behaviour without the file, was not among them and has not been run.</p>
  </div>
</section>

<!-- 5. EXTERNAL KNOWLEDGE, TOOL USE, AND CASE B -->
<section class="v-section">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">External knowledge</p>
    <h2 class="v-h2">Outside Case B, direction did not separate a short question from the loaded file.</h2>

    <p class="v-lead bm-mt5">Check 7 asks whether the recommendation pointed the same way as the sealed key. Split by case, the aggregate figure comes apart. {dbc.note}</p>

    <div class="bm-tw bm-mt5">
      <table class="v-table bm-t">
        <thead>
          <tr><th scope="col">Case</th><th scope="col" class="num">Question only</th><th scope="col" class="num">All facts</th><th scope="col" class="num">Loaded</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Cases A and C</th>
            <td class="num">{fmt(dbc.cases_A_and_C.armA).text}</td>
            <td class="num">{fmt(dbc.cases_A_and_C.armB).text}</td>
            <td class="num">{fmt(dbc.cases_A_and_C.armC).text}</td>
          </tr>
          <tr>
            <th scope="row">Case B, Larkfield</th>
            <td class="num">{fmt(dbc.case_B.armA).text}</td>
            <td class="num">{fmt(dbc.case_B.armB).text}</td>
            <td class="num">{fmt(dbc.case_B.armC).text}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="v-small bm-mt3">Check 7, split by case. Source: adjudicated grid, {d.adjudicatedOn}.</p>

    <div class="bm-note bm-mt5"><p class="v-small">{dbc.reading}</p></div>

    <h3 class="v-h3 bm-mt6">Case B, and what contaminated it</h3>
    <p class="bm-mt3">Case B is the GO case: {gc.label.replace('Case B, Larkfield: ', '')}. {gc.note}</p>

    <p class="bm-mt4">Question only reached the key direction in {fmt(gc.armA).text} runs. All facts in {fmt(gc.armB).text}. Loaded in {fmt(gc.armC).text}. Supplying the fact sheet was sufficient on this case.</p>

    <p class="bm-mt4">Those question-only runs were not clean. ChatGPT invoked live web search unprompted during them, and they carry the whole of the direction deficit reported anywhere on this site. The departure is recorded in full as departure 17 below.</p>

    <h3 class="v-h3 bm-mt6">Case B is also the case where the file adds least</h3>
    <p class="bm-mt3">The protocol required that case to be identified and it never has been until now. With every fact supplied, the informed baseline matched the loaded file exactly, {fmt(gc.armB).text} on direction against {fmt(gc.armC).text}, on both models. The same qualifier applies here that this page applies to any favourable sentence: that is one case at n = {gc.armA.n} per condition, and the generalisation is weak in both directions.</p>

    <h3 class="v-h3 bm-mt6">Case design and the substrate</h3>
    <p class="bm-mt3">{pq.case_design.text} That is stated on the methodology page and it is the reason the answer key holds: search cannot retrieve the sealed case facts. It is not the same as saying the conditions were clean, and on Case B they were not. The question-only runs described above still reached live web search, so they were not the no-context condition the protocol describes. Both halves are true and neither stands alone.</p>

    <p class="bm-mt4">The protocol set controls for a clean substrate: {pq.substrate.text}</p>

    <p class="bm-mt4">{pq.substrate_actual}</p>

    <div class="bm-note bm-mt5"><p class="v-small">{tx.withdrawn_note}</p></div>
  </div>
</section>

<!-- 6. THE LIMITS -->
<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">Limits</p>
    <h2 class="v-h2">This benchmark cannot tell you whether the file helps a real operator.</h2>

    <div class="v-card bm-mt5">
      <p class="v-label">The condition the product exists for, and the one that was not run</p>
      <p class="bm-mt3">The first limitation below is the one that matters most, and it is the reason this page cannot tell you what you came to find out. The condition the product exists for, an operator holding most of what matters with a blind spot they cannot see, has not been run. It is the next required test, and it is what would settle the question this grid cannot.</p>
      <p class="bm-mt3">A second condition is also missing. A competent operator writing the equivalent instructions themselves, without the file, was not one of the three conditions and has not been run. Until it is, this page cannot tell you whether the file is doing something an operator could not do for themselves.</p>
    </div>

    <h3 class="v-h3 bm-mt6">What this benchmark cannot tell you</h3>
    <ul class="v-leadlist bm-mt4">
      {limitations().map((l, i) => <li><strong>{limitationLeads[i]}</strong> {l}</li>)}
    </ul>

    <h3 class="v-h3 bm-mt6">The refresh commitment has lapsed on both model legs</h3>
    <p class="bm-mt3">GreenSquare AI commits to re-running this benchmark within {r.commitmentDays} days of a major model release. The grid was scored on {d.scoredOn} against {g.models[0].name} and {g.models[1].name}. Both have since been superseded and both windows have expired.</p>

    <p class="bm-mt4"><strong>The OpenAI leg.</strong> {openai.tested_model} was superseded by {openai.superseded_by} on {openai.releasedOn}, {openai.daysSinceRelease} days before {d.currentAsAt}. The {r.commitmentDays} day window expired on {openai.dueOn}. As at {d.currentAsAt} the re-run is {openai.daysPastDue} days past that deadline. Source strength on this leg is {openai.source_strength}. {openai.caveat}</p>

    <p class="bm-mt4"><strong>The Anthropic leg.</strong> {anthropic.tested_model} was superseded by {anthropic.superseded_by} on {anthropic.releasedOn}, {anthropic.daysSinceRelease} days before {d.currentAsAt}. The {r.commitmentDays} day window expired on {anthropic.dueOn}. As at {d.currentAsAt} the re-run is {anthropic.daysPastDue} days past that deadline. Source strength on this leg is {anthropic.source_strength}. {anthropic.caveat}</p>

    <p class="bm-mt4">No re-run date is published. Until one is, every figure on this page is a measurement of {g.models[0].name} and {g.models[1].name} as at {d.scoredOn} and should be read as historical.</p>
  </div>
</section>

<!-- 7. VERIFICATION -->
<section class="v-section">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">Verify</p>
    <h2 class="v-h2">Every input can be verified today, and no result can be re-scored outside GreenSquare AI.</h2>

    <p class="v-lead bm-mt5">The pre-registration commit is <code class="bm-hash">{p.full}</code>. It was authored at {p.authoredAtTime} and committed at {p.committedAtTime}. A committer timestamp is not proof of push time, and this page does not claim one.</p>

    <p class="bm-mt4">If you tried to verify this benchmark before and could not, the reason is departure 3. The commit ID published until now is in no ref in the repository, and the procedure failed at its first step. That failure would have looked like your mistake. It was not.</p>

    <p class="bm-mt4">Six inputs were hashed and frozen before the first scored run, and all six SHA-256 values match their files when read with {hi.line_endings} line endings. If you hash with CRLF you will get six different values, for a reason that has nothing to do with this benchmark.</p>

    <div class="bm-tw bm-mt5">
      <table class="v-table bm-t">
        <thead><tr><th scope="col">File</th><th scope="col">SHA-256</th></tr></thead>
        <tbody>
          {hi.files.map((f) => (
            <tr><th scope="row"><code class="bm-hash">{f.file}</code></th><td><code class="bm-hash">{f.sha256}</code></td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="bm-mt4">The product under test is <code class="bm-hash">{hi.product_file}</code>, SHA-256 <code class="bm-hash">{hi.product_sha256}</code>. {hi.product_withheld_note}</p>

    <h3 class="v-h3 bm-mt6">The sealed key</h3>
    <p class="bm-mt3">The sealed reference answers hash to <code class="bm-hash">{sk.sha256}</code>. That value was verified against the pre-registration table, on both LF and CRLF line endings. The key was fixed before any run and has not been altered.</p>
    <p class="bm-mt3">The key itself is not published. While it is withheld, that verification cannot be repeated by anyone outside GreenSquare AI.</p>

    <div class="bm-note bm-mt5">
      <p class="v-small">There is a limit to what you can check today, and it is a large one. No transcript is published. The sealed reference answers are not published. Nobody outside GreenSquare AI can re-score a single run or confirm a single adjudicated cell. Those are departures 4 and 5, and they are recorded below with the rest.</p>
      <p class="v-small bm-mt3">Benchmark results have been removed from the other pages of this site rather than updated, so this page is the only record of them. The methodology page describes the method and the grid’s history and points here for the figures.</p>
    </div>

    <h3 class="v-h3 bm-mt6">The six artefacts</h3>
    <ul class="bm-art">
      {artefacts.map((a) => (
        <li>
          <a href={p.fileUrl(a.path)} target="_blank" rel="noopener">
            <span><b>{a.title}</b><em>{a.sub}</em></span>
            <span class="bm-art__go">View</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="v-small bm-mt3">Every link is pinned to commit {p.short}, not to the current branch, so a later edit cannot change what was verified.</p>
  </div>
</section>

<!-- 8. EVERY DEPARTURE, AND THE FULL GRID -->
<section class="v-section v-off">
  <div class="v-container v-container--narrow">
    <p class="v-label v-eyebrow">The record</p>
    <h2 class="v-h2">The grid departed from the pre-registration and the published record in {deviations().length} places.</h2>

    <p class="v-lead bm-mt5">All {deviations().length} are listed here in full, ranked by how much damage each does when someone hostile finds it. None is softened and none is omitted. They sit at this point in the page rather than above the result, which is a change from the previous version of this page, and the reason is that the result should be readable before the record of what went wrong with it.</p>

    <h3 class="v-h3 bm-mt6">The grid is not balanced across cases or models</h3>
    <p class="bm-mt3">{g.runs_total} runs, {g.n_per_arm} per condition. Case A ran on ChatGPT only, {g.cases[0].n_per_arm * 3} runs. Cases B and C ran on both models. Each condition’s n of {g.n_per_arm} is {caseSizes.join(', ')} across the three cases, and Case A carries no Claude leg.</p>

    <p class="bm-mt4">Claude runs on Case A exist. They are design-phase pilot runs, {spell(g.excluded.pilot_runs)} of them, excluded here. {g.excluded.reason} Departure 2 sets out what happened to the record of that exclusion. The figure previously published was {g.retired.runs_total} runs: {g.retired.reason}</p>

    <p class="bm-mt4">A third model was pre-registered and never run. {g.planned_models[0].name} sits at status {g.planned_models[0].status.replace('_', ' ')}, so every count on this page pools {g.models[0].name} and {g.models[1].name} only.</p>

    <p class="bm-mt4">The rubric names per-case, per-condition counts as the headline unit. This page publishes two such cuts: Case B in full, and direction split by case. The other seven checks are still aggregate only, and the pre-registration required them per case. Until they are published, read every aggregate here as an average over an unbalanced grid.</p>

    <p class="bm-mt4">No per-model split is published. The one per-model statement on this page is Case B, where the informed baseline and the loaded file tied on both.</p>

    <h3 class="v-h3 bm-mt6">All {cmp.total} checks, with every disputed cell adjudicated</h3>
    <p class="bm-mt3">Counts are out of {g.n_per_arm} per condition, pooled across both models and all three cases. Five cells the two scoring passes disagreed on were adjudicated on {d.adjudicatedOn} against the sealed reference answers. No cell is withheld.</p>

    <div class="bm-tw bm-mt4">
      <table class="v-table bm-t">
        <thead>
          <tr><th scope="col">Check</th><th scope="col" class="num">Question only</th><th scope="col" class="num">All facts</th><th scope="col" class="num">Loaded</th></tr>
        </thead>
        <tbody>
          {checks('process').map((c) => (
            <tr>
              <th scope="row">{c.page_label}</th>
              {(['armA', 'armB', 'armC'] as const).map((arm) => {
                const def = isDefinitional(c, arm);
                return <td class="num">{fmt(c[arm]).text}{def === 'full' ? <span class="bm-def">def</span> : def === 'partial' ? <span class="bm-def">part</span> : null}</td>;
              })}
            </tr>
          ))}
          <tr class="bm-comp-row">
            <th scope="row">{comp.label}, derived</th>
            <td class="num">{fmt(comp.armA).text}</td>
            <td class="num">{fmt(comp.armB).text}</td>
            <td class="num">{fmt(comp.armC).text}</td>
          </tr>
          {checks('judgment').map((c) => (
            <tr>
              <th scope="row">{c.page_label}</th>
              {(['armA', 'armB', 'armC'] as const).map((arm) => {
                const def = isDefinitional(c, arm);
                return <td class="num">{fmt(c[arm]).text}{def === 'full' ? <span class="bm-def">def</span> : def === 'partial' ? <span class="bm-def">part</span> : null}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="v-small bm-mt3">A cell marked <span class="bm-def">def</span> is an artefact of the test design, not a measurement. A cell marked <span class="bm-def">part</span> is partly so. {comp.provenance}</p>

    <div class="bm-notes bm-mt5">
      {checks().filter((c) => c.definitional_note && c.id !== 'c6').map((c) => (
        <p class="v-small"><span class="bm-nk">{c.page_label}.</span> {c.definitional_note}</p>
      ))}
      <p class="v-small"><span class="bm-nk">Surfaced the hidden decision.</span> The definitional note for this check is set out with the result above, and is not repeated here.</p>
      {checks().filter((c) => c.adjudication).map((c) => (
        <p class="v-small"><span class="bm-nk">{c.page_label}, adjudication.</span> {c.adjudication}</p>
      ))}
      {checks().filter((c) => c.caveat).map((c) => (
        <p class="v-small"><span class="bm-nk">{c.page_label}, caveat.</span> {c.caveat}</p>
      ))}
      <p class="v-small"><span class="bm-nk">Partial passes.</span> This table shows full passes only. The protocol requires baseline partial counts reported prominently, per case, and the rubric describes the full versus partial distinction as the core of the benchmark. No partial count is published anywhere on this site, including here.</p>
      <p class="v-small"><span class="bm-nk">What the first three checks measure.</span> The first three checks are behaviours the file mandates, which is why they separate cleanly. What that is worth, and what it is not evidence of, is set out with the result above and again in the limitations.</p>
      <p class="v-small"><span class="bm-nk">The zero that was once the headline.</span> The question-only condition’s {fmt(c6.armA).text} on the hidden-decision check is definitional, for the reason set out with the result above. It was previously the headline number of this benchmark and it should never have been used that way.</p>
    </div>

    <h3 class="v-h3 bm-mt6">{deviations().length} departures from the pre-registration and the published record</h3>
    <ol class="bm-dev">
      {deviations().map((dev) => (
        <li>
          <span class="v-index">{String(dev.n).padStart(2, '0')}</span>
          <div>
            <h4>{dev.title}</h4>
            <p class="v-small">{dev.detail}</p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="v-h3 bm-mt6">Two obligations were met exactly</h3>
    <ul class="v-leadlist bm-mt4">
      {cleanItems().map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

