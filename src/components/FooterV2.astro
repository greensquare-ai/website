---
import { withBase } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="v-footer">
  <div class="v-container">
    <div class="v-footer__top">
      <div>
        <a class="v-footer__brand" href={withBase('/')} aria-label="GreenSquare AI home">
          <img src={withBase('/assets/logo-mark.svg')} alt="" width="24" height="24" />
          <span>GreenSquare AI</span>
        </a>
        <p style="margin-top:var(--v-4); color:var(--v-cream-faint); font-size:var(--vs-small); max-width:34ch;">
          Decision discipline for the AI you already use.
        </p>
      </div>
      <div class="v-footer__cols">
        <div class="v-footer__col">
          <h4>Product</h4>
          <a href={withBase('/benchmark/')}>Compass</a>
          <a href={withBase('/decision-frame/')}>Lens 4.0, the free worksheet</a>
        </div>
        <div class="v-footer__col">
          <h4>Evidence</h4>
          <a href={withBase('/methodology/')}>Methodology</a>
        </div>
        <div class="v-footer__col">
          <h4>Legal</h4>
          <a href={withBase('/legal/privacy/')}>Privacy</a>
          <a href={withBase('/legal/terms/')}>Terms</a>
          <a href={withBase('/legal/cookies/')}>Cookies</a>
        </div>
      </div>
    </div>
    <div class="v-footer__legal">
      <span>&copy; {year} GreenSquare AI</span>
      <span>hello@greensquare.ai</span>
    </div>
  </div>
</footer>
