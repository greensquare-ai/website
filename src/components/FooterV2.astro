          <img src="/assets/logo-mark.svg" alt="" width="24" height="24" />
          <span>GreenSquare</span>
        </a>
        <p class="v-mono" style="margin-top:var(--v-4); color:var(--v-cream-faint); letter-spacing:0.06em; max-width:30ch;">
