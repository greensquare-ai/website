---
const year = new Date().getFullYear();
---
<footer class="v-footer">
  <div class="v-container">
    <div class="v-footer__top">
      <div>
        <a class="v-footer__brand" href="/" aria-label="GreenSquare home">
          <img src="/assets/logo-mark-lime.svg" alt="" width="24" height="24" />
          <span>GreenSquare</span>
        </a>
        <p style="margin-top:var(--v-4); color:var(--v-cream-faint); font-size:var(--vs-small); max-width:34ch;">
          Decision infrastructure for Claude, GPT and Gemini.
        </p>
      </div>
      <div class="v-footer__cols">
        <div class="v-footer__col">
          <h4>Product</h4>
          <a href="/product/">The Decision</a>
          <a href="/decision-frame/">Free Decision Frame</a>
        </div>
        <div class="v-footer__col">
          <h4>Benchmark</h4>
          <a href="/benchmark/">Benchmark</a>
          <a href="/methodology/">Methodology</a>
        </div>
        <div class="v-footer__col">
          <h4>Legal</h4>
          <a href="/legal/privacy/">Privacy</a>
          <a href="/legal/terms/">Terms</a>
          <a href="/legal/cookies/">Cookies</a>
        </div>
      </div>
    </div>
    <div class="v-footer__legal">
      <span>&copy; {year} GreenSquare</span>
      <span>hello@greensquare.ai</span>
    </div>
  </div>
</footer>
