---
import { withBase } from '../lib/paths';
export interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const links = [
  { href: withBase('/'), label: 'Home', key: 'home' },
  { href: withBase('/benchmark/'), label: 'Benchmark', key: 'benchmark' },
  { href: withBase('/benchmark/'), label: 'Compass', key: 'product' },
  { href: withBase('/pricing/'), label: 'Pricing', key: 'pricing' },
];
---
<header class="site-header">
  <div class="container nav-row">
    <a class="brand" href={withBase('/')} aria-label="GreenSquare AI home">
      <img src={withBase('/assets/logo-mark.svg')} alt="" width="26" height="26" />
      <span class="brand-name">GreenSquare AI</span>
    </a>
    <div class="nav-right">
      <nav class="nav-links" aria-label="Primary" id="primary-nav">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <a class="btn btn-primary" href={withBase('/pricing/')}>Get Compass</a>
      <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" id="nav-toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  <nav class="nav-links-mobile" id="mobile-nav" aria-label="Primary mobile" hidden>
    <div class="container" style="display:flex; flex-direction:column; gap:16px; padding-block: 16px;">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn btn-primary" href={withBase('/pricing/')} style="width:fit-content;">Get Compass</a>
    </div>
  </nav>
</header>
<style>
  .nav-links-mobile { border-bottom: 1px solid var(--line); background: var(--bg); }
  .nav-links-mobile a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--size-small);
  }
  .nav-links-mobile a[aria-current='page'] { color: var(--accent); }
  @media (min-width: 861px) {
    .nav-links-mobile { display: none !important; }
  }
</style>
<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    if (mobile) mobile.hidden = expanded;
  });

  // Scroll state: the header gains a hairline and slight translucency once the page
  // moves. No-JS keeps the resting look. rAF-throttled.
  const header = document.querySelector('.site-header');
  if (header) {
    let ticking = false;
    const sync = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(sync); }
    }, { passive: true });
    sync();
  }
</script>
