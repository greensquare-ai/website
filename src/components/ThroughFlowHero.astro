---
/**
 * Founder-approved Through-flow V4 Passage for the homepage hero.
 *
 * The three SVG compositions are independently recomposed for their target
 * formats. Keep their geometry, clockwise gaps and motion sequence together.
 */
---

<div class="through-flow" aria-hidden="true">
  <svg class="through-flow__desktop" viewBox="0 0 920 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    <polyline points="380,0 380,330 740,330" style="--dy: -380px;"></polyline>
    <polyline points="830,0 830,600" style="--dy: -640px; --delay: 0.1s;"></polyline>
    <polyline points="920,690 560,690" style="--dx: 380px; --delay: 0.2s;"></polyline>
    <polyline points="470,1000 470,420" style="--dy: 600px; --delay: 0.3s;"></polyline>
    <polyline class="through-flow__continuing" points="0,510 920,510" style="--dx: -960px;"></polyline>
  </svg>

  <svg class="through-flow__tablet" viewBox="0 0 700 760" preserveAspectRatio="xMidYMid slice" focusable="false">
    <polyline points="305,0 305,250 565,250" style="--dy: -310px;"></polyline>
    <polyline points="630,0 630,445" style="--dy: -485px; --delay: 0.1s;"></polyline>
    <polyline points="700,510 435,510" style="--dx: 285px; --delay: 0.2s;"></polyline>
    <polyline points="370,760 370,315" style="--dy: 465px; --delay: 0.3s;"></polyline>
    <polyline class="through-flow__continuing" points="0,380 700,380" style="--dx: -740px;"></polyline>
  </svg>

  <svg class="through-flow__mobile" viewBox="0 0 390 560" preserveAspectRatio="xMidYMid slice" focusable="false">
    <polyline points="156,0 156,211 306,211" style="--dy: -271px;"></polyline>
    <polyline points="344,0 344,323" style="--dy: -363px; --delay: 0.1s;"></polyline>
    <polyline points="390,361 232,361" style="--dx: 178px; --delay: 0.2s;"></polyline>
    <polyline points="194,560 194,249" style="--dy: 331px; --delay: 0.3s;"></polyline>
    <polyline class="through-flow__continuing" points="0,286 390,286" style="--dx: -430px;"></polyline>
  </svg>
</div>

<style>
  .through-flow {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0b2313;
  }

  .through-flow svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .through-flow polyline {
    fill: none;
    stroke: #c9d8cd;
    stroke-width: 1.5;
    stroke-opacity: 0.55;
    vector-effect: non-scaling-stroke;
    animation: through-flow-enter 0.7s cubic-bezier(0.165, 0.84, 0.44, 1) var(--delay, 0s) both;
  }

  .through-flow .through-flow__continuing {
    stroke: #5ea983;
    stroke-opacity: 1;
    animation-duration: 1.4s;
    animation-delay: 0.8s;
    animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  }

  .through-flow svg.through-flow__tablet,
  .through-flow svg.through-flow__mobile {
    display: none;
  }

  @keyframes through-flow-enter {
    from { transform: translate(var(--dx, 0), var(--dy, 0)); }
    to { transform: none; }
  }

  @media (max-width: 1024px) {
    .through-flow svg.through-flow__desktop { display: none; }
    .through-flow svg.through-flow__tablet { display: block; }
  }

  @media (max-width: 900px) {
    :global(.js .hero-split__media:not(.is-visible)) .through-flow polyline {
      animation-play-state: paused;
    }
  }

  @media (max-width: 640px) {
    .through-flow svg.through-flow__tablet { display: none; }
    .through-flow svg.through-flow__mobile { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .through-flow polyline { animation: none; }
  }
</style>
