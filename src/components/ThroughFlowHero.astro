<style>
  .through-flow {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--v-green);
  }

  .through-flow svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .through-flow polyline {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* Both strokes were off-palette greens (#c9d8cd, #5ea983) that read as mud against
     the deep ground. The palette gives an approved pair for this surface: lime and
     white on forest. The paths not taken are white at low opacity; the one path that
     continues is lime, which is the only part of this graphic that should carry
     attention and previously did not. */
  .through-flow__neutral {
    stroke: var(--v-cream);
    stroke-opacity: 0.42;
  }

  .through-flow__continuing {
    stroke: var(--v-lime);
    stroke-opacity: 1;
  }

  .through-flow__still { display: none; }
  .through-flow__still .is-soft { stroke-opacity: 0.42; }
  .through-flow__still .is-softer { stroke-opacity: 0.36; }

  .through-flow svg.through-flow__tablet,
  .through-flow svg.through-flow__mobile {
    display: none;
  }

  @media (max-width: 1024px) {
    .through-flow svg.through-flow__desktop { display: none; }
    .through-flow svg.through-flow__tablet { display: block; }
  }

  @media (max-width: 640px) {
    .through-flow svg.through-flow__tablet { display: none; }
    .through-flow svg.through-flow__mobile { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .through-flow__motion { display: none; }
    .through-flow__still { display: block; }
  }

  .through-flow.is-static .through-flow__motion { display: none; }
  .through-flow.is-static .through-flow__still { display: block; }
</style>

<script>
  const passage = document.querySelector<HTMLElement>('[data-decision-passage]');

  if (passage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const animations = Array.from(passage.querySelectorAll<SVGAnimationElement>('animate, animateTransform'));
    const canBegin = animations.length > 0 && typeof animations[0]?.beginElement === 'function';

    if (!canBegin) {
      passage.classList.add('is-static');
    } else {
      let started = false;
      const start = () => {
        if (started) return;
        started = true;
        animations.forEach((animation) => animation.beginElement());
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            start();
            observer.disconnect();
          }
        }, { threshold: 0.08 });
        observer.observe(passage);
      } else {
        start();
      }
    }
  }
</script>
