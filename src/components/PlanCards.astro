---
/* The two plan cards from the approved Homepage design, shared by the homepage and
   /product/#plans so the pair reads the same in both places. The artwork is the only
   thing fixed here: each page supplies its own copy, status and call to action, because
   the homepage is an introduction and the product page is the reference.

   The two SVGs are drawn on a 400x500 grid but shown through a `0 60 400 500` window
   anchored to the top, which is what puts the horizon line across the middle of the card
   and lets the squares run off the bottom edge at any card height. */

export interface Plan {
  /** 'free' is the forest card, 'pro' the near-black one. */
  variant: 'free' | 'pro';
  title: string;
  body: string;
  /** Small label above the title. Omitted on the homepage. */
  status?: string;
  id?: string;
  cta?: {
    href: string;
    label: string;
    /** 'download' for getting Frame, 'arrow' for going elsewhere. */
    icon?: 'download' | 'arrow';
  };
}

export interface Props {
  plans: Plan[];
}

const { plans } = Astro.props;
---
<div class="plan-grid">
  {plans.map((plan) => (
    <article class:list={['plan-card', `plan-card--${plan.variant}`]} id={plan.id}>
      {plan.variant === 'free' ? (
        <svg class="plan-card__art" viewBox="0 60 400 500" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
          <line x1="0" y1="250" x2="400" y2="250" stroke="#ffffff" stroke-opacity="0.16" stroke-width="1" />
          <rect x="200" y="250" width="180" height="180" fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="0.6" />
          <rect x="245" y="295" width="135" height="135" fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="0.6" />
          <rect x="290" y="340" width="90" height="90" fill="#1b5433" />
          <rect x="335" y="385" width="45" height="45" fill="#dff49f" />
          <rect x="200" y="250" width="45" height="45" fill="#ffffff" fill-opacity="0.08" />
        </svg>
      ) : (
        <svg class="plan-card__art" viewBox="0 60 400 500" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
          <line x1="0" y1="250" x2="400" y2="250" stroke="#ffffff" stroke-opacity="0.16" stroke-width="1" />
          <rect x="200" y="250" width="180" height="180" fill="none" stroke="#ffffff" stroke-opacity="0.5" stroke-width="0.6" />
          <rect x="206" y="256" width="36" height="36" fill="none" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="5 5" />
          <rect x="250" y="256" width="36" height="36" fill="none" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="5 5" />
          <rect x="294" y="256" width="36" height="36" fill="none" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="5 5" />
          <rect x="338" y="256" width="36" height="36" fill="#ffffff" fill-opacity="0.08" />
          <rect x="206" y="300" width="36" height="36" fill="none" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="5 5" />
          <rect x="250" y="300" width="36" height="36" fill="#ffffff" fill-opacity="0.08" />
          <rect x="294" y="300" width="36" height="36" fill="#ffffff" fill-opacity="0.08" />
          <rect x="338" y="300" width="36" height="36" fill="#ffffff" fill-opacity="0.22" />
          <rect x="206" y="344" width="36" height="36" fill="#ffffff" fill-opacity="0.08" />
          <rect x="250" y="344" width="36" height="36" fill="#ffffff" fill-opacity="0.22" />
          <rect x="294" y="344" width="36" height="36" fill="#ffffff" fill-opacity="0.45" />
          <rect x="338" y="344" width="36" height="36" fill="#ffffff" fill-opacity="0.45" />
          <rect x="206" y="388" width="36" height="36" fill="#ffffff" fill-opacity="0.22" />
          <rect x="250" y="388" width="36" height="36" fill="#ffffff" fill-opacity="0.45" />
          <rect x="294" y="388" width="36" height="36" fill="#ffffff" fill-opacity="0.45" />
          <rect x="338" y="388" width="36" height="36" fill="#ffffff" />
        </svg>
      )}
      <div class="plan-card__body">
        {plan.status && <span class="plan-card__status">{plan.status}</span>}
        <h3>{plan.title}</h3>
        <p>{plan.body}</p>
      </div>
      <div class="plan-card__actions">
        {plan.cta && (
          <a class="v-btn v-btn--on-green plan-card__cta" href={plan.cta.href}>
            {plan.cta.label}
            {plan.cta.icon === 'download' && (
              <svg class="v-btn__icon v-btn__icon--trailing" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12" /><path d="M7.5 10.5 12 15l4.5-4.5" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
              </svg>
            )}
            {plan.cta.icon === 'arrow' && (
              <svg class="v-btn__icon v-btn__icon--trailing" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7" /><path d="M8 7h9v9" />
              </svg>
            )}
          </a>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: clamp(20px, 3vw, 32px); margin-top: clamp(40px, 5vw, 64px); }
  .plan-card {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    aspect-ratio: 4 / 5; padding: clamp(24px, 3vw, 44px); border-radius: 24px; overflow: hidden;
    color: var(--v-cream); --v-link-ink: var(--v-cream);
  }
  .plan-card--free { background: var(--v-green); }
  .plan-card--pro { background: var(--v-green-ink); }
  .plan-card__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .plan-card__body, .plan-card__actions { position: relative; }
  .plan-card__body { display: flex; flex-direction: column; gap: var(--v-3); }
  .plan-card__status { font-size: var(--vs-label); font-weight: 500; color: var(--v-cream-faint); }
  .plan-card h3 { color: var(--v-cream); font-size: clamp(1.3125rem, 1.2rem + 0.4vw, 1.5rem); line-height: 1.3; letter-spacing: -0.01em; }
  .plan-card p { margin: 0; max-width: 34ch; font-size: clamp(1.125rem, 1.05rem + 0.2vw, 1.25rem); line-height: 1.55; color: var(--v-cream-soft); }
  .plan-card__actions { display: flex; flex-wrap: wrap; gap: var(--v-3); padding-top: var(--v-6); }
  /* Both cards carry the same cream button. The design stopped distinguishing the Pro
     card with a ghost outline, so the two calls to action read as one pair. */
  .plan-card__cta { background: #e9e8e3; color: var(--v-ink); white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) {
    .plan-card__cta:hover { background: #fff; color: var(--v-ink); }
  }
  /* A card with no call to action would otherwise reserve the action row's padding and
     sit its copy higher than its neighbour. */
  .plan-card__actions:empty { display: none; }
</style>
