---
/**
 * In-page section index for the research pages.
 *
 * An opaque band that sits under the site nav, so it never floats over the content it
 * indexes. The previous floating pill rail was transparent at the edges and read over
 * the text scrolling beneath it.
 */
export interface Props {
  items: { id: string; label: string }[];
  label?: string;
}
const { items, label = 'On this page' } = Astro.props;
---
<nav class="section-nav" aria-label={label}>
  <div class="v-container section-nav__row">
    <span class="section-nav__label v-meta">{label}</span>
    <ul class="section-nav__list">
      {items.map((item) => (
        <li><a href={`#${item.id}`} data-section-link={item.id}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('.section-nav').forEach((nav) => {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
    const sections = links
      .map((link) => ({ link, section: document.getElementById(link.dataset.sectionLink ?? '') }))
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(entry.section));
    if (!sections.length) return;
    const line = 140;
    let ticking = false;
    const sync = () => {
      ticking = false;
      let current = sections[0];
      for (const entry of sections) {
        if (entry.section.getBoundingClientRect().top <= line) current = entry;
      }
      for (const entry of sections) {
        if (entry === current) entry.link.setAttribute('aria-current', 'location');
        else entry.link.removeAttribute('aria-current');
      }
      const list = nav.querySelector('.section-nav__list');
      if (list && list.scrollWidth > list.clientWidth) current.link.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
    sync();
  });
</script>

<style>
  .section-nav { position: sticky; top: 64px; z-index: 30; background: var(--v-paper); border-bottom: 1px solid var(--v-line); margin-top: var(--v-8); }
  .section-nav__row { display: flex; align-items: center; gap: var(--v-6); min-height: 48px; }
  .section-nav__label { flex: none; }
  .section-nav__list { display: flex; align-items: stretch; gap: var(--v-5); margin: 0; padding: 0; list-style: none; max-width: 100%; overflow-x: auto; scrollbar-width: none; min-height: 48px; }
  .section-nav__list::-webkit-scrollbar { display: none; }
  .section-nav__list a { display: flex; align-items: center; min-height: 48px; color: var(--v-ink-soft); font-size: var(--vs-small); font-weight: 500; text-decoration: none; white-space: nowrap; box-shadow: inset 0 -1px 0 transparent; transition: color var(--v-fast) var(--v-ease), box-shadow var(--v-fast) var(--v-ease); }
  .section-nav__list a:hover { color: var(--v-ink); }
  .section-nav__list a[aria-current='location'] { color: var(--v-ink); box-shadow: inset 0 -2px 0 var(--v-green); }
  @media (max-width: 640px) {
    .section-nav__label { display: none; }
    .section-nav__row { gap: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .section-nav__list a { transition: none; } }
</style>
