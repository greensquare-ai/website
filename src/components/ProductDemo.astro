---
/**
 * The published demonstration run, read as a working document in three states: the
 * question as it was brought, one turn of interrogation and what it changed, and the
 * brief that followed. Every quotation comes from src/data/demonstrations/demo-1.md
 * through src/data/brief-excerpt.ts; the annotations in the margin are the site's.
 */
import { briefExcerpt as b } from '../data/brief-excerpt';
import BriefExcerpt from './BriefExcerpt.astro';
const f = b.fields;
const i = b.interrogation;
const tabs = [
  { id: 'brought', label: 'The question as brought' },
  { id: 'interrogate', label: 'Interrogation' },
  { id: 'brief', label: 'Decision Brief' },
];
---
<section class="demo" data-product-demo aria-label="Demonstration run, read in three states">
  <div class="demo__tabs" role="tablist" aria-label="Demonstration state">
    {tabs.map((tab, index) => (
      <button type="button" role="tab" id={`demo-tab-${tab.id}`} aria-controls={`demo-panel-${tab.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-demo-tab={tab.id}>
        <span class="demo__index">{index + 1}</span>{tab.label}
      </button>
    ))}
  </div>

  <div role="tabpanel" id="demo-panel-brought" aria-labelledby="demo-tab-brought" data-demo-panel="brought">
    <div class="d-panel d-panel--ink">
      <div class="d-panel__head"><span><strong>{b.case}</strong> the operator's opening message</span><span>{b.provenance.kind}</span></div>
      <div class="d-panel__body demo__grid">
        <div>
          <p class="d-quote d-quote--large">What do I need to be able to defend the readiness call?</p>
          <p class="demo__context">{b.situation} The integrator has signed off, the test manager is not comfortable, and the only alternative anyone will agree to is a June window that falls after the old platform's support ends on 31 March.</p>
        </div>
        <aside class="demo__margin">
          <p class="v-meta">What the method does with this</p>
          <p>It does not answer. It asks six questions first: the test manager's specific objections, what the integrator signed off against, the rollback position, whether the 31 March date has been tested or assumed, why a phased cutover was ruled out, and what a failed weekend costs.</p>
          <p>It also names the framing for what it is: a request to support a conclusion already reached.</p>
        </aside>
      </div>
    </div>
  </div>

  <div role="tabpanel" id="demo-panel-interrogate" aria-labelledby="demo-tab-interrogate" data-demo-panel="interrogate" hidden>
    <div class="d-panel d-panel--ink">
      <div class="d-panel__head"><span><strong>{b.case}</strong> one of six questions, and the answer</span><span>{b.provenance.kind}</span></div>
      <div class="d-panel__body demo__grid">
        <div class="demo__exchange">
          <div><p class="v-meta">The method asks</p><p class="d-quote">{i.question}</p></div>
          <div><p class="v-meta">The operator answers</p><p class="demo__answer">{i.answer}</p></div>
          <div><p class="v-meta">The method reads it back</p><p class="d-quote">{i.consequence}</p></div>
        </div>
        <aside class="demo__margin">
          <p class="v-meta">What changed because of the answer</p>
          <ul class="demo__changes">
            <li><span class="d-tag d-tag--given">given</span><p>A vendor said no in March 2026.</p></li>
            <li><span class="d-tag d-tag--unknown">unknown</span><p>Whether extended support on the buyer's own instance can be bought. Nobody has asked.</p></li>
            <li><span class="demo__shift">Reframed</span><p>{i.reframe}</p></li>
          </ul>
        </aside>
      </div>
    </div>
  </div>

  <div role="tabpanel" id="demo-panel-brief" aria-labelledby="demo-tab-brief" data-demo-panel="brief" hidden>
    <div class="demo__brief-lead">
      <p class="v-meta">{f.decision.label}, as the brief restates it</p>
      <p class="d-quote">{f.decision.text}</p>
    </div>
    <BriefExcerpt />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-demo]').forEach((demo) => {
    const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-demo-tab]'));
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-panel]'));
    const activate = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.demoTab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.demoPanel !== id; });
      const url = new URL(window.location.href);
      url.searchParams.set('demo', id);
      window.history.replaceState({}, '', url);
    };
    const requested = new URLSearchParams(window.location.search).get('demo');
    if (requested && tabs.some((tab) => tab.dataset.demoTab === requested)) activate(requested);
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.demoTab ?? 'brought'));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next]?.dataset.demoTab ?? 'brought', true);
      });
    });
  });
</script>

<style>
  .demo__tabs { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--v-ink); border-bottom: 0; background: var(--v-panel); }
  .demo__tabs button { display: flex; align-items: center; gap: var(--v-3); min-height: 52px; padding: 0 var(--v-5); border: 0; border-right: 1px solid var(--v-line); background: transparent; color: var(--v-ink-soft); font: inherit; font-size: var(--vs-small); font-weight: 500; cursor: pointer; text-align: left; }
  .demo__tabs button:last-child { border-right: 0; }
  .demo__index { font-size: var(--vs-meta); font-variant-numeric: tabular-nums; }
  .demo__tabs button[aria-selected='true'] { color: var(--v-ink); font-weight: 600; box-shadow: inset 0 -2px 0 var(--v-green); }
  [role='tabpanel'][hidden] { display: none; }
  .demo__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(1.5rem, 4vw, 3.5rem); padding: var(--v-6) var(--v-5); }
  .demo__grid .d-quote { margin: 0 0 var(--v-4); }
  .demo__context { color: var(--v-ink-soft); font-size: var(--vs-small); }
  .demo__margin { border-left: 1px solid var(--v-line); padding-left: var(--v-5); font-size: var(--vs-small); }
  .demo__margin .v-meta { margin-bottom: var(--v-3); }
  .demo__margin p { max-width: none; }
  .demo__exchange > div { padding: var(--v-3) 0; border-top: 1px solid var(--v-line); }
  .demo__exchange > div:first-child { border-top: 0; padding-top: 0; }
  .demo__exchange .v-meta { margin-bottom: var(--v-2); }
  .demo__answer { font-size: var(--vs-small); margin: 0 0 var(--v-2); }
  .demo__changes { list-style: none; margin: 0; padding: 0; }
  .demo__changes li { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--v-3); padding: 10px 0; border-top: 1px solid var(--v-line); }
  .demo__changes p { margin: 0; }
  .demo__shift { font-size: var(--vs-meta); font-weight: 600; color: var(--v-signal); }
  .demo__brief-lead { padding: var(--v-5); border: 1px solid var(--v-ink); border-bottom: 0; background: var(--v-panel); }
  .demo__brief-lead .v-meta { margin-bottom: var(--v-2); }
  .demo__brief-lead .d-quote { margin: 0; max-width: 60ch; }
  @media (max-width: 800px) {
    .demo__tabs { grid-template-columns: 1fr; }
    .demo__tabs button { border-right: 0; border-bottom: 1px solid var(--v-line); }
    .demo__tabs button:last-child { border-bottom: 0; }
    .demo__grid { grid-template-columns: 1fr; padding: var(--v-5); }
    .demo__margin { border-left: 0; padding-left: 0; border-top: 1px solid var(--v-line); padding-top: var(--v-4); }
  }
</style>
