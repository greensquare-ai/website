---
export interface Props { current?: string; }
const { current = '' } = Astro.props;
const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/benchmark/', label: 'Benchmark', key: 'benchmark' },
  { href: '/product/', label: 'Product', key: 'product' },
  { href: '/pricing/', label: 'Pricing', key: 'pricing' },
];
---
<header class="v-nav">
  <div class="v-container v-nav__row">
    <a class="v-nav__brand" href="/" aria-label="GreenSquare home">
      <img src="/assets/logo-mark.svg" alt="" width="24" height="24" />
      <span>GreenSquare</span>
    </a>
    <div class="v-nav__right">
      <nav class="v-nav__links" aria-label="Primary">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <a class="v-btn v-btn--ghost" href="/pricing/">Get the Decision</a>
      <button class="v-nav__toggle" type="button" id="v-nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  <nav class="v-nav__drawer" id="v-nav-drawer" aria-label="Primary mobile" hidden>
    <div class="v-container">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="v-btn v-btn--green" href="/pricing/">Get the Decision</a>
    </div>
  </nav>
</header>
<style>
  .v-nav__drawer { background: var(--v-black); border-bottom: 1px solid var(--v-line-dark); }
  .v-nav__drawer .v-container { display: flex; flex-direction: column; gap: var(--v-4); padding-block: var(--v-5); }
  .v-nav__drawer a:not(.v-btn) { color: var(--v-cream-soft); text-decoration: none; font-weight: 500; font-size: var(--vs-small); }
  .v-nav__drawer a[aria-current='page'] { color: var(--v-cream); }
  .v-nav__drawer .v-btn { width: fit-content; }
  @media (min-width: 901px) { .v-nav__drawer { display: none !important; } }
</style>
