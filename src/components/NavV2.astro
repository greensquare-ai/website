---
import { withBase } from '../lib/paths';
export interface Props { current?: string; }
const { current = '' } = Astro.props;
const links = [
  { href: withBase('/'), label: 'Home', key: 'home' },
  { href: withBase('/product/'), label: 'The Decision', key: 'product' },
  { href: withBase('/benchmark/'), label: 'Benchmark', key: 'benchmark' },
];
---
<header class="v-nav">
  <div class="v-container v-nav__row">
    <a class="v-nav__brand" href={withBase('/')} aria-label="GreenSquare home">
      <img src={withBase('/assets/logo-mark.svg')} alt="" width="24" height="24" />
      <span>GreenSquare</span>
    </a>
    <div class="v-nav__right">
      <nav class="v-nav__links" aria-label="Primary">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free worksheet</a>
      <button class="v-nav__toggle" type="button" id="v-nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  <nav class="v-nav__drawer" id="v-nav-drawer" aria-label="Primary mobile">
    <div class="v-container">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="v-btn v-btn--green" href={withBase('/decision-frame/')}>Get the free worksheet</a>
    </div>
  </nav>
</header>
<style>
  .v-nav__drawer {
    background: var(--v-paper);
    border-bottom: 1px solid var(--v-line);
    opacity: 0;
    transform: translateY(-6px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--v-fast) var(--v-ease), transform var(--v-fast) var(--v-ease), visibility 0s linear var(--v-fast);
  }
  .v-nav__drawer.is-open {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
    transition: opacity var(--v-fast) var(--v-ease), transform var(--v-fast) var(--v-ease), visibility 0s linear;
  }
  .v-nav__drawer .v-container { display: flex; flex-direction: column; gap: var(--v-4); padding-block: var(--v-5); }
  .v-nav__drawer a:not(.v-btn) { color: var(--v-ink-soft); text-decoration: none; font-weight: 500; font-size: var(--vs-small); min-height: 44px; display: flex; align-items: center; }
  .v-nav__drawer a[aria-current='page'] { color: var(--v-green); }
  .v-nav__drawer .v-btn { width: fit-content; }
  @media (min-width: 901px) { .v-nav__drawer { display: none !important; } }
  @media (prefers-reduced-motion: reduce) {
    .v-nav__drawer {
      transform: none;
      transition: opacity var(--v-fast) linear, visibility 0s linear var(--v-fast);
    }
    .v-nav__drawer.is-open {
      transform: none;
      transition: opacity var(--v-fast) linear, visibility 0s linear;
    }
  }
</style>
