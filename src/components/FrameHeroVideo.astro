---
import { withBase } from '../lib/paths';
---

<figure
  class="frame-hero-video"
  aria-labelledby="frame-hero-video-description"
  data-frame-hero-figure
>
  <video
    data-frame-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    disablepictureinpicture
    tabindex="-1"
    aria-hidden="true"
  >
    <source
      src={withBase('/media/frame-animation-mobile.mp4')}
      type="video/mp4"
      media="(max-width: 767px)"
    />
    <source
      src={withBase('/media/frame-animation-desktop.mp4')}
      type="video/mp4"
      media="(min-width: 768px)"
    />
  </video>

  <picture class="frame-hero-video__still" aria-hidden="true">
    <source
      srcset={withBase('/media/frame-animation-mobile-poster.webp')}
      media="(max-width: 767px)"
    />
    <img
      src={withBase('/media/frame-animation-desktop-poster.webp')}
      width="1920"
      height="702"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </picture>

  <figcaption id="frame-hero-video-description" class="frame-hero-video__description">
    An illustrative business decision moves from growing demand and limited capacity to a sharper
    question, four tested options and a conditional recommendation to expand in stages only after
    management capacity is released.
  </figcaption>
</figure>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobileLayout = window.matchMedia('(max-width: 767px)');

  const syncFrameHeroVideo = (reload = false) => {
    document.querySelectorAll('[data-frame-hero-video]').forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      if (reload) video.load();
      if (reducedMotion.matches) {
        video.pause();
        return;
      }
      video.play().catch(() => {
        // Muted inline playback is expected to succeed. The static first frame remains if blocked.
      });
    });
  };

  reducedMotion.addEventListener('change', () => syncFrameHeroVideo());
  mobileLayout.addEventListener('change', () => syncFrameHeroVideo(true));
  document.addEventListener('astro:page-load', () => syncFrameHeroVideo());
  syncFrameHeroVideo();
</script>

<style>
  .frame-hero-video {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1920 / 702;
    margin: 0;
    overflow: hidden;
    background: var(--v-paper);
  }

  .frame-hero-video video,
  .frame-hero-video__still,
  .frame-hero-video__still img {
    width: 100%;
    height: 100%;
  }

  .frame-hero-video video,
  .frame-hero-video__still img {
    display: block;
    object-fit: contain;
  }

  .frame-hero-video__still {
    display: none;
  }

  .frame-hero-video__description {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .frame-hero-video {
      width: min(100%, 540px);
      aspect-ratio: 9 / 16;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame-hero-video video {
      display: none;
    }

    .frame-hero-video__still {
      display: block;
    }
  }
</style>
