---
/**
 * Figure 3, the Result / Prompt demonstration. Design specification section 6.
 *
 * A small vanilla-JavaScript island. No framework, no dependency. Every id is
 * prefixed with the instance id, and the script is delegated per instance, so a
 * second demonstration can be added to the same page without collision.
 *
 * The component knows nothing about the demonstration itself. The title, the
 * provenance, the produced brief and the transcript all arrive from the page.
 */

export type ProvenanceItem = {
  /** What the value is, e.g. "Model". Omit for a plain sentence. */
  label?: string;
  value: string;
  /** Tabular figures for a hash or a run identifier. */
  mono?: boolean;
  /** The full value, where the visible one is abbreviated. */
  title?: string;
};

export interface Props {
  /** Instance prefix for every id this component writes. */
  id?: string;
  /** The visible sentence title. The figure number comes from the CSS counter. */
  title: string;
  /** Accessible name for the tablist. */
  tablistLabel?: string;
  resultLabel?: string;
  promptLabel?: string;
  /**
   * The always-visible strip above both panels. Nothing here can be hidden by
   * switching tabs, so a reader who only ever sees the Result panel still sees
   * the model, the date, the hash and the scope.
   */
  provenance: ProvenanceItem[];
  /** The readout bar naming the transcript inside the Prompt panel. */
  transcriptTitle: string;
  /** Accessible name for the scrollable transcript region. */
  transcriptLabel: string;
  class?: string;
}

const {
  id = 'd1',
  title,
  tablistLabel = 'Demonstration run',
  resultLabel = 'Result',
  promptLabel = 'Prompt',
  provenance,
  transcriptTitle,
  transcriptLabel,
  class: className,
} = Astro.props;

const hasBasis = Astro.slots.has('basis');
---

<figure class:list={['bm-fig', 'bm-tabs', 'bm-breakout', className]}>
  <h3 class="bm-fig__title" id={`${id}-heading`}>{title}</h3>

  <div class="bm-tabs__prov">
    {provenance.map((item) =>
      item.mono ? (
        <span>{item.label ? `${item.label} ` : ''}<code class="v-mono" title={item.title}>{item.value}</code></span>
      ) : item.label ? (
        <span>{item.label} <b>{item.value}</b></span>
      ) : (
        <span>{item.value}</span>
      ),
    )}
  </div>

  {/* Result first and selected by default. The prompt is the receipt, not the lead. */}
  <div class="bm-tabs__list" role="tablist" aria-label={tablistLabel}>
    <button
      type="button"
      role="tab"
      id={`${id}-tab-result`}
      aria-controls={`${id}-panel-result`}
      aria-selected="true"
      tabindex="0"
      class="bm-tabs__tab"
    >{resultLabel}</button>
    <button
      type="button"
      role="tab"
      id={`${id}-tab-prompt`}
      aria-controls={`${id}-panel-prompt`}
      aria-selected="false"
      tabindex="-1"
      class="bm-tabs__tab"
    >{promptLabel}</button>
    <span class="bm-tabs__indicator" aria-hidden="true"></span>
  </div>

  {/* Both panels are rendered visible. The island hides the non-selected one as
      its first action, so with scripting off both stand stacked and headed. */}
  <div
    role="tabpanel"
    id={`${id}-panel-result`}
    aria-labelledby={`${id}-tab-result`}
    tabindex="0"
    class="bm-tabs__panel bm-tabs__panel--result"
  >
    <h4 class="bm-tabs__panelhead" hidden>{resultLabel}</h4>
    <div class="v-prose"><slot name="result" /></div>
  </div>

  <div
    role="tabpanel"
    id={`${id}-panel-prompt`}
    aria-labelledby={`${id}-tab-prompt`}
    tabindex="0"
    class="bm-tabs__panel bm-tabs__panel--prompt"
  >
    <h4 class="bm-tabs__panelhead" hidden>{promptLabel}</h4>
    <div class="v-readout">
      <div class="v-readout__bar">{transcriptTitle}</div>
      <div class="v-readout__body">
        <div class="bm-tabs__transcript" role="region" tabindex="0" aria-label={transcriptLabel}><slot name="prompt" /></div>
      </div>
    </div>
  </div>

  {hasBasis && (
    <p class="bm-fig__basis"><slot name="basis" /></p>
  )}
</figure>

<style>
  /* Figure numbers come from a counter reset on .bm-page. Section 2.6. */
  .bm-fig { margin: 0; counter-increment: bm-fig; }
  .bm-fig .bm-fig__title::before { content: 'Figure ' counter(bm-fig) '. '; }
  .bm-fig .bm-fig__title {
    margin: 0;
    font-family: var(--vf-body);
    font-size: var(--vs-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  /* Section 2.2. Both margins come from one variable, so they are equal by
     construction at every width. */
  .bm-breakout { width: min(1100px, 100%); margin-inline: auto; }
  @media (min-width: 1171px) {
    .bm-breakout {
      --bm-bw: min(1100px, calc(100vw - 2 * var(--v-gutter)));
      width: var(--bm-bw);
      margin-inline: calc((100% - var(--bm-bw)) / 2);
    }
  }

  .bm-fig .bm-fig__basis {
    margin: var(--v-3) 0 0;
    max-width: 72ch;
    font-size: var(--vs-small);
    color: var(--v-ink-soft);
  }

  /* ---------- provenance strip, section 6.1 ----------
     Ink-soft, not ink-faint: this strip's ground is --v-fill, where --v-ink-faint
     measures 4.38:1 and fails AA. */
  .bm-tabs__prov {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v-2) var(--v-5);
    padding: var(--v-3) var(--v-4);
    margin-top: var(--v-5);
    background: var(--v-fill);
    border-block: 1px solid var(--v-line);
    font-size: var(--vs-label);
    color: var(--v-ink-soft);
  }
  .bm-tabs__prov b { font-weight: 600; color: var(--v-ink); }
  .bm-tabs__prov code { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }

  /* ---------- tab list, section 6.1 ---------- */
  .bm-tabs__list {
    position: relative;
    gap: var(--v-5);
    margin-top: var(--v-6);
    border-bottom: 1px solid var(--v-line);
    /* so a focused tab's outline-offset is not clipped */
    overflow: visible;
  }
  .bm-tabs__tab {
    appearance: none;
    background: none;
    border: 0;
    border-radius: 0;
    padding: var(--v-3) 0;
    cursor: pointer;
    font-family: var(--vf-body);
    font-size: var(--vs-small);
    font-weight: 600;
    color: var(--v-ink-soft);
    transition: color var(--v-fast) var(--v-ease);
  }
  .bm-tabs__tab[aria-selected='true'] { color: var(--v-ink); }
  /* A 2px rule that slides, not a filled pill: this system is radius 0. */
  .bm-tabs__indicator {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--v-ink);
    width: 0;
    transform: translateX(0);
    transition: transform var(--v-fast) var(--v-ease), width var(--v-fast) var(--v-ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .bm-tabs__indicator { transition: none; }
    .bm-tabs__tab { transition: none; }
  }

  /* ---------- the script-off fallback, section 6.4 ----------
     BaseLayoutV2 adds .js to <html> before first paint, so this is pure CSS with
     no flash in either direction. */
  .bm-tabs .bm-tabs__list { display: none; }
  .bm-tabs .bm-tabs__panelhead { display: block; }
  :global(.js) .bm-tabs .bm-tabs__list { display: flex; }
  :global(.js) .bm-tabs .bm-tabs__panelhead { display: none; }
  .bm-tabs .bm-tabs__panelhead {
    margin: 0 0 var(--v-3);
    font-family: var(--vf-body);
    font-size: var(--vs-h4);
    font-weight: 600;
    line-height: 1.35;
  }

  /* ---------- panels, section 6.1 ---------- */
  .bm-tabs__panel { margin-top: var(--v-6); }
  @media (min-width: 760px) {
    /* so arrow-keying between panels does not reflow the page under the reader */
    .bm-tabs__panel { min-height: 28rem; }
  }
  /* The Result panel has no border. The Brief is the product's output and should
     read as page text, not as a specimen in a box. */
  .bm-tabs .bm-tabs__panel--result .v-prose { max-width: 72ch; }

  .bm-tabs__transcript {
    max-height: 32rem;
    overflow-y: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: var(--vs-small);
    line-height: 1.6;
  }
  @media (max-width: 759px) {
    .bm-tabs__transcript { max-height: 24rem; }
  }
</style>

<script>
  /* One delegated handler per tablist, resolved per instance, so several
     demonstrations on one page do not interfere. */
  document.querySelectorAll<HTMLElement>('.bm-tabs').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const indicator = root.querySelector<HTMLElement>('.bm-tabs__indicator');
    if (!list) return;

    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    if (tabs.length === 0) return;
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''));

    const place = (tab: HTMLElement, animate: boolean) => {
      if (!indicator) return;
      /* The first positioning must not animate, or the indicator slides in from
         the left edge on every page load. */
      if (!animate) indicator.style.transition = 'none';
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
      indicator.style.width = `${tab.offsetWidth}px`;
      if (!animate) {
        void indicator.offsetWidth;
        indicator.style.transition = '';
      }
    };

    const select = (index: number, options: { focus?: boolean; animate?: boolean } = {}) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        /* Roving tabindex: the tablist is one stop in the page's tab order. */
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        if (!panel) return;
        /* The hidden attribute, not a display class: it is what removes the panel
           from the accessibility tree and from tab order in every engine. */
        if (i === index) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });
      place(tabs[index], options.animate === true);
      /* Focus follows selection from the keyboard only. Calling focus on every
         click would raise a ring on a pointer user. */
      if (options.focus) tabs[index].focus();
    };

    list.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (!tab || !list.contains(tab)) return;
      select(tabs.indexOf(tab), { animate: true });
    });

    list.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      let next = -1;
      if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      /* Automatic activation: both panels are already in the DOM, so switching
         costs nothing and manual activation would only add a keystroke. */
      event.preventDefault();
      select(next, { focus: true, animate: true });
    });

    const initial = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    select(initial < 0 ? 0 : initial);

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(() => {
        const active = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
        if (active) place(active, false);
      });
      /* The list catches a viewport change; the tabs catch a webfont swap, which
         changes their width without changing the list's. */
      observer.observe(list);
      tabs.forEach((tab) => observer.observe(tab));
    }
  });
</script>
