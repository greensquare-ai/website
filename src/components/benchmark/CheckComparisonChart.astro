---
/**
 * Figure 1, the eight-check comparison chart. Design specification section 4.
 *
 * Static, build-time SVG. The only client JavaScript is the connector-draw class
 * toggle in specification section 8.2.
 *
 * The component holds no figures of its own. Every count it plots arrives as a
 * prop the page computed from the accessors in src/lib/benchmark.ts, so this file
 * never imports the JSON and never reasons about what the study found. What it
 * owns is the geometry, the row order (judgement first, then process) and the
 * generated <desc>.
 */

/** One arm's cell, already formatted by fmt() in the accessor layer. */
export type ArmValue = {
  /** The count itself, used only to place a mark on the track. */
  met: number;
  /** "14 of 15", printed beside the plot. */
  text: string;
  /** The percentage the mobile rendering positions its marks from. */
  pct: number;
};

export type ChartRow = {
  id: string;
  label: string;
  baseline: ArmValue;
  loaded: ArmValue;
  /** True where the baseline cell is an artefact of the test design. */
  baselineDefinitional?: boolean;
};

export type ArmNaming = {
  /** How the arm is named beside a count, e.g. "All facts". */
  name: string;
  /** How the arm is named in the key, spelled in full. */
  keyLabel: string;
  /** The short value-column head, so two right-anchored strings cannot collide. */
  columnHead: string;
};

export interface Props {
  /** Instance prefix for every id this component writes. */
  id?: string;
  /** The visible sentence title. The figure number comes from the CSS counter. */
  title: string;
  /** The SVG <title>. Carries no figure number, by section 2.6. */
  svgTitle: string;
  /** grid().n_per_arm. Checked against the plotted scale below. */
  perArm: number;
  /** The unit word on the last axis tick, e.g. "runs". */
  unit: string;
  baseline: ArmNaming;
  loaded: ArmNaming;
  /** Judgement checks, plotted first. */
  judgement: ChartRow[];
  /** Process checks, plotted second. */
  process: ChartRow[];
  /** The scale sentence above the mobile rendering. */
  scaleNote: string;
  /** The page's marking convention for a definitional cell. */
  definitionalSuffix?: string;
  /** How the generated description explains a definitional cell. */
  definitionalPhrase?: string;
  class?: string;
}

const {
  id = 'fig1',
  title,
  svgTitle,
  perArm,
  unit,
  baseline,
  loaded,
  judgement,
  process,
  scaleNote,
  definitionalSuffix = 'def',
  definitionalPhrase = 'fixed by the test design',
  class: className,
} = Astro.props;

/* ---------- geometry, section 4.2, in integers so an off-by-one shows in a diff ---------- */

const TRACK_X0 = 360;
const TRACK_PER_RUN = 35;
const TRACK_X_MAX = 885;
const GRID_X = [360, 535, 710, 885];
const GRID_TOP = 62;
const GRID_BOTTOM = 500;
const FRAME_X1 = 0;
const FRAME_X2 = 1100;
const KEY_MARK_Y = 14;
const KEY_TEXT_Y = 19;
const KEY_BASE_CX = 7;
const KEY_BASE_TEXT_X = 21;
const KEY_LOADED_CX = 228;
const KEY_LOADED_TEXT_X = 243;
const TICK_Y = 54;
const VALUE_X_BASELINE = 1000;
const VALUE_X_LOADED = 1100;
/** Optically centres 13px text on the track line. */
const TEXT_BASELINE_OFFSET = 5;

const x = (runs: number) => TRACK_X0 + TRACK_PER_RUN * runs;

/* The track is cut for one specific denominator. If the study ever reports a
   different one, the axis labels and the 35-unit scale are both wrong, so fail
   the build rather than plot a chart that quietly disagrees with its own basis. */
if (x(perArm) !== TRACK_X_MAX) {
  throw new Error(
    `CheckComparisonChart: the plot track is cut for a ${(TRACK_X_MAX - TRACK_X0) / TRACK_PER_RUN}-run scale, ` +
      `but ${perArm} was passed as the count per condition. Re-cut the geometry in design spec section 4.2.`,
  );
}

const GROUPS = [
  {
    label: 'Judgement checks, pre-registered',
    labelY: 82,
    ruleY: 92,
    tracks: [122, 166, 210],
    interRules: [144, 188],
    rows: judgement,
  },
  {
    label: 'Process checks',
    labelY: 262,
    ruleY: 272,
    tracks: [302, 346, 390, 434, 478],
    interRules: [324, 368, 412, 456],
    rows: process,
  },
];

for (const group of GROUPS) {
  if (group.rows.length !== group.tracks.length) {
    throw new Error(
      `CheckComparisonChart: the "${group.label}" group is drawn on ${group.tracks.length} row tracks ` +
        `but ${group.rows.length} rows were passed. Re-cut the vertical bands in design spec section 4.2.`,
    );
  }
}

/** Rows in DOM order, so the connector stagger runs judgement group first. */
let domIndex = 0;
const groups = GROUPS.map((group) => ({
  ...group,
  plotted: group.rows.map((row, i) => {
    const cxBaseline = x(row.baseline.met);
    const cxLoaded = x(row.loaded.met);
    const tied = row.baseline.met === row.loaded.met;
    return {
      row,
      y: group.tracks[i],
      i: domIndex++,
      cxBaseline,
      cxLoaded,
      tied,
      connectorX1: Math.min(cxBaseline, cxLoaded),
      connectorX2: Math.max(cxBaseline, cxLoaded),
      connectorLength: Math.abs(cxLoaded - cxBaseline),
      baselineText: row.baselineDefinitional
        ? `${row.baseline.text} ${definitionalSuffix}`
        : row.baseline.text,
    };
  }),
}));

/* ---------- the axis, read back off the fixed gridlines ---------- */

const ticks = GRID_X.map((gx, i) => ({
  x: gx,
  label: i === GRID_X.length - 1 ? `${(gx - TRACK_X0) / TRACK_PER_RUN} ${unit}` : String((gx - TRACK_X0) / TRACK_PER_RUN),
  anchor: i === 0 ? 'start' : i === GRID_X.length - 1 ? 'end' : 'middle',
}));

/* ---------- the generated description, section 4.5 ----------
   role="img" makes the SVG subtree presentational, so the counts printed inside
   it reach nobody. This is where assistive technology gets them, and it is
   composed from the props so it cannot go stale when a count changes. */

const list = (items: string[]): string =>
  items.length <= 1 ? items[0] ?? '' : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;

const isDefinitional = (row: ChartRow) => row.baselineDefinitional === true;
const tiedRows = (rows: ChartRow[]) => rows.filter((r) => r.baseline.met === r.loaded.met);
const baselineHigher = (rows: ChartRow[]) =>
  rows.filter((r) => !isDefinitional(r) && r.baseline.met > r.loaded.met);
const loadedHigher = (rows: ChartRow[]) =>
  rows.filter((r) => !isDefinitional(r) && r.loaded.met > r.baseline.met);

/** "A and B are equal at 15 of 15." One sentence per distinct shared count. */
const equalSentences = (rows: ChartRow[]): string[] => {
  const byCount = new Map<string, string[]>();
  for (const row of rows) {
    const labels = byCount.get(row.baseline.text) ?? [];
    labels.push(row.label);
    byCount.set(row.baseline.text, labels);
  }
  return [...byCount].map(
    ([count, labels]) => `${list(labels)} ${labels.length > 1 ? 'are' : 'is'} equal at ${count}.`,
  );
};

const aheadSentence = (rows: ChartRow[], leader: 'baseline' | 'loaded'): string => {
  if (rows.length === 0) return '';
  const clauses = rows.map((r) =>
    leader === 'baseline'
      ? `${r.label}, ${r.baseline.text} against ${r.loaded.text}`
      : `${r.label}, ${r.loaded.text} against ${r.baseline.text}`,
  );
  const lead = leader === 'baseline' ? 'the informed baseline is higher on' : 'the loaded file is higher on';
  return `${lead} ${clauses.join(', and on ')}.`;
};

const sentence = (opening: string, body: string) => (body ? `${opening}${body}` : '');

const definitionalRows = [...judgement, ...process].filter(isDefinitional);

const desc = [
  sentence('On the judgement checks, ', equalSentences(tiedRows(judgement)).join(' ')),
  sentence('On the judgement checks, ', aheadSentence(baselineHigher(judgement), 'baseline')),
  sentence('On the judgement checks, ', aheadSentence(loadedHigher(judgement), 'loaded')),
  sentence('On the process checks, ', aheadSentence(loadedHigher(process), 'loaded')),
  ...definitionalRows.map((r) => `${r.label} is ${definitionalPhrase} and is marked definitional.`),
  equalSentences(tiedRows(process)).join(' '),
]
  .filter(Boolean)
  .join(' ');

const hasBasis = Astro.slots.has('basis');
---

<figure class:list={['bm-fig', 'bm-breakout', className]}>
  <h3 class="bm-fig__title" id={`${id}-heading`}>{title}</h3>

  <svg
    class="bm-fig__plot"
    viewBox="0 0 1100 512"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-labelledby={`${id}-svg-title ${id}-svg-desc`}
    focusable="false"
  >
    <title id={`${id}-svg-title`}>{svgTitle}</title>
    <desc id={`${id}-svg-desc`}>{desc}</desc>

    {/* Key: the real marks at their real sizes, drawn once. */}
    <circle class="bm-fig__mark bm-fig__mark--base" cx={KEY_BASE_CX} cy={KEY_MARK_Y} r="6.5" stroke-width="2" />
    <text class="bm-fig__keytext" x={KEY_BASE_TEXT_X} y={KEY_TEXT_Y} text-anchor="start">{baseline.keyLabel}</text>
    <circle class="bm-fig__mark bm-fig__mark--key" cx={KEY_LOADED_CX} cy={KEY_MARK_Y} r="7.5" stroke-width="2" />
    <text class="bm-fig__keytext bm-fig__keytext--key" x={KEY_LOADED_TEXT_X} y={KEY_TEXT_Y} text-anchor="start">{loaded.keyLabel}</text>

    {/* Value-column heads. */}
    <text class="bm-fig__colhead" x={VALUE_X_BASELINE} y={KEY_TEXT_Y} text-anchor="end">{baseline.columnHead}</text>
    <text class="bm-fig__colhead" x={VALUE_X_LOADED} y={KEY_TEXT_Y} text-anchor="end">{loaded.columnHead}</text>

    {/* Gridlines. The ceiling line is heavier because many rows sit on it. */}
    {GRID_X.map((gx, i) => (
      <line
        class:list={['bm-fig__grid', i === GRID_X.length - 1 && 'bm-fig__grid--ceiling']}
        x1={gx}
        x2={gx}
        y1={GRID_TOP}
        y2={GRID_BOTTOM}
        stroke-width="1"
      />
    ))}

    {/* Axis ticks, with the unit on the last one. */}
    {ticks.map((tick) => (
      <text class="bm-fig__tick" x={tick.x} y={TICK_Y} text-anchor={tick.anchor}>{tick.label}</text>
    ))}

    {groups.map((group) => (
      <>
        <text class="bm-fig__grouplabel" x={FRAME_X1} y={group.labelY} text-anchor="start">{group.label}</text>
        <line class="bm-fig__rule" x1={FRAME_X1} x2={FRAME_X2} y1={group.ruleY} y2={group.ruleY} stroke-width="1" />
        {group.interRules.map((ry) => (
          <line class="bm-fig__rule bm-fig__rule--soft" x1={FRAME_X1} x2={FRAME_X2} y1={ry} y2={ry} stroke-width="1" />
        ))}
        {group.plotted.map((p) => (
          <>
            <line class="bm-fig__track" x1={TRACK_X0} x2={TRACK_X_MAX} y1={p.y} y2={p.y} stroke-width="1" />
            {!p.tied && (
              <line
                class="bm-fig__connector"
                x1={p.connectorX1}
                x2={p.connectorX2}
                y1={p.y}
                y2={p.y}
                stroke-width="2"
                stroke-linecap="butt"
                style={`--len: ${p.connectorLength}; --i: ${p.i}`}
              />
            )}
            {/* On a tied row the filled mark is drawn first so the hollow ring caps
                it, which reads as both conditions landing on the same value. */}
            {p.tied && (
              <>
                <circle class="bm-fig__mark bm-fig__mark--key" cx={p.cxLoaded} cy={p.y} r="7.5" stroke-width="2" />
                <circle
                  class:list={['bm-fig__mark', 'bm-fig__mark--base', p.row.baselineDefinitional && 'is-definitional']}
                  cx={p.cxBaseline}
                  cy={p.y}
                  r="6.5"
                  stroke-width="2"
                />
              </>
            )}
            {!p.tied && (
              <>
                <circle
                  class:list={['bm-fig__mark', 'bm-fig__mark--base', p.row.baselineDefinitional && 'is-definitional']}
                  cx={p.cxBaseline}
                  cy={p.y}
                  r="6.5"
                  stroke-width="2"
                />
                <circle class="bm-fig__mark bm-fig__mark--key" cx={p.cxLoaded} cy={p.y} r="7.5" stroke-width="2" />
              </>
            )}
            <text class="bm-fig__rowlabel" x={FRAME_X1} y={p.y + TEXT_BASELINE_OFFSET} text-anchor="start">{p.row.label}</text>
            <text class="bm-fig__val" x={VALUE_X_BASELINE} y={p.y + TEXT_BASELINE_OFFSET} text-anchor="end">{p.baselineText}</text>
            <text class="bm-fig__val bm-fig__val--key" x={VALUE_X_LOADED} y={p.y + TEXT_BASELINE_OFFSET} text-anchor="end">{p.row.loaded.text}</text>
          </>
        ))}
      </>
    ))}

    <line class="bm-fig__rule" x1={FRAME_X1} x2={FRAME_X2} y1={GRID_BOTTOM} y2={GRID_BOTTOM} stroke-width="1" />
  </svg>

  {/* The 390px rendering. Same props, distinct ids, and exactly one of the two
      renderings is in the accessibility tree at any width because display: none
      prunes it. */}
  <div class="bm-fig__list" id={`${id}-list`}>
    <p class="v-small bm-fig__keyline">
      <span class="bm-fig__keyitem"><span class="bm-fig__keymark bm-fig__keymark--base" aria-hidden="true"></span>{baseline.keyLabel}</span>
      <span class="bm-fig__keyitem"><span class="bm-fig__keymark bm-fig__keymark--key" aria-hidden="true"></span>{loaded.keyLabel}</span>
    </p>
    <p class="v-small bm-fig__scalenote">{scaleNote}</p>

    {groups.map((group, gi) => (
      <>
        <p class="bm-dumbbell__group" id={`${id}-group-${gi + 1}`}>{group.label}</p>
        <ol class="bm-dumbbell" aria-hidden="false" aria-labelledby={`${id}-group-${gi + 1}`}>
          {group.plotted.map((p) => (
            <li
              class:list={['bm-dumbbell__row', p.row.baselineDefinitional && 'is-definitional']}
              style={`--b: ${p.row.baseline.pct}%; --c: ${p.row.loaded.pct}%`}
            >
              <p class="bm-dumbbell__label">{p.row.label}</p>
              <div class="bm-dumbbell__track" aria-hidden="true">
                {!p.tied && <span class="bm-dumbbell__span"></span>}
                <span class="bm-dumbbell__mark bm-dumbbell__mark--base"></span>
                <span class="bm-dumbbell__mark bm-dumbbell__mark--key"></span>
              </div>
              <p class="bm-dumbbell__vals">
                <span>{baseline.name} <b>{p.baselineText}</b></span>
                <span>{loaded.name} <b>{p.row.loaded.text}</b></span>
              </p>
            </li>
          ))}
        </ol>
      </>
    ))}
  </div>

  {hasBasis && (
    <p class="bm-fig__basis"><slot name="basis" /></p>
  )}
</figure>

<style>
  /* Figure numbers come from a counter reset on .bm-page, so they cannot go stale
     when a figure is added or dropped. Section 2.6. */
  .bm-fig { margin: 0; counter-increment: bm-fig; }
  .bm-fig .bm-fig__title::before { content: 'Figure ' counter(bm-fig) '. '; }
  .bm-fig .bm-fig__title {
    margin: 0;
    font-family: var(--vf-body);
    font-size: var(--vs-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  /* Section 2.2. Both margins come from one variable, so they are equal by
     construction at every width. */
  .bm-breakout { width: min(1100px, 100%); margin-inline: auto; }
  @media (min-width: 1171px) {
    .bm-breakout {
      --bm-bw: min(1100px, calc(100vw - 2 * var(--v-gutter)));
      width: var(--bm-bw);
      margin-inline: calc((100% - var(--bm-bw)) / 2);
    }
  }

  .bm-fig .bm-fig__basis {
    margin: var(--v-3) 0 0;
    max-width: 72ch;
    font-size: var(--vs-small);
    color: var(--v-ink-soft);
  }

  /* ---------- which rendering is live ----------
     Mobile first, so a browser that fails the query gets the list rather than a
     chart squeezed to a third of its type size. */
  .bm-fig .bm-fig__plot { display: none; }
  .bm-fig .bm-fig__list { display: block; }
  @media (min-width: 760px) {
    .bm-fig .bm-fig__plot {
      display: block;
      width: 100%;
      height: auto;
      margin-inline: auto;
      font-family: var(--vf-body);
    }
    .bm-fig .bm-fig__list { display: none; }
  }

  /* ---------- SVG type, section 4.4 ---------- */
  .bm-fig__rowlabel { font-size: 13px; font-weight: 400; fill: var(--v-ink); }
  /* Both value columns carry the same size and the same colour, and are separated
     by one weight step only. The type table in section 4.4 gives the baseline
     column --v-ink-soft, which is a colour step, and constraint H2 in section 1
     and constraint 15 in section 10 both forbid one between paired counts. The
     prose under that table says the same ("it is a weight step and not a size or
     colour step"), so the table row is the defect and section 1 outranks it. */
  .bm-fig__val { font-size: 13px; font-weight: 400; fill: var(--v-ink); }
  .bm-fig__val--key { font-weight: 600; }
  .bm-fig__colhead { font-size: 12px; font-weight: 400; fill: var(--v-ink-faint); }
  .bm-fig__keytext { font-size: 13px; font-weight: 400; fill: var(--v-ink-soft); }
  .bm-fig__keytext--key { font-weight: 600; fill: var(--v-ink); }
  .bm-fig__grouplabel { font-size: 13px; font-weight: 600; fill: var(--v-ink); }
  .bm-fig__tick { font-size: 12px; font-weight: 400; fill: var(--v-ink-faint); }

  /* ---------- SVG marks and strokes, section 4.3 ---------- */
  .bm-fig__grid { stroke: var(--v-line); }
  .bm-fig__grid--ceiling { stroke: var(--v-line-strong); }
  .bm-fig__track { stroke: var(--v-line); }
  .bm-fig__rule { stroke: var(--v-ink); }
  .bm-fig__rule--soft { stroke: var(--v-line); }
  .bm-fig__connector { stroke: var(--v-ink-faint); }
  .bm-fig__mark--base { fill: none; stroke: var(--v-ink-faint); }
  .bm-fig__mark--base.is-definitional { stroke-dasharray: 3 2.5; }
  .bm-fig__mark--key { fill: var(--v-green); stroke: var(--v-paper); }

  /* ---------- the 390px rendering, section 4.6 ---------- */
  .bm-fig .bm-fig__keyline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--v-2) var(--v-5);
    margin: 0 0 var(--v-2);
    color: var(--v-ink-soft);
  }
  .bm-fig__keyitem { display: inline-flex; align-items: center; gap: var(--v-2); }
  .bm-fig__keymark { display: inline-block; border-radius: 50%; }
  .bm-fig__keymark--base { width: 13px; height: 13px; border: 2px solid var(--v-ink-faint); }
  .bm-fig__keymark--key { width: 15px; height: 15px; background: var(--v-green); border: 2px solid var(--v-paper); }
  .bm-fig .bm-fig__scalenote { margin: 0; color: var(--v-ink-soft); }

  .bm-fig .bm-dumbbell__group {
    margin: var(--v-6) 0 var(--v-3);
    font-size: var(--vs-small);
    font-weight: 600;
    color: var(--v-ink);
  }
  .bm-dumbbell { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--v-ink); }
  .bm-dumbbell__row { padding: var(--v-4) 0; border-bottom: 1px solid var(--v-line); }
  .bm-fig .bm-dumbbell__label { margin: 0 0 var(--v-3); font-size: var(--vs-small); color: var(--v-ink); }
  .bm-dumbbell__track { position: relative; height: 22px; margin-inline: 9px; }
  .bm-dumbbell__track::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--v-line);
  }
  .bm-dumbbell__span {
    position: absolute;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--v-ink-faint);
    left: min(var(--b), var(--c));
    width: calc(max(var(--b), var(--c)) - min(var(--b), var(--c)));
  }
  .bm-dumbbell__mark { position: absolute; top: 50%; border-radius: 50%; transform: translate(-50%, -50%); }
  .bm-dumbbell__mark--base {
    left: var(--b);
    width: 13px;
    height: 13px;
    border: 2px solid var(--v-ink-faint);
    background: transparent;
  }
  .bm-dumbbell__mark--key {
    left: var(--c);
    width: 15px;
    height: 15px;
    background: var(--v-green);
    border: 2px solid var(--v-paper);
  }
  .bm-dumbbell__row.is-definitional .bm-dumbbell__mark--base { border-style: dashed; }
  .bm-fig .bm-dumbbell__vals {
    margin: var(--v-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--v-1) var(--v-5);
    font-size: var(--vs-small);
    color: var(--v-ink-soft);
  }
  .bm-dumbbell__vals b { font-weight: 600; color: var(--v-ink); font-variant-numeric: tabular-nums; }

  /* ---------- connector draw, section 8.2 ----------
     The resting state is a solid drawn line. The dash pattern and the start
     offset exist only inside this rule, which needs both .js and .is-visible, so
     there is no state of the world in which a connector is invisible. */
  :global(.js) .bm-fig.is-visible .bm-fig__connector {
    stroke-dasharray: var(--len);
    animation: bm-draw var(--v-mid) var(--v-ease) both;
    animation-delay: calc(var(--i) * 40ms);
  }
  @keyframes bm-draw {
    from { stroke-dashoffset: var(--len); }
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .bm-fig.is-visible .bm-fig__connector { animation: none; }
  }
</style>

<script>
  /* The only client JavaScript in this figure. It adds the class the connector
     draw is scoped to, and nothing else. The layout's observer watches .v-reveal,
     which design spec section 3.9 keeps as an unused no-op, so the figure carries
     its own. The dots never animate: a dot that fades in is a data point that was
     briefly absent. */
  const figures = Array.from(document.querySelectorAll<HTMLElement>('.bm-fig')).filter((figure) =>
    figure.querySelector('.bm-fig__connector'),
  );
  if (figures.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    figures.forEach((figure) => io.observe(figure));
  }
</script>
