---
import { withBase } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <a class="brand" href={withBase('/')} aria-label="GreenSquare home" style="color: var(--cream);">
        <img src={withBase('/assets/logo-mark.svg')} alt="" width="26" height="26" />
        <span class="brand-name">GreenSquare</span>
      </a>
      <div class="footer-cols">
        <div class="footer-col">
          <h4>Product</h4>
          <a href={withBase('/product/')}>The Decision</a>
          <a href={withBase('/pricing/')}>Pricing</a>
          <a href={withBase('/decision-frame/')}>Free Decision Frame</a>
        </div>
        <div class="footer-col">
          <h4>Benchmark</h4>
          <a href={withBase('/benchmark/')}>Benchmark</a>
          <a href={withBase('/methodology/')}>Methodology</a>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <a href={withBase('/legal/privacy/')}>Privacy</a>
          <a href={withBase('/legal/terms/')}>Terms</a>
          <a href={withBase('/legal/cookies/')}>Cookies</a>
        </div>
      </div>
    </div>
    <div class="footer-legal">
      <span>&copy; {year} GreenSquare</span>
      <span>hello@greensquare.ai</span>
    </div>
  </div>
</footer>
