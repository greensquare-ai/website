---
import BaseLayoutV2 from './BaseLayoutV2.astro';
export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
const title = frontmatter.title;
const description = frontmatter.description ?? 'GreenSquare legal information.';
---
<BaseLayoutV2 title={`${title} · GreenSquare`} description={description}>
  <section class="v-section">
    <div class="v-container v-container--narrow">
      <p class="v-label v-label--rule v-eyebrow">Legal</p>
      <div class="v-prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayoutV2>
