---
import { withBase } from '../lib/paths';
import Analytics from '@vercel/analytics/astro';
import NavV2 from '../components/NavV2.astro';
import FooterV2 from '../components/FooterV2.astro';
import '../styles/global-v2.css';

export interface Props {
  title: string;
  description: string;
  current?: string;
  ogType?: string;
  noindex?: boolean;
}
const { title, description, current = '', ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(withBase('/assets/og-image.png'), Astro.site).toString();
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <!-- Matches the sticky nav, which is what the browser chrome abuts, not the white page body. -->
    <meta name="theme-color" content="#10110f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GreenSquare AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/assets/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/assets/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Three faces, matching the design language and nothing more. IBM Plex Mono is gone:
         it was not in the guideline, and it was being asked for at weight 700 while only
         400 and 500 were loaded, so the browser synthesised the bold. Space Grotesk ships
         Semibold alone, which is the only weight the guideline gives it.

         The two faces load differently on purpose.

         Reading text swaps, from Google Fonts. A paragraph reflowing costs a little shift
         and the reader genuinely wants the brand face for the text they spend their time in.

         Headings do not swap, and Space Grotesk is served from this origin rather than
         Google's. Space Grotesk sets h1 and h2 only: a handful of large words under
         `text-wrap: balance`, where a small change in glyph advance moves a wrap point,
         changes the line count and moves everything below the heading. On /free/ that
         measured 0.105 CLS against a 0.1 budget, so the face carries `font-display:
         optional` and never swaps in mid-visit.

         `optional` gives the file about 100ms to arrive or the visit keeps the fallback.
         Loaded from fonts.gstatic.com that meant a DNS lookup, a TLS handshake, a
         stylesheet and only then the font, which lost the race on most cold visits and
         rendered the headings in Arial. Self-hosted and preloaded, the file is in memory
         before first paint, so `optional` now wins every time and still guarantees no
         reflow. The two subsets are the latin and latin-ext files from Google's own
         Space Grotesk v22 (SIL Open Font License). -->
    <link
      rel="preload"
      href={withBase('/fonts/space-grotesk-600-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Manrope:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="v2 brand-site">
    <a class="skip-link" href="#main">Skip to content</a>
    <NavV2 current={current} />
    <main id="main">
      <slot />
    </main>
    <FooterV2 />
    <Analytics />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.v-reveal').forEach((el) => io.observe(el));

      const nav = document.querySelector('.v-nav');
      if (nav) {
        let ticking = false;
        const sync = () => { nav.classList.toggle('is-solid', window.scrollY > 12); ticking = false; };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } }, { passive: true });
        sync();
      }

      const toggle = document.getElementById('v-nav-toggle');
      const drawer = document.getElementById('v-nav-drawer');
      const closeDrawer = (returnFocus = false) => {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open menu');
        drawer?.classList.remove('is-open');
        if (returnFocus) toggle?.focus();
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
        drawer?.classList.toggle('is-open', !open);
        if (!open) drawer?.querySelector<HTMLElement>('a')?.focus();
      });
      drawer?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeDrawer();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && drawer?.classList.contains('is-open')) closeDrawer(true);
      });
      window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
        if (event.matches) closeDrawer();
      });
    </script>
  </body>
</html>
