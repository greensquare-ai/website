---
import DesignLayout from '../layouts/DesignLayout.astro';
import SocialFrame from '../components/SocialFrame.astro';
import '../styles/social.css';

const templates = [
  { kind: 'cover', title: 'Series cover', level: 'Level 1', group: 'Signal', note: 'Cropped aperture, six-word headline.' },
  { kind: 'question', title: 'Governing question', level: 'Level 2', group: 'Signal', note: 'Translucent planes, one owned question.' },
  { kind: 'statistic', title: 'Key statistic', level: 'Level 2', group: 'Evidence', note: 'One number, basis and written evidence state.' },
  { kind: 'chart', title: 'Data chart', level: 'Level 3', group: 'Evidence', note: 'Direct labels, one focal colour, relevance line.' },
  { kind: 'recommendation', title: 'Recommendation', level: 'Level 3', group: 'Decision', note: 'Owner, review date and reversal condition.' },
  { kind: 'challenge', title: 'Challenge', level: 'Level 3', group: 'Decision', note: 'Long-form counter-position with no imagery.' },
  { kind: 'principle', title: 'Working principle', level: 'Level 2', group: 'Signal', note: 'One institutional statement on a deep field.' },
  { kind: 'process', title: 'Process', level: 'Level 3', group: 'Evidence', note: 'Numbered steps; no evidence-state iconography.' },
  { kind: 'case-study', title: 'Case study', level: 'Level 1–2', group: 'Decision', note: 'Proof point with a controlled material crop.' },
  { kind: 'publication', title: 'Publication', level: 'Level 1', group: 'Conversion', note: 'One proposition with a tonal mark crop.' },
  { kind: 'closing', title: 'Closing implication', level: 'Level 3', group: 'Conversion', note: 'Negative space is the visual event.' },
  { kind: 'interlude', title: 'Atmospheric interlude', level: 'Level 2', group: 'Signal', note: 'One sentence, one edge-light source.' },
  { kind: 'evidence-field', title: 'Evidence field', level: 'Level 3', group: 'Evidence', note: 'A data-derived field, never decorative density.' },
] as const;

const channels = [
  ['LinkedIn', 'Primary authority', '4:5 PDF carousel', 'Institutional post + Decision Frame'],
  ['Instagram', 'Visual recognition', '4:5 carousel + 9:16 Reel', 'Save, share or Decision Frame'],
  ['TikTok', 'Fast decision education', '21–34 second 9:16 explainer', 'First-three-second governing question'],
  ['X', 'Compressed argument', 'Thread + up to two cards', 'Source-backed claim or reversal'],
  ['Reddit', 'Community usefulness', 'Plain-text contribution first', 'Transparent sources; links only when permitted'],
  ['GitHub', 'Substantive proof', 'Release, example or 1280×640 preview', 'Publish only when the work is real'],
] as const;

const chartColours = [
  ['Decision Forest', '#133F26', 'Primary or focal series'],
  ['Eucalyptus', '#3F6F5A', 'Secondary series'],
  ['Deep Blue-Green', '#315F69', 'Alternative outcome or exceptional highlight'],
  ['Institutional Slate', '#56666F', 'Comparator, threshold or reference'],
  ['Sage', '#70877A', 'Supporting category'],
  ['Mineral Mid', '#AAB7AE', 'Context data'],
  ['Mineral Pale', '#D8DDD8', 'Neutral midpoint or low-emphasis area'],
] as const;

const formats = [
  ['1:1', '1080 × 1080', 'Instagram and X', 'Zone B starts at 360px'],
  ['4:5', '1080 × 1350', 'LinkedIn and Instagram', 'Zone B starts at 460px'],
  ['9:16', '1080 × 1920', 'Reels and TikTok', 'Zone B stays inside the middle safe third'],
  ['16:9', '1920 × 1080', 'Product demonstrations', 'UI remains flat and truthfully labelled'],
  ['2:1', '1280 × 640', 'GitHub preview', 'One repository promise on a solid field'],
] as const;
---

<DesignLayout
  section="Applications / Social"
  title="Social system"
  focus="How does one source idea become six native proofs without losing the decision?"
  description="GreenSquare AI social expression system: native templates, controlled atmosphere, ratio standards, institutional chart colours, channel roles and production QA."
  immersive
>
  <section class="social-hero" aria-labelledby="social-title">
    <div class="social-hero-copy">
      <span class="social-eyebrow">Social expression system · v1.2</span>
      <h1 id="social-title" tabindex="-1">Many interchangeable parts. One unmistakable family.</h1>
      <p>GreenSquare turns sourced ideas into native social contributions without losing the governing question, evidence, owner, or reversal condition.</p>
      <div class="social-hero-actions">
        <a class="social-button social-button--light" href="#templates">Review the template family</a>
        <a class="social-text-link social-text-link--light" href="/assets/social/weekly-content-brief.md" download>Download the weekly brief</a>
      </div>
      <dl class="social-hero-facts">
        <div><dt>Expression</dt><dd>Rich when sparse. Quiet when dense.</dd></div>
        <div><dt>Proof</dt><dd>Product, documents, data, and sourced evidence.</dd></div>
        <div><dt>Conversion</dt><dd>The free Decision Frame.</dd></div>
      </dl>
    </div>
    <div class="social-hero-frame" aria-label="Native GreenSquare governing-question post">
      <SocialFrame kind="question" />
    </div>
  </section>

  <section class="social-foundation" aria-labelledby="foundation-title">
    <div class="social-section-head">
      <span class="social-index">01</span>
      <div><h2 id="foundation-title">Control richness before choosing a template.</h2><p>Visual intensity follows information density. This is the governing system behind every post—not a collection of unrelated layouts.</p></div>
    </div>
    <div class="intensity-grid">
      <article><span>Level 1</span><h3>Hero and cover</h3><p>Expressive aperture, atmosphere, photography, or evidence field. One short headline and minimal metadata.</p></article>
      <article><span>Level 2</span><h3>Atmospheric statement</h3><p>One question, statement, or number. One visual event only; never two competing effects.</p></article>
      <article><span>Level 3</span><h3>Editorial evidence</h3><p>White, Ground, or a stable forest field. Grid, type, direct labels, sources, owner, and reversal do the work.</p></article>
    </div>

    <div class="grid-standard">
      <div class="grid-diagram" aria-label="One-to-one GreenSquare post showing twelve columns, a 72 pixel safe area, and zones A, B, and C">
        <div class="grid-safe"><span>72px safe area</span></div>
        <div class="grid-columns" aria-hidden="true">{Array.from({ length: 12 }, () => <i></i>)}</div>
        <div class="grid-zone grid-zone--a"><strong>Zone A</strong><span>Lockup + topic tag</span></div>
        <div class="grid-zone grid-zone--b"><strong>Zone B</strong><span>Content + one visual event</span></div>
        <div class="grid-zone grid-zone--c"><strong>Zone C</strong><span>Source + owner + position</span></div>
      </div>
      <div class="grid-rules">
        <span class="social-eyebrow">Fixed geometry</span>
        <h3>One grid. Three zones. Every ratio.</h3>
        <dl>
          <div><dt>Canvas</dt><dd>1080-wide master geometry, scaled proportionally.</dd></div>
          <div><dt>Columns</dt><dd>12 columns · 24px gutter · 56px column.</dd></div>
          <div><dt>Type width</dt><dd>Headlines: 8–10 columns. Body: 8 maximum.</dd></div>
          <div><dt>Rules</dt><dd>3px structural · 2px secondary and chart axis.</dd></div>
          <div><dt>Corners</dt><dd>Square. Curves belong only to the mark geometry.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="social-assets" aria-labelledby="assets-title">
    <div class="social-section-head social-section-head--light">
      <span class="social-index">02</span>
      <div><h2 id="assets-title">Atmosphere is governed, not improvised.</h2><p>Choose one ground per sparse frame. Light direction is set once for a series and held across every derivative.</p></div>
    </div>
    <div class="asset-repertoire">
      <article class="asset-ground asset-ground--forest"><span>Forest to deep</span><p>The default rich ground.</p></article>
      <article class="asset-ground asset-ground--edge"><span>Edge light</span><p>One corner source, controlled fall-off.</p></article>
      <article class="asset-ground asset-ground--planes"><span>Translucent planes</span><p>Two planes at one shared angle.</p></article>
      <article class="asset-ground asset-ground--light"><span>White to Ground</span><p>The crisp light equivalent.</p></article>
      <article class="asset-ground asset-ground--aperture"><span>Aperture</span><p>The mark carries the only event.</p></article>
    </div>
    <div class="evidence-field-standard">
      <div><span class="social-eyebrow">Evidence field</span><h3>Density and alignment must come from the data.</h3><p>The field uses one repeated, brand-derived unit. It is not an icon key for Confirmed, Assumption, or Risk. Claim counts, spatial alignment, a labelled threshold, and adjacent written evidence states carry the meaning.</p></div>
      <SocialFrame kind="evidence-field" />
    </div>
  </section>

  <section class="social-template-system" id="templates" aria-labelledby="templates-title">
    <div class="social-section-head">
      <span class="social-index">03</span>
      <div><h2 id="templates-title">Thirteen templates. Four content jobs.</h2><p>These are native, resolution-independent compositions. Signal earns attention; Evidence establishes the basis; Decision makes the call; Conversion closes the loop.</p></div>
    </div>
    <div class="template-gallery">
      {templates.map((template) => (
        <figure class={`template-specimen template-specimen--${template.kind}`}>
          <SocialFrame kind={template.kind} />
          <figcaption><strong>{template.title}</strong><span>{template.group} · {template.level}</span><p>{template.note}</p></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="social-ratios" id="formats" aria-labelledby="ratios-title">
    <div class="social-section-head social-section-head--light">
      <span class="social-index">04</span>
      <div><h2 id="ratios-title">One template. Three primary ratios.</h2><p>Margins, lockup scale, tag treatment, and type logic stay fixed. Zone B moves to protect meaning from platform chrome.</p></div>
    </div>
    <div class="ratio-showcase">
      <figure><SocialFrame kind="question" ratio="square" /><figcaption><strong>1:1</strong><span>1080 × 1080</span></figcaption></figure>
      <figure><SocialFrame kind="question" ratio="portrait" /><figcaption><strong>4:5</strong><span>1080 × 1350</span></figcaption></figure>
      <figure><SocialFrame kind="question" ratio="vertical" /><figcaption><strong>9:16</strong><span>1080 × 1920</span></figcaption></figure>
    </div>
    <div class="format-register" role="table" aria-label="GreenSquare social format register">
      <div class="format-row format-row--head" role="row"><span>Ratio</span><span>Canvas</span><span>Primary use</span><span>Rule</span></div>
      {formats.map((row) => <div class="format-row" role="row">{row.map((cell) => <span role="cell">{cell}</span>)}</div>)}
    </div>
  </section>

  <section class="social-data" aria-labelledby="data-title">
    <div class="social-section-head">
      <span class="social-index">05</span>
      <div><h2 id="data-title">Institutional colour. One distinction at a time.</h2><p>GreenSquare charts use Forest, cool green extensions, Blue-Green, Slate, and Mineral. Yellow, amber, orange, red, pink, neon, and rainbow palettes are not permitted.</p></div>
    </div>
    <div class="chart-system">
      <div class="chart-palette" aria-label="Approved GreenSquare chart colours">
        {chartColours.map(([name, hex, role]) => (
          <div class="chart-colour"><i style={`--swatch:${hex}`}></i><strong>{name}</strong><code>{hex}</code><span>{role}</span></div>
        ))}
      </div>
      <div class="chart-practice">
        <article>
          <span>Comparison</span><h3>Partner model closes the cost gap by FY27</h3>
          <div class="comparison-chart" role="img" aria-label="Four paired columns using Forest for the focal series and Sage for the comparator">
            {[76, 68, 58, 51].map((value, index) => <div><i style={`--height:${value}%`}></i><b style={`--height:${value - 12}%`}></b><span>FY{25 + index}</span></div>)}
          </div>
        </article>
        <article>
          <span>Palette rule</span><h3>Default to one GreenSquare colour.</h3>
          <p>Context is Mineral. The material series is Forest. Blue-Green is reserved for an alternative outcome or exceptional highlight. Direct labels replace legends wherever practical.</p>
          <dl><div><dt>Grid and axes</dt><dd>Line + Muted</dd></div><div><dt>Missing data</dt><dd>Mineral Pale + explicit label</dd></div><div><dt>Threshold</dt><dd>Slate dashed line + written value</dd></div></dl>
        </article>
      </div>
    </div>
    <p class="pantone-note"><strong>Print matching:</strong> Pantone families are starting points only. Final coated and uncoated matches require a physical fan deck, D50 viewing, substrate-specific drawdowns, and printer proofing.</p>
  </section>

  <section class="social-channels" aria-labelledby="channels-title">
    <div class="social-section-head">
      <span class="social-index">06</span>
      <div><h2 id="channels-title">Give every channel one native job.</h2><p>The governing question, source, written evidence state, owner, and reversal condition remain invariant. Format, pacing, interaction, and moderation flex.</p></div>
    </div>
    <div class="channel-register" role="table" aria-label="Social channel operating roles">
      <div class="channel-row channel-row--head" role="row"><span>Channel</span><span>Role</span><span>Weekly derivative</span><span>Conversion behaviour</span></div>
      {channels.map((row) => <div class="channel-row" role="row">{row.map((cell, index) => index === 0 ? <strong role="cell">{cell}</strong> : <span role="cell">{cell}</span>)}</div>)}
    </div>
  </section>

  <section class="social-operating" aria-labelledby="operating-title">
    <div class="social-section-head social-section-head--light">
      <span class="social-index">07</span>
      <div><h2 id="operating-title">The visual system earns attention. The operating system protects trust.</h2><p>One weekly source brief governs all six derivatives. Canva production remains paused until this website direction is approved in its implemented form.</p></div>
    </div>
    <div class="operating-grid">
      <article><span>01</span><h3>Brief</h3><p>Claim, evidence, interpretation, assumptions, material risk, recommendation, reversal, product step, sources, CTA, and channel notes.</p><a href="/assets/social/weekly-content-brief.md" download>Download weekly brief</a></article>
      <article><span>02</span><h3>Motion</h3><p>Reveal, inspect, align, resolve. Essential meaning survives without sound; captions and an accessible text equivalent ship with every video.</p></article>
      <article><span>03</span><h3>Release gate</h3><p>Block export when the source, owner, material assumption, written evidence state, reversal condition, alt text, or safe-zone check is missing.</p><a href="/assets/social/social-export-qa.md" download>Download QA checklist</a></article>
      <article><span>04</span><h3>Four-week pilot</h3><p>Four source ideas. Retain the two strongest buying situations and formats without changing the canonical brand invariants.</p><a href="/assets/social/four-week-pilot.md" download>Download pilot pack</a></article>
    </div>
    <p class="production-hold"><strong>Production hold:</strong> do not build or revise Canva masters until this implemented social system is approved.</p>
  </section>

  <section class="social-conversion" id="conversion" aria-labelledby="conversion-title">
    <div><span class="social-eyebrow">Primary conversion</span><h2 id="conversion-title">Make the decision defensible.</h2><p>Every social derivative closes with the free Decision Frame, using channel, weekly slug, and format-specific UTM values.</p></div>
    <a class="social-button social-button--forest" href="https://www.greensquare.ai/decision-frame/?utm_source=brand-guideline&utm_medium=internal&utm_campaign=decision-frame&utm_content=social-system-v1-2">Verify the Decision Frame page</a>
  </section>
</DesignLayout>
