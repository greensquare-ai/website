---
import '../../../src/styles/v3.css';
import '../styles/design.css';

export interface Props {
  title: string;
  focus: string;
  section: string;
  description?: string;
  immersive?: boolean;
}

const {
  title,
  focus,
  section,
  description = 'The GreenSquare Intelligence Layer inspection surface for machine-operable doctrine, knowledge and execution systems.',
  immersive = false,
} = Astro.props;

const navGroups = [
  {
    label: 'Intelligence',
    items: [
      ['Machine index', '/intelligence/'],
    ],
  },
  {
    label: 'Foundations',
    items: [
      ['System', '/'],
      ['Constitution', '/constitution/'],
      ['Identity', '/identity/'],
      ['Typography', '/typography/'],
      ['Iconography', '/iconography/'],
    ],
  },
  {
    label: 'Expression',
    items: [
      ['Language', '/language/'],
      ['Grammar', '/grammar/'],
      ['Data graphics', '/data-graphics/'],
    ],
  },
  {
    label: 'Applications',
    items: [
      ['Decision model', '/decision-model/'],
      ['Interface', '/interface/'],
      ['Applications', '/applications/'],
    ],
  },
  {
    label: 'Operating System',
    items: [
      ['Judgment OS', '/judgment-os/'],
      ['Knowledge Base', '/knowledge-base/'],
      ['Social System', '/social/'],
      ['Content Engine', '/content-engine/'],
      ['Launch System', '/launch-system/'],
    ],
  },
  {
    label: 'Stewardship',
    items: [
      ['Governance', '/governance/'],
      ['Audit', '/audit/'],
    ],
  },
] as const;

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const socialDirectionContract = current === '/social'
  ? `<!--
THESIS: One source idea becomes six native proofs without losing the decision; this refuses the generic gallery of social templates.
OWN-WORLD: Black rail, forest fields, white and cool Ground inspection fields, strict axes, native grids, atmospheric crops, and written evidence states.
STORY: Choose a channel and job, preserve the evidence chain, open the correct master, pass QA, and export a defensible post.
FIRST VIEWPORT: A 62/38 working field pairs the operating promise with a live decision-ledger specimen; the primary action enters the channel chooser.
FORM: Code-led established-world operating manual, position 1 of 1, seed social-decision-ledger-v1-1.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`
  : '';
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · GreenSquare Intelligence Layer</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Manrope:wght@600&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="v3 design-system approved-type">
    <Fragment set:html={socialDirectionContract} />
    <a class="design-skip" href="#design-main">Skip to content</a>
    <div class="design-shell">
      <aside class="design-rail" aria-label="Intelligence Layer inspection navigation">
        <a href="/intelligence/" class="design-brand" aria-label="GreenSquare Intelligence Layer home">
          <img src="/assets/logo.svg" alt="" width="34" height="34" />
          <span>GreenSquare AI</span>
        </a>

        <div class="design-rail-label">
          <span>Intelligence Layer</span>
          <span>Machine-first operating specification</span>
        </div>

        <nav class="design-nav">
          {
            navGroups.map((group) => (
              <div class="design-nav-group">
                <span class="design-nav-group-label">{group.label}</span>
                <div>
                  {group.items.map(([label, path]) => {
                    const isCurrent = current === (path.replace(/\/$/, '') || '/');
                    return (
                      <a
                        href={path}
                        class="design-nav-link"
                        data-current={isCurrent ? 'true' : undefined}
                        aria-current={isCurrent ? 'page' : undefined}
                      >
                        <strong>{label}</strong>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </nav>

        <div class="design-rail-footer">
          <span>GreenSquare Intelligence Layer</span>
          <span>Inspection surface only</span>
        </div>
      </aside>

      <main id="design-main" class="design-main">
        <header class="design-topbar">
          <span>{section}</span>
          <span>Machine-first</span>
        </header>

        <article class="v3-page" data-route-title={title}>
          {!immersive && (
            <header class="v3-page-head">
              <div class="design-page-meta">
                <span>Inspection view</span>
              </div>
              <div class="design-hero-copy">
                <h1 tabindex="-1">{title}</h1>
                <p class="v3-focus">{focus}</p>
              </div>
            </header>
          )}
          <slot />
        </article>

        <footer class="design-footer">
          <strong>GreenSquare Intelligence Layer</strong>
          <span>Canonical doctrine lives in /intelligence/v1/.</span>
          <span>Rendered pages are secondary inspection surfaces.</span>
        </footer>
      </main>
    </div>
  </body>
</html>
