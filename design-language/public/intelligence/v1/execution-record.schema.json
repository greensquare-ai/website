{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"/intelligence/v1/execution-record.schema.json",
  "title":"GreenSquare Agent Execution Record",
  "type":"object",
  "additionalProperties":false,
  "required":["run_id","timestamp","task","task_route","authority_class","modules_retrieved","evidence","assumptions","actions","quality_gates","outputs","learning"],
  "properties":{
    "run_id":{"type":"string"},
    "timestamp":{"type":"string","format":"date-time"},
    "task":{"type":"string","minLength":1},
    "actual_problem_or_decision":{"type":"string"},
    "task_route":{"type":"string"},
    "authority_class":{"enum":["AUTONOMOUS","AUTONOMOUS_WITH_DISCLOSURE","ESCALATE","RESERVED"]},
    "authority_rationale":{"type":"string"},
    "modules_retrieved":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "evidence":{"type":"array","items":{"type":"object","required":["state","statement"],"properties":{"state":{"enum":["GIVEN","DERIVED","INFERRED","UNKNOWN"]},"statement":{"type":"string"},"source":{"type":["string","null"]},"derivation":{"type":["string","null"]}}}},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "tradeoffs":{"type":"array","items":{"type":"string"}},
    "actions":{"type":"array","items":{"type":"object","required":["action","status"],"properties":{"action":{"type":"string"},"system":{"type":["string","null"]},"status":{"enum":["planned","executed","blocked","skipped"]},"reason":{"type":["string","null"]}}}},
    "quality_gates":{"type":"array","items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string"},"status":{"enum":["PASS","FAIL","NOT_APPLICABLE"]},"evidence":{"type":"string"}}}},
    "outputs":{"type":"array","items":{"type":"object","required":["type","location_or_value"],"properties":{"type":{"type":"string"},"location_or_value":{"type":"string"}}}},
    "disclosures":{"type":"array","items":{"type":"string"}},
    "unresolved":{"type":"array","items":{"type":"string"}},
    "next_action":{"type":"string"},
    "learning":{"type":"object","required":["execution_memory","observed_learning","proposed_doctrine"],"properties":{"execution_memory":{"type":"array","items":{"type":"string"}},"observed_learning":{"type":"array","items":{"type":"string"}},"proposed_doctrine":{"type":"array","items":{"type":"string"}}}}
  }
}
