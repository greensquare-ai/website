{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GSIL.DESIGN_RUNTIME.COMPOSITION_SCHEMA",
  "title": "GreenSquare Design Composition",
  "type": "object",
  "required": ["id","format","role","mode","pattern","content"],
  "properties": {
    "id": {"type":"string"},
    "format": {"enum":["instagram_4x5","linkedin_square"]},
    "role": {"type":"string"},
    "mode": {"enum":["paper","forest","ink","sage"]},
    "pattern": {
      "type":"object",
      "required":["behaviour","orientation","instances","S","region"],
      "properties": {
        "behaviour":{"enum":["passage","horizon","open_corner","none"]},
        "orientation":{"enum":[0,90,180,270]},
        "prominence":{"enum":["ambient","signature"]},
        "instances":{"type":"integer","minimum":0,"maximum":1},
        "S":{"type":"number","exclusiveMinimum":0},
        "region":{"$ref":"#/$defs/rect"}
      }
    },
    "content": {
      "type":"object",
      "required":["headline","source_state","protected_region"],
      "properties": {
        "eyebrow":{"type":"string"},
        "headline":{"type":"string"},
        "headline_lines":{"type":"array","items":{"type":"string"},"maxItems":6},
        "body":{"type":"string"},
        "body_lines":{"type":"array","items":{"type":"string"}},
        "source":{"type":"string"},
        "source_state":{"enum":["GIVEN","DERIVED","INFERRED","UNKNOWN"]},
        "protected_region":{"$ref":"#/$defs/rect"}
      }
    }
  },
  "$defs": {
    "rect": {
      "type":"object",
      "required":["x","y","width","height"],
      "properties": {
        "x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}
      }
    }
  }
}
