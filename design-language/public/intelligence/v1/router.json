{
  "id": "GSIL.ROUTER",
  "version": "1.2.0",
  "bootstrap_sequence": ["GSIL.ROOT_AGENT_CONTRACT","GSIL.AUTHORITY_MODEL","GSIL.AGENT_EXECUTION_HARNESS"],
  "algorithm": ["classify_task","determine_consequence_and_authority_class","retrieve_required_modules","retrieve_task_specific_knowledge","retrieve_output_specification","frame_under_judgment_os","plan_actions_and_adapters","execute_within_authority","validate_against_applicable_gates","remediate_failed_gates","persist_execution_record","record_learning_without_mutating_doctrine"],
  "task_routes": {
    "strategy_decision": {"required":["GSIL.JUDGMENT_OS","GSIL.KNOWLEDGE","GSIL.AGENT_EXECUTION_HARNESS"],"optional":["GSIL.PRODUCT"],"output":"decision_recommendation"},
    "product_methodology": {"required":["GSIL.JUDGMENT_OS","GSIL.KNOWLEDGE","GSIL.PRODUCT","GSIL.AGENT_EXECUTION_HARNESS"],"output":"product_or_method_spec"},
    "marketing_copy": {"required":["GSIL.KNOWLEDGE","GSIL.PRODUCT","GSIL.DESIGN_COMMUNICATION","GSIL.AGENT_EXECUTION_HARNESS"],"conditional":["GSIL.JUDGMENT_OS"],"output":"communication_asset"},
    "social_content": {"required":["GSIL.JUDGMENT_OS","GSIL.KNOWLEDGE","GSIL.PRODUCT","GSIL.EXECUTION","GSIL.DESIGN_COMMUNICATION","GSIL.AGENT_EXECUTION_HARNESS"],"conditional":["GSIL.DESIGN_RUNTIME"],"workflow":"/intelligence/v1/workflows/social-production.json","output":"channel_native_asset_and_execution_record"},
    "design_asset": {"required":["GSIL.KNOWLEDGE","GSIL.DESIGN_COMMUNICATION","GSIL.DESIGN_RUNTIME","GSIL.AGENT_EXECUTION_HARNESS"],"conditional":["GSIL.PRODUCT","GSIL.EXECUTION"],"output":"rendered_asset_and_execution_record"},
    "web_build": {"required":["GSIL.KNOWLEDGE","GSIL.DESIGN_COMMUNICATION","GSIL.AGENT_EXECUTION_HARNESS"],"conditional":["GSIL.PRODUCT","GSIL.EXECUTION","GSIL.DESIGN_RUNTIME"],"output":"implemented_surface_and_execution_record"},
    "analysis_research": {"required":["GSIL.JUDGMENT_OS","GSIL.KNOWLEDGE","GSIL.AGENT_EXECUTION_HARNESS"],"output":"evidence_backed_analysis"},
    "launch_distribution": {"required":["GSIL.JUDGMENT_OS","GSIL.KNOWLEDGE","GSIL.PRODUCT","GSIL.EXECUTION","GSIL.DESIGN_COMMUNICATION","GSIL.AGENT_EXECUTION_HARNESS"],"conditional":["GSIL.DESIGN_RUNTIME"],"output":"launch_action_and_execution_record"},
    "example_lookup": {"required":["GSIL.KNOWLEDGE"],"restriction":"examples_do_not_override_doctrine"}
  },
  "authority_resolution": {
    "low_consequence_reversible_doctrine_complete":"AUTONOMOUS",
    "reasonable_judgment_material_inference_but_not_reserved":"AUTONOMOUS_WITH_DISCLOSURE",
    "material_strategy_positioning_economics_architecture_evidence_or_commitment_ambiguity":"ESCALATE",
    "founder_reserved_change":"RESERVED"
  },
  "unknown_task_rule": "Load the harness plus GSIL.KNOWLEDGE and the narrowest plausible domain module. Do not ingest the entire repository by default."
}
